# Database Configuration
DATABASE_URL=postgresql://sourcemonster:change-me-locally@localhost:5432/sourcemonster

# Admin Session Secret (min 32 random characters)
SESSION_SECRET=replace-with-a-long-random-secret-for-session-signing

# Resend Email Configuration
RESEND_API_KEY=
CONTACT_EMAIL=contact@sourcemonster.in

# Cloudflare R2 / S3 Storage Configuration
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Docker Compose Local PostgreSQL Service
POSTGRES_USER=sourcemonster
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sourcemonster

# Initial Admin Seeder (used only by `db:seed:admin`)
SEED_ADMIN_NAME=superadmin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

