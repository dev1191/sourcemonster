---
import "@/styles/starwind.css";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import { getSiteSettings } from "../lib/settings";

interface Props {
	title?: string;
	description?: string;
	dark?: boolean;
	image?: string | null;
	type?: string;
}

const settings = await getSiteSettings();

const {
	title = settings.seo_default_title,
	description = settings.seo_default_description,
	dark,
	image,
	type = "website",
} = Astro.props;

const defaultTheme = dark ? "dark" : (Astro.url.pathname.startsWith("/products") ? "dark" : "dark");
const canonicalUrl = Astro.url.href;
const ogImage = image
	? (image.startsWith("http") ? image : new URL(image, Astro.url).href)
	: new URL("/favicon.png", Astro.url).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<ThemeInitScript defaultTheme={defaultTheme} />

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- SEO & Canonical -->
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta
			name="keywords"
			content="web development, UI/UX design, digital marketing, SEO, freelancers, software solutions, SaaS boilerplate, CodeCanyon"
		/>

		<!-- Open Graph / Facebook / WhatsApp -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content="SourceMonster" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Google Analytics (gtag.js) -->
		<script is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-J17XMFEZDH"
		></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-J17XMFEZDH");
			gtag("config", "G-N3TWWTZ276");
			gtag("config", "AW-323793960");
		</script>

		<!-- Meta Verifications -->
		<meta
			name="facebook-domain-verification"
			content="px5tptxaus7b2qvd9dftsaeyc63c43"
		/>
		<meta
			name="google-site-verification"
			content="O5Epj59DcBao74Z8cbYPfg5ZwYs5FUSbyzWhue5fF8E"
		/>
		<meta property="fb:pages" content="103794024703870" />

		<!-- Styles -->
		<link rel="stylesheet" href="/css/main.css" />

		<!-- Animation Libraries -->
		<link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
		/>
	</head>
	<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 selection:bg-primary/30 selection:text-primary transition-colors duration-200">
		<slot />

		<!-- Scripts -->
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
		<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
		<script is:inline src="https://unpkg.com/lucide@latest"></script>
		<script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>
		
		<script is:inline>
			// Initialize AOS
			document.addEventListener('DOMContentLoaded', function() {
				if (typeof AOS !== 'undefined') {
					AOS.init();
				}
				if (typeof lucide !== 'undefined') {
					lucide.createIcons();
				}
				if (typeof gsap !== 'undefined') {
					gsap.to("body", { opacity: 1, duration: 1 });
				}
			});
		</script>
	</body>
</html>
