---
import "@/styles/starwind.css";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import { SidebarProvider, SidebarInset } from "@/components/starwind/sidebar";
import { Toaster } from "@/components/starwind/toast";

interface Props {
  title?: string;
  activeNav?: "dashboard" | "projects" | "products" | "addons" | "leads" | "services" | "testimonials" | "faqs" | "settings";
}

const { title = "Admin Portal | SourceMonster", activeNav = "dashboard" } = Astro.props;
const user = Astro.locals.adminUser;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <ThemeInitScript defaultTheme="dark" />
    <!-- Lucide icons -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body class="h-full bg-slate-50 dark:bg-[#030712] font-sans antialiased text-slate-800 dark:text-slate-200 transition-colors duration-200">
    <SidebarProvider defaultOpen={true} persistOpen={true} persistenceStorage="localStorage">
      <!-- Starwind Admin Sidebar (Desktop sidebar + auto Mobile Sheet drawer) -->
      <AdminSidebar activeNav={activeNav} user={user} />

      <!-- Inset wraps header & main content -->
      <SidebarInset class="flex flex-col min-w-0 min-h-screen bg-slate-100/70 dark:bg-[#030712] transition-colors duration-200">
        <!-- Admin Header -->
        <AdminHeader activeNav={activeNav} user={user} />

        <!-- Main Content Area -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8">
          <div class="max-w-7xl mx-auto">
            <slot />
          </div>
        </main>
      </SidebarInset>
    </SidebarProvider>

    <!-- Starwind Floating Toast Viewport -->
    <Toaster position="bottom-right" />

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        if (typeof lucide !== "undefined") {
          lucide.createIcons();
        }
      });
    </script>
  </body>
</html>
