---
interface Props {
  title?: string;
  activeNav?: "dashboard" | "products" | "leads" | "services" | "testimonials" | "settings";
}

const { title = "Admin Portal | SourceMonster", activeNav = "dashboard" } = Astro.props;
const user = Astro.locals.adminUser;
---

<!doctype html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <!-- Lucide icons -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body class="h-full flex flex-col md:flex-row bg-[#030712] font-sans antialiased text-slate-200">
    <!-- Mobile Header -->
    <header class="md:hidden flex items-center justify-between px-4 py-3 bg-slate-900 border-b border-slate-800">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-primary animate-pulse"></span>
        <span class="font-bold text-lg tracking-wider text-white">SOURCE<span class="text-primary">MONSTER</span></span>
      </div>
      <button id="mobile-menu-btn" class="p-2 text-slate-400 hover:text-white focus:outline-none">
        <i data-lucide="menu" class="w-6 h-6"></i>
      </button>
    </header>

    <!-- Sidebar -->
    <aside id="sidebar" class="hidden md:flex flex-col w-64 bg-slate-900/90 backdrop-blur-md border-r border-slate-800/80 p-5 shrink-0 min-h-screen">
      <div class="flex items-center gap-2 pb-6 border-b border-slate-800">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-primary to-orange-500 flex items-center justify-center text-white font-black shadow-lg shadow-primary/20">
          SM
        </div>
        <div>
          <div class="font-black text-sm tracking-widest text-white">SOURCE<span class="text-primary">MONSTER</span></div>
          <div class="text-[10px] uppercase tracking-wider text-slate-400 font-medium">Control Center</div>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="flex-1 mt-6 space-y-1.5">
        <a
          href="/admin"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all ${
            activeNav === "dashboard"
              ? "bg-primary text-white shadow-md shadow-primary/25"
              : "text-slate-400 hover:text-slate-100 hover:bg-slate-800/60"
          }`}
        >
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Dashboard</span>
        </a>

        <a
          href="/admin/products"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all ${
            activeNav === "products"
              ? "bg-primary text-white shadow-md shadow-primary/25"
              : "text-slate-400 hover:text-slate-100 hover:bg-slate-800/60"
          }`}
        >
          <i data-lucide="package" class="w-4 h-4"></i>
          <span>Products</span>
        </a>

        <a
          href="/admin/leads"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all ${
            activeNav === "leads"
              ? "bg-primary text-white shadow-md shadow-primary/25"
              : "text-slate-400 hover:text-slate-100 hover:bg-slate-800/60"
          }`}
        >
          <i data-lucide="inbox" class="w-4 h-4"></i>
          <span>Leads & Inquiries</span>
        </a>

        <a
          href="/admin/services"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all ${
            activeNav === "services"
              ? "bg-primary text-white shadow-md shadow-primary/25"
              : "text-slate-400 hover:text-slate-100 hover:bg-slate-800/60"
          }`}
        >
          <i data-lucide="layers" class="w-4 h-4"></i>
          <span>Services</span>
        </a>

        <a
          href="/admin/testimonials"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all ${
            activeNav === "testimonials"
              ? "bg-primary text-white shadow-md shadow-primary/25"
              : "text-slate-400 hover:text-slate-100 hover:bg-slate-800/60"
          }`}
        >
          <i data-lucide="message-circle" class="w-4 h-4"></i>
          <span>Testimonials</span>
        </a>

        <a
          href="/admin/settings"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-all ${
            activeNav === "settings"
              ? "bg-primary text-white shadow-md shadow-primary/25"
              : "text-slate-400 hover:text-slate-100 hover:bg-slate-800/60"
          }`}
        >
          <i data-lucide="sliders" class="w-4 h-4"></i>
          <span>Site Settings</span>
        </a>
      </nav>

      <!-- Sidebar Footer -->
      <div class="pt-4 border-t border-slate-800/80 space-y-3">
        <a
          href="/"
          target="_blank"
          class="flex items-center justify-between px-3 py-2 text-xs text-slate-400 hover:text-white rounded-lg hover:bg-slate-800/40 transition"
        >
          <span class="flex items-center gap-2">
            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            View Live Site
          </span>
          <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50"></i>
        </a>

        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800/60 flex items-center justify-between">
          <div class="overflow-hidden pr-2">
            <div class="text-xs font-semibold text-white truncate">{user?.name || "Administrator"}</div>
            <div class="text-[11px] text-slate-400 truncate">{user?.email || "admin@sourcemonster.in"}</div>
          </div>
          <form method="POST" action="/admin/logout">
            <button
              type="submit"
              title="Logout"
              class="p-1.5 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition"
            >
              <i data-lucide="log-out" class="w-4 h-4"></i>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- Mobile Drawer (hidden by default) -->
    <div id="mobile-drawer" class="md:hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden">
      <div class="w-72 max-w-[80vw] h-full bg-slate-900 border-r border-slate-800 p-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-5 border-b border-slate-800">
            <div class="font-bold tracking-wider text-white">SOURCE<span class="text-primary">MONSTER</span></div>
            <button id="close-drawer-btn" class="p-1 text-slate-400 hover:text-white">
              <i data-lucide="x" class="w-5 h-5"></i>
            </button>
          </div>
          <nav class="mt-6 space-y-2">
            <a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800">
              <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
              Dashboard
            </a>
            <a href="/admin/products" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800">
              <i data-lucide="package" class="w-4 h-4"></i>
              Products
            </a>
            <a href="/admin/leads" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800">
              <i data-lucide="inbox" class="w-4 h-4"></i>
              Leads
            </a>
            <a href="/admin/services" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800">
              <i data-lucide="layers" class="w-4 h-4"></i>
              Services
            </a>
            <a href="/admin/testimonials" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800">
              <i data-lucide="message-circle" class="w-4 h-4"></i>
              Testimonials
            </a>
            <a href="/admin/settings" class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800">
              <i data-lucide="sliders" class="w-4 h-4"></i>
              Settings
            </a>
          </nav>
        </div>
        <div class="pt-4 border-t border-slate-800">
          <form method="POST" action="/admin/logout">
            <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-2 bg-rose-500/10 text-rose-400 rounded-lg hover:bg-rose-500/20 text-sm">
              <i data-lucide="log-out" class="w-4 h-4"></i>
              Log Out
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <main class="flex-1 overflow-y-auto min-h-screen bg-[#030712] p-4 sm:p-6 lg:p-8">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </main>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        if (typeof lucide !== "undefined") {
          lucide.createIcons();
        }

        const menuBtn = document.getElementById("mobile-menu-btn");
        const drawer = document.getElementById("mobile-drawer");
        const closeBtn = document.getElementById("close-drawer-btn");

        if (menuBtn && drawer && closeBtn) {
          menuBtn.addEventListener("click", () => drawer.classList.remove("hidden"));
          closeBtn.addEventListener("click", () => drawer.classList.add("hidden"));
        }
      });
    </script>
  </body>
</html>

