---
import type { Product } from "../../lib/db/schema/products";

interface Props {
  product: Product;
  thumbnailUrl?: string | null;
  galleryItems: Array<{ caption: string | null; url: string | null }>;
}

const { product, thumbnailUrl, galleryItems } = Astro.props;

const validGallery = galleryItems.filter((item) => Boolean(item.url));

// If no gallery screenshots exist, do not render an empty section
if (validGallery.length === 0) {
  return null;
}

// All showcase images: include main cover first if available, followed by gallery screenshots
const allShowcaseImages = [
  ...(thumbnailUrl ? [{ url: thumbnailUrl, caption: `${product.title} - Main Cover` }] : []),
  ...validGallery,
];

const primaryImage = validGallery[0]?.url || allShowcaseImages[0]?.url || null;

const fancyboxSlides = allShowcaseImages.map((img, idx) => ({
  src: img.url,
  caption: img.caption || `${product.title} - Preview ${idx + 1}`,
  thumb: img.url,
}));
---

<section
  id="gallery"
  class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl space-y-6 scroll-mt-28"
  data-gallery-container
  data-slides={JSON.stringify(fancyboxSlides)}
>
  <!-- Section Header -->
  <div class="flex items-center justify-between flex-wrap gap-4 pb-5 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-3">
      <span class="p-2.5 rounded-2xl bg-primary/10 text-primary">
        <i data-lucide="images" class="w-6 h-6"></i>
      </span>
      <div>
        <h2 class="text-2xl font-black font-heading text-slate-900 dark:text-white tracking-tight">
          Visual Gallery &amp; Screenshots
        </h2>
        <p class="text-xs text-slate-500 font-mono">High-resolution interface walkthrough &amp; screenshots</p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <span class="px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-mono font-bold">
        {validGallery.length} {validGallery.length === 1 ? "screenshot" : "screenshots"}
      </span>
      <button
        type="button"
        id="fullscreen-gallery-section-btn"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-semibold transition cursor-pointer shadow-sm"
        title="Open full resolution Fancybox lightbox"
      >
        <i data-lucide="maximize-2" class="w-3.5 h-3.5 text-primary"></i>
        <span>Full Lightbox</span>
      </button>
    </div>
  </div>

  <!-- Interactive Preview Box -->
  <div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 shadow-inner">
    <!-- Active Preview Viewer (Clickable with Fancybox) -->
    <div
      id="gallery-showcase-trigger"
      class="relative bg-slate-100 dark:bg-slate-950 flex items-center justify-center overflow-hidden min-h-[300px] sm:min-h-[440px] cursor-zoom-in group/showcase"
      title="Click to open Fancybox lightbox"
    >
      {primaryImage && (
        <>
          <img
            id="gallery-showcase-img"
            src={primaryImage}
            alt={validGallery[0]?.caption || product.title}
            class="w-full h-auto max-h-[500px] object-contain transition-all duration-300 group-hover/showcase:scale-[1.01]"
          />
          <div class="absolute inset-0 bg-slate-950/20 opacity-0 group-hover/showcase:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
            <span class="px-4 py-2 rounded-full bg-slate-900/85 backdrop-blur-md text-white text-xs font-semibold flex items-center gap-2 shadow-xl border border-white/20">
              <i data-lucide="zoom-in" class="w-4 h-4 text-primary"></i>
              <span>Click to view full lightbox</span>
            </span>
          </div>
        </>
      )}
    </div>

    <!-- Caption & Counter Bar -->
    <div class="px-4 sm:px-6 py-2.5 bg-slate-100/80 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-600 dark:text-slate-400 font-mono">
      <span id="gallery-caption-text" class="truncate pr-4 font-medium">
        {validGallery[0]?.caption || `${product.title} - Screenshot 1`}
      </span>
      <span id="gallery-counter-text" class="shrink-0 text-slate-400 dark:text-slate-500 font-semibold">
        1 of {validGallery.length}
      </span>
    </div>
  </div>

  <!-- Thumbnails Strip -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
        <i data-lucide="layout-grid" class="w-3.5 h-3.5 text-primary"></i>
        <span>All Screenshots ({validGallery.length})</span>
      </span>
      <span class="text-[11px] text-slate-500 font-mono">Click thumbnail to switch preview</span>
    </div>

    <div class="flex items-center gap-3 overflow-x-auto pb-2 scrollbar-thin">
      {validGallery.map((img, idx) => {
        const fancyboxIndex = allShowcaseImages.findIndex((item) => item.url === img.url);
        return (
          <div class="relative shrink-0 group">
            <button
              type="button"
              class={`gallery-thumb-btn w-24 sm:w-32 h-16 sm:h-22 rounded-2xl overflow-hidden border-2 transition cursor-pointer relative block ${
                idx === 0
                  ? "border-primary ring-2 ring-primary/20 shadow-md"
                  : "border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600 opacity-75 hover:opacity-100"
              }`}
              data-img-src={img.url}
              data-caption={img.caption || `Screenshot ${idx + 1}`}
              data-index={idx}
              data-fancybox-index={fancyboxIndex >= 0 ? fancyboxIndex : idx}
              title={img.caption || `Screenshot ${idx + 1}`}
            >
              <img
                src={img.url}
                alt={img.caption || `Screenshot ${idx + 1}`}
                class="w-full h-full object-cover transition group-hover:scale-105"
                loading="lazy"
              />
            </button>
            <button
              type="button"
              class="gallery-open-trigger absolute bottom-1.5 right-1.5 p-1 rounded-md bg-slate-900/80 hover:bg-primary text-white opacity-0 group-hover:opacity-100 transition shadow cursor-pointer text-[10px]"
              data-fancybox-index={fancyboxIndex >= 0 ? fancyboxIndex : idx}
              title="Open full resolution in Fancybox"
            >
              <i data-lucide="maximize" class="w-3 h-3"></i>
            </button>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- Client Script for Interactive Gallery Switching & Fancybox Lightbox -->
<script>
  import { Fancybox } from "@fancyapps/ui";
  import "@fancyapps/ui/dist/fancybox/fancybox.css";

  function initProductGallery() {
    const container = document.querySelector<HTMLElement>("[data-gallery-container]");
    if (!container) return;

    const mainImg = document.getElementById("gallery-showcase-img") as HTMLImageElement | null;
    const showcaseTrigger = document.getElementById("gallery-showcase-trigger");
    const fullscreenBtn = document.getElementById("fullscreen-gallery-section-btn");
    const thumbBtns = container.querySelectorAll<HTMLElement>(".gallery-thumb-btn");
    const openTriggers = container.querySelectorAll<HTMLElement>(".gallery-open-trigger");
    const captionEl = document.getElementById("gallery-caption-text");
    const counterEl = document.getElementById("gallery-counter-text");

    let slides: Array<{ src: string; caption?: string; thumb?: string }> = [];
    try {
      slides = JSON.parse(container.dataset.slides || "[]");
    } catch {
      slides = [];
    }

    let currentFancyboxIndex = 0;
    const firstThumb = thumbBtns[0];
    if (firstThumb) {
      currentFancyboxIndex = parseInt(firstThumb.getAttribute("data-fancybox-index") || "0", 10);
    }

    const openFancybox = (startIndex: number = 0) => {
      if (!slides || slides.length === 0) return;
      Fancybox.show(slides, {
        startIndex: startIndex >= 0 && startIndex < slides.length ? startIndex : 0,
        compact: false,
        idle: false,
        dragToClose: true,
        Images: {
          initialSize: "fit",
        },
        Toolbar: {
          display: {
            left: ["infobar"],
            middle: [
              "zoomIn",
              "zoomOut",
              "toggle1to1",
              "rotateCCW",
              "rotateCW",
              "flipX",
              "flipY",
            ],
            right: ["slideshow", "thumbs", "close"],
          },
        },
        Thumbs: {
          type: "classic",
        },
      });
    };

    // Thumbnail click: switch preview on page
    if (thumbBtns.length > 0 && mainImg) {
      thumbBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const newSrc = btn.getAttribute("data-img-src");
          const caption = btn.getAttribute("data-caption");
          const idx = parseInt(btn.getAttribute("data-index") || "0", 10);
          const fIndex = parseInt(btn.getAttribute("data-fancybox-index") || "0", 10);

          currentFancyboxIndex = fIndex;

          if (newSrc && mainImg) {
            mainImg.style.opacity = "0.3";
            setTimeout(() => {
              mainImg.src = newSrc;
              mainImg.style.opacity = "1";
              if (captionEl && caption) captionEl.textContent = caption;
              if (counterEl) counterEl.textContent = `${idx + 1} of ${thumbBtns.length}`;
            }, 120);

            thumbBtns.forEach((t) => {
              t.classList.remove("border-primary", "ring-2", "ring-primary/20", "shadow-md");
              t.classList.add("border-slate-200", "dark:border-slate-800", "opacity-75");
            });
            btn.classList.remove("border-slate-200", "dark:border-slate-800", "opacity-75");
            btn.classList.add("border-primary", "ring-2", "ring-primary/20", "shadow-md");
          }
        });
      });
    }

    // Direct Fancybox triggers
    if (showcaseTrigger) {
      showcaseTrigger.addEventListener("click", () => {
        openFancybox(currentFancyboxIndex);
      });
    }

    if (fullscreenBtn) {
      fullscreenBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        openFancybox(currentFancyboxIndex);
      });
    }

    openTriggers.forEach((trig) => {
      trig.addEventListener("click", (e) => {
        e.stopPropagation();
        const fIndex = parseInt(trig.getAttribute("data-fancybox-index") || "0", 10);
        openFancybox(fIndex);
      });
    });
  }

  // Run on initial page load and on Astro page transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProductGallery);
  } else {
    initProductGallery();
  }
  document.addEventListener("astro:page-load", initProductGallery);
</script>
