---

---

<!-- Contact / Project Initialization Section (Lume Agency Inspired) -->
<section id="contact" class="py-20 sm:py-32 bg-slate-100/60 dark:bg-[#070913] relative overflow-hidden transition-colors border-t border-slate-200/80 dark:border-white/[0.08]">
  <!-- Ambient Radial Glows -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-t from-primary/10 via-primary/5 to-transparent rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <!-- Header Block -->
    <div class="max-w-3xl mb-14 sm:mb-20" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.1] text-xs font-mono uppercase tracking-widest text-primary font-bold mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        <span>Let's Talk</span>
      </div>

      <h2 class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-black font-heading tracking-tight text-slate-900 dark:text-white leading-[1.1] mb-6">
        Let's Build Something Exceptional Together.
      </h2>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Tell us about your project, we'll get back to you with insights, timelines, and the best way to make it happen.
      </p>
    </div>

    <!-- Dual Column Bento Layout -->
    <div class="grid lg:grid-cols-12 gap-8 sm:gap-10 items-start">
      <!-- Left Column: Talk It Through & Channels (5 cols) -->
      <div class="lg:col-span-5 space-y-6" data-aos="fade-right">
        <!-- Card 1: Prefer to talk it through? -->
        <div class="p-7 sm:p-8 rounded-3xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6">
              <i data-lucide="video" class="w-6 h-6"></i>
            </div>

            <h3 class="text-xl font-bold font-heading text-slate-900 dark:text-white mb-2">
              Prefer to talk it through?
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
              Schedule a quick intro call with our technical lead. We'll learn about your goals and map out how SourceMonster can bring them to life.
            </p>
          </div>

          <div>
            <a
              href="https://wa.me/918607248802?text=Hello%20SourceMonster,%20I%20want%20to%20schedule%20a%20call%20for%20a%20project."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-semibold text-xs sm:text-sm bg-primary hover:bg-orange-600 text-white shadow-md shadow-primary/20 hover:shadow-primary/30 transition-all hover:scale-[1.02] active:scale-95"
            >
              <span>Schedule Quick Call</span>
              <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
            <p class="text-[11px] text-slate-400 font-mono text-center mt-3">
              No commitment — just an exploratory conversation.
            </p>
          </div>
        </div>

        <!-- Card 2: Direct Channels -->
        <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] shadow-sm space-y-4">
          <div class="text-xs font-mono uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400 pb-2 border-b border-slate-100 dark:border-white/[0.06]">
            Direct Inquiries
          </div>

          <!-- WhatsApp Link -->
          <a
            href="https://wa.me/918607248802?text=Hello%20SourceMonster,%20I%20want%20to%20discuss%20a%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3.5 p-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-white/[0.04] transition group"
          >
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
              <i data-lucide="message-circle" class="w-5 h-5"></i>
            </div>
            <div>
              <div class="text-[11px] font-mono text-slate-400 uppercase">WhatsApp Instant</div>
              <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 transition">
                +91 86072 48802
              </div>
            </div>
          </a>

          <!-- Email Link -->
          <a
            href="mailto:contact@sourcemonster.in"
            class="flex items-center gap-3.5 p-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-white/[0.04] transition group"
          >
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
              <i data-lucide="mail" class="w-5 h-5"></i>
            </div>
            <div>
              <div class="text-[11px] font-mono text-slate-400 uppercase">Official Inbox</div>
              <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-primary transition">
                contact@sourcemonster.in
              </div>
            </div>
          </a>

          <!-- Guaranteed SLA -->
          <div class="pt-2 flex items-center gap-2 text-[11px] font-mono text-slate-500 dark:text-slate-400">
            <i data-lucide="clock" class="w-3.5 h-3.5 text-primary"></i>
            <span>We'll get back to you within 2 business hours.</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Inquiry Form (7 cols) -->
      <div class="lg:col-span-7" data-aos="fade-left">
        <div class="p-7 sm:p-10 rounded-3xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] shadow-xl">
          <form id="contact-form" class="space-y-5">
            <!-- Anti-spam Honeypot -->
            <input type="text" name="honeypot" class="hidden" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="sourcePage" id="source-page-input" value="/" />

            <!-- Row 1: Name & Email -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
              <div>
                <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                  Your Name *
                </label>
                <input
                  name="name"
                  type="text"
                  required
                  class="w-full bg-slate-50 dark:bg-white/[0.03] border border-slate-200 dark:border-white/[0.08] focus:border-primary dark:focus:border-primary p-3.5 rounded-2xl outline-none transition text-sm text-slate-900 dark:text-white"
                  placeholder="Alex Morgan"
                />
              </div>
              <div>
                <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                  Email Address *
                </label>
                <input
                  name="email"
                  type="email"
                  required
                  class="w-full bg-slate-50 dark:bg-white/[0.03] border border-slate-200 dark:border-white/[0.08] focus:border-primary dark:focus:border-primary p-3.5 rounded-2xl outline-none transition text-sm text-slate-900 dark:text-white"
                  placeholder="alex@company.com"
                />
              </div>
            </div>

            <!-- Row 2: Company & Service -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
              <div>
                <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                  Company / Organization
                </label>
                <input
                  name="company"
                  type="text"
                  class="w-full bg-slate-50 dark:bg-white/[0.03] border border-slate-200 dark:border-white/[0.08] focus:border-primary dark:focus:border-primary p-3.5 rounded-2xl outline-none transition text-sm text-slate-900 dark:text-white"
                  placeholder="Acme Inc."
                />
              </div>
              <div>
                <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                  Service / Project Scope *
                </label>
                <select
                  id="service-select"
                  name="service"
                  required
                  class="w-full bg-slate-50 dark:bg-white/[0.03] border border-slate-200 dark:border-white/[0.08] focus:border-primary dark:focus:border-primary p-3.5 rounded-2xl outline-none transition text-sm text-slate-900 dark:text-white"
                >
                  <option value="Custom Web / Mobile App">Custom Web / Mobile App</option>
                  <option value="Commercial Project Customization">Commercial Project Customization</option>
                  <option value="SaaS Platform Engineering">SaaS Platform Engineering</option>
                  <option value="AI Integration & Automation">AI Integration & Automation</option>
                  <option value="High-Concurrency Backend">High-Concurrency Backend</option>
                  <option value="MVP Rapid Build">MVP Rapid Build</option>
                </select>
              </div>
            </div>

            <!-- Row 3: Message -->
            <div>
              <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                Project Scope &amp; Details *
              </label>
              <textarea
                name="message"
                id="contact-message"
                rows="4"
                required
                class="w-full bg-slate-50 dark:bg-white/[0.03] border border-slate-200 dark:border-white/[0.08] focus:border-primary dark:focus:border-primary p-3.5 rounded-2xl outline-none transition text-sm text-slate-900 dark:text-white"
                placeholder="Share your goals, timeline, and key requirements..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full bg-primary hover:bg-orange-600 active:scale-95 text-white py-3.5 sm:py-4 rounded-full font-semibold text-sm sm:text-base shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/40 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span class="btn-text">INITIALIZE PROJECT</span>
              <div class="spinner hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
            </button>

            <!-- Status Alert -->
            <div id="form-status" class="hidden text-center p-3.5 rounded-2xl font-bold text-sm"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { actions, isInputError } from 'astro:actions';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status');
  const button = form?.querySelector('button[type="submit"]');
  const btnText = button?.querySelector('.btn-text');
  const spinner = button?.querySelector('.spinner');
  const sourcePageInput = document.getElementById('source-page-input') as HTMLInputElement;
  const serviceSelect = document.getElementById('service-select') as HTMLSelectElement;
  const messageTextarea = document.getElementById('contact-message') as HTMLTextAreaElement;

  try {
    if (typeof window !== "undefined") {
      const urlParams = new URLSearchParams(window.location.search);
      const projectParam = urlParams.get('project') || urlParams.get('product');
      const serviceParam = urlParams.get('service');

      if (sourcePageInput) {
        sourcePageInput.value = window.location.pathname + window.location.search;
      }

      if (projectParam && serviceSelect) {
        const option = document.createElement("option");
        option.value = `Customization: ${projectParam}`;
        option.text = `Customization: ${projectParam}`;
        option.selected = true;
        serviceSelect.prepend(option);

        if (messageTextarea && !messageTextarea.value) {
          messageTextarea.placeholder = `I am interested in customizing ${projectParam}. Here are my requirements...`;
        }
      } else if (serviceParam && serviceSelect) {
        serviceSelect.value = serviceParam;
      }
    }
  } catch (e) {
    // Fallback gracefully
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!status || !button || !btnText || !spinner) return;

    status.classList.add('hidden');
    status.classList.remove('bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-400', 'bg-rose-500/10', 'text-rose-700', 'dark:text-rose-400');

    button.setAttribute('disabled', 'true');
    btnText.classList.add('hidden');
    spinner.classList.remove('hidden');

    const formData = new FormData(form);
    const { data, error } = await actions.sendEmail(formData);

    button.removeAttribute('disabled');
    btnText.classList.remove('hidden');
    spinner.classList.add('hidden');

    if (error) {
      if (isInputError(error)) {
        const messages = Object.values(error.fields).flat().join(', ');
        status.textContent = "Validation Error: " + messages;
      } else {
        status.textContent = "Error: " + error.message;
      }
      status.classList.add('bg-rose-500/10', 'text-rose-700', 'dark:text-rose-400');
      status.classList.remove('hidden');
    } else {
      status.textContent = "Project Initialized! Our team will reach out within 2 hours.";
      status.classList.add('bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-400');
      status.classList.remove('hidden');
      form.reset();
    }
  });
</script>
