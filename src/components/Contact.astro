---
---
<!-- Contact Section -->
<section id="contact" class="py-20 sm:py-32 bg-white dark:bg-slate-950 relative overflow-hidden transition-colors border-t border-slate-200/80 dark:border-slate-800/80">
    <!-- Ambient Glow -->
    <div class="hero-glow -bottom-40 left-1/2 -translate-x-1/2 opacity-25 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            <!-- Left Info Column (5 cols) -->
            <div class="lg:col-span-5" data-aos="fade-right">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-mono font-bold tracking-widest uppercase mb-4">
                    <span class="w-2 h-2 rounded-full bg-primary"></span>
                    <span>Ready To Scale?</span>
                </div>

                <h2 class="text-4xl xs:text-5xl sm:text-6xl font-black font-heading leading-tight tracking-tight mb-6 text-slate-900 dark:text-white">
                    LET'S BUILD <br class="hidden sm:inline" />
                    <span class="text-gradient">TOGETHER.</span>
                </h2>

                <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 mb-8 leading-relaxed">
                    Have a SaaS product in mind, need custom engineering, or want to deploy one of our production boilerplates? Send a message and our lead architects will respond within 2 hours.
                </p>

                <!-- Direct Contact Channels -->
                <div class="space-y-4 mb-8">
                    <!-- WhatsApp Direct -->
                    <a
                        href="https://wa.me/918607248802?text=Hello%20SourceMonster,%20I%20want%20to%20discuss%20a%20project."
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-4 p-4 rounded-2xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400 transition group shadow-xs"
                    >
                        <div class="w-12 h-12 rounded-xl bg-[#25D366] text-white flex items-center justify-center shrink-0 shadow-md">
                            <i data-lucide="message-circle" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <div class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Direct WhatsApp</div>
                            <div class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 transition">+91 86072 48802</div>
                        </div>
                    </a>

                    <!-- Email Direct -->
                    <a
                        href="mailto:contact@sourcemonster.in"
                        class="flex items-center gap-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/80 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 transition group shadow-xs"
                    >
                        <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                            <i data-lucide="mail" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <div class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500">Official Inbox</div>
                            <div class="text-base font-bold text-slate-900 dark:text-white group-hover:text-primary transition">contact@sourcemonster.in</div>
                        </div>
                    </a>
                </div>

                <!-- Guarantee Badge -->
                <div class="flex items-center gap-2.5 text-xs font-mono text-slate-500 dark:text-slate-400">
                    <i data-lucide="clock" class="w-4 h-4 text-primary"></i>
                    <span>Guaranteed response time: &lt; 2 business hours</span>
                </div>
            </div>

            <!-- Right Form Column (7 cols) -->
            <div class="lg:col-span-7" data-aos="fade-left">
                <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 p-6 sm:p-10 rounded-3xl sm:rounded-[2.5rem] shadow-2xl">
                    <form id="contact-form" class="space-y-4 sm:space-y-5">
                        <!-- Anti-spam Honeypot -->
                        <input type="text" name="honeypot" class="hidden" tabindex="-1" autocomplete="off" />
                        <input type="hidden" name="sourcePage" id="source-page-input" value="/" />

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
                            <div>
                                <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                                    Your Name *
                                </label>
                                <input
                                    name="name"
                                    type="text"
                                    required
                                    class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-base text-slate-900 dark:text-white"
                                    placeholder="Alex Morgan"
                                />
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                                    Email Address *
                                </label>
                                <input
                                    name="email"
                                    type="email"
                                    required
                                    class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-base text-slate-900 dark:text-white"
                                    placeholder="alex@company.com"
                                />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
                            <div>
                                <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                                    Company / Project Name
                                </label>
                                <input
                                    name="company"
                                    type="text"
                                    class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-base text-slate-900 dark:text-white"
                                    placeholder="Acme Labs"
                                />
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                                    Service / Product Needed *
                                </label>
                                <select
                                    id="service-select"
                                    name="service"
                                    required
                                    class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-slate-900 dark:text-white text-base"
                                >
                                    <option value="Custom Development">Custom Development</option>
                                    <option value="Product Customization">Product Customization</option>
                                    <option value="Web Engineering">Web Engineering</option>
                                    <option value="SaaS Architecture">SaaS Architecture</option>
                                    <option value="Mobile App Development">Mobile App Development</option>
                                    <option value="Enterprise DevOps">Enterprise DevOps</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-wider font-mono font-bold text-slate-500 dark:text-slate-400 mb-2">
                                Project Scope &amp; Details *
                            </label>
                            <textarea
                                name="message"
                                id="contact-message"
                                rows="4"
                                required
                                class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-base text-slate-900 dark:text-white"
                                placeholder="Describe your project, timeline, and key requirements..."
                            ></textarea>
                        </div>

                        <button
                            type="submit"
                            class="w-full bg-primary hover:bg-orange-600 active:scale-95 text-white py-4 sm:py-4.5 rounded-2xl font-bold text-base sm:text-lg shadow-xl shadow-primary/25 hover:shadow-2xl hover:shadow-primary/40 transition-all flex items-center justify-center gap-2 cursor-pointer"
                        >
                            <span class="btn-text">INITIALIZE PROJECT</span>
                            <div class="spinner hidden w-5 h-5 border-3 border-white border-t-transparent rounded-full animate-spin"></div>
                        </button>

                        <div id="form-status" class="hidden text-center p-3.5 rounded-2xl font-bold text-sm"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { actions, isInputError } from 'astro:actions';

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status');
    const button = form?.querySelector('button[type="submit"]');
    const btnText = button?.querySelector('.btn-text');
    const spinner = button?.querySelector('.spinner');
    const sourcePageInput = document.getElementById('source-page-input') as HTMLInputElement;
    const serviceSelect = document.getElementById('service-select') as HTMLSelectElement;
    const messageTextarea = document.getElementById('contact-message') as HTMLTextAreaElement;

    // Check for query parameters (?product=... or ?service=...)
    try {
        if (typeof window !== "undefined") {
            const urlParams = new URLSearchParams(window.location.search);
            const productParam = urlParams.get('product');
            const serviceParam = urlParams.get('service');

            if (sourcePageInput) {
                sourcePageInput.value = window.location.pathname + window.location.search;
            }

            if (productParam && serviceSelect) {
                const option = document.createElement("option");
                option.value = `Customization: ${productParam}`;
                option.text = `Customization: ${productParam}`;
                option.selected = true;
                serviceSelect.prepend(option);

                if (messageTextarea && !messageTextarea.value) {
                    messageTextarea.placeholder = `I am interested in customizing ${productParam}. Here are my requirements...`;
                }
            } else if (serviceParam && serviceSelect) {
                serviceSelect.value = serviceParam;
            }
        }
    } catch (e) {
        // Fallback gracefully
    }

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (!status || !button || !btnText || !spinner) return;

        // Reset status
        status.classList.add('hidden');
        status.classList.remove('bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-400', 'bg-rose-500/10', 'text-rose-700', 'dark:text-rose-400');
        
        // Loading state
        button.setAttribute('disabled', 'true');
        btnText.classList.add('hidden');
        spinner.classList.remove('hidden');

        const formData = new FormData(form);
        const { data, error } = await actions.sendEmail(formData);

        // Reset state
        button.removeAttribute('disabled');
        btnText.classList.remove('hidden');
        spinner.classList.add('hidden');

        if (error) {
            if (isInputError(error)) {
                const messages = Object.values(error.fields).flat().join(', ');
                status.textContent = "Validation Error: " + messages;
            } else {
                status.textContent = "Error: " + error.message;
            }
            status.classList.add('bg-rose-500/10', 'text-rose-700', 'dark:text-rose-400');
            status.classList.remove('hidden');
        } else {
            status.textContent = "Project Initialized! Our team will reach out within 2 hours.";
            status.classList.add('bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-400');
            status.classList.remove('hidden');
            form.reset();
        }
    });
</script>

<style>
	.text-gradient {
		background: linear-gradient(135deg, #FF4D1C 0%, #FF8E6E 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.hero-glow {
		position: absolute;
		width: 500px;
		height: 500px;
		background: radial-gradient(circle, rgba(255, 77, 28, 0.1) 0%, transparent 70%);
		border-radius: 50%;
		filter: blur(80px);
	}
</style>
