---
---
<section id="contact" class="pt-32 bg-white dark:bg-slate-950 relative overflow-hidden transition-colors">
    <div class="hero-glow -bottom-60 left-1/2 -translate-x-1/2 opacity-30"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-20 items-center mb-32">
            <div data-aos="fade-right">
                <h2 class="text-6xl font-black font-heading leading-tight mb-10 text-slate-900 dark:text-white">
                    READY TO <br />
                    <span class="text-gradient">START THE HUNT?</span>
                </h2>
                <p class="text-xl text-slate-600 dark:text-slate-400 mb-12 leading-relaxed">
                    Don't let your competition evolve faster than you. Claim your territory in the digital wild right now.
                </p>

                <div class="space-y-6">
                    <div class="flex items-center space-x-6">
                        <div class="w-12 h-12 glass-card dark:bg-slate-900 dark:border-slate-800 rounded-xl flex items-center justify-center text-primary">
                            <i data-lucide="mail"></i>
                        </div>
                        <span class="text-lg font-bold text-slate-900 dark:text-white">contact@sourcemonster.in</span>
                    </div>
                    <div class="flex items-center space-x-6">
                        <div class="w-12 h-12 glass-card dark:bg-slate-900 dark:border-slate-800 rounded-xl flex items-center justify-center text-primary">
                            <i data-lucide="phone"></i>
                        </div>
                        <span class="text-lg font-bold text-slate-900 dark:text-white">+91 86072 48802</span>
                    </div>
                </div>
            </div>

            <div class="glass-card dark:bg-slate-900/90 dark:border-slate-800 p-8 sm:p-12 rounded-[2.5rem] sm:rounded-[3.5rem] shadow-2xl shadow-slate-200/50 dark:shadow-black/60" data-aos="fade-left">
                <form id="contact-form" class="space-y-5">
                    <!-- Anti-spam Honeypot -->
                    <input type="text" name="honeypot" class="hidden" tabindex="-1" autocomplete="off" />
                    <input type="hidden" name="sourcePage" id="source-page-input" value="/" />

                    <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 dark:text-slate-400 mb-2">Your Name *</label>
                            <input name="name" type="text" required class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary outline-none transition-all text-sm text-slate-900 dark:text-white" placeholder="John Wick" />
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 dark:text-slate-400 mb-2">Email Address *</label>
                            <input name="email" type="email" required class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary outline-none transition-all text-sm text-slate-900 dark:text-white" placeholder="wick@continental.com" />
                        </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-4 sm:gap-6">
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 dark:text-slate-400 mb-2">Company / Organization</label>
                            <input name="company" type="text" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary outline-none transition-all text-sm text-slate-900 dark:text-white" placeholder="Continental Labs" />
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 dark:text-slate-400 mb-2">Service / Product Needed</label>
                            <select id="service-select" name="service" required class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary outline-none transition-all text-slate-900 dark:text-white text-sm">
                                <option value="Custom Development">Custom Development</option>
                                <option value="Product Customization">Product Customization</option>
                                <option value="Web Engineering">Web Engineering</option>
                                <option value="Growth Strategy">Growth Strategy</option>
                                <option value="App Development">App Development</option>
                                <option value="Visual Identity">Visual Identity</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 dark:text-slate-400 mb-2">Message *</label>
                        <textarea name="message" id="contact-message" rows="4" required class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3.5 sm:p-4 rounded-2xl focus:ring-2 focus:ring-primary outline-none transition-all text-sm text-slate-900 dark:text-white" placeholder="Tell us about the beast we're building..."></textarea>
                    </div>
                    <button type="submit" class="w-full bg-primary text-white py-4 sm:py-5 rounded-2xl font-bold text-lg sm:text-xl hover:shadow-2xl hover:shadow-primary/30 active:scale-[0.98] transition-all flex items-center justify-center space-x-3">
                        <span class="btn-text">INITIALIZE PROJECT</span>
                        <div class="spinner hidden w-6 h-6 border-4 border-white border-t-transparent rounded-full animate-spin"></div>
                    </button>
                    <div id="form-status" class="hidden text-center p-4 rounded-2xl font-bold text-sm"></div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    import { actions, isInputError } from 'astro:actions';


    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status');
    const button = form?.querySelector('button[type="submit"]');
    const btnText = button?.querySelector('.btn-text');
    const spinner = button?.querySelector('.spinner');
    const sourcePageInput = document.getElementById('source-page-input') as HTMLInputElement;
    const serviceSelect = document.getElementById('service-select') as HTMLSelectElement;
    const messageTextarea = document.getElementById('contact-message') as HTMLTextAreaElement;

    // Check for query parameters (?product=... or ?service=...)
    try {
        if (typeof window !== "undefined") {
            const urlParams = new URLSearchParams(window.location.search);
            const productParam = urlParams.get('product');
            const serviceParam = urlParams.get('service');

            if (sourcePageInput) {
                sourcePageInput.value = window.location.pathname + window.location.search;
            }

            if (productParam && serviceSelect) {
                // Add product option if not present
                const option = document.createElement("option");
                option.value = `Customization: ${productParam}`;
                option.text = `Customization: ${productParam}`;
                option.selected = true;
                serviceSelect.prepend(option);

                if (messageTextarea && !messageTextarea.value) {
                    messageTextarea.placeholder = `I am interested in customizing ${productParam}. Here are my requirements...`;
                }
            } else if (serviceParam && serviceSelect) {
                serviceSelect.value = serviceParam;
            }
        }
    } catch (e) {
        // Fallback gracefully
    }

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (!status || !button || !btnText || !spinner) return;

        // Reset status
        status.classList.add('hidden');
        status.classList.remove('bg-green-100', 'text-green-800', 'bg-red-100', 'text-red-800');
        
        // Loading state
        button.setAttribute('disabled', 'true');
        btnText.classList.add('hidden');
        spinner.classList.remove('hidden');

        const formData = new FormData(form);
        const { data, error } = await actions.sendEmail(formData);

        // Reset state
        button.removeAttribute('disabled');
        btnText.classList.remove('hidden');
        spinner.classList.add('hidden');

        if (error) {
            if (isInputError(error)) {
                // Collect all validation messages
                const messages = Object.values(error.fields).flat().join(', ');
                status.textContent = "Validation Error: " + messages;
            } else {
                status.textContent = "Error: " + error.message;
            }
            status.classList.add('bg-red-100', 'text-red-800');
            status.classList.remove('hidden');
        } else {

            status.textContent = "Mission Initialized! We'll reach out soon.";
            status.classList.add('bg-green-100', 'text-green-800');
            status.classList.remove('hidden');
            form.reset();
        }
    });
</script>

<style>
	.text-gradient {
		background: linear-gradient(to right, #FF4D1C, #FF8E6E);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    :global(.dark) .glass-card {
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
</style>
