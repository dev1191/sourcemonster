---
interface Props {
  hasGallery?: boolean;
  galleryCount?: number;
  hasFeatures?: boolean;
  addonsCount?: number;
  changelogsCount?: number;
  whatsappUrl: string;
}

const {
  hasGallery = false,
  galleryCount = 0,
  hasFeatures = false,
  addonsCount = 0,
  changelogsCount = 0,
  whatsappUrl,
} = Astro.props;

const showGalleryTab = hasGallery || galleryCount > 0;
---

<div
  class="sticky top-20 z-10 p-1.5 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-2xl shadow-lg flex items-center gap-1 overflow-x-auto"
>
  <a
    href="#overview"
    class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition whitespace-nowrap"
  >
    Overview
  </a>

  {
    hasFeatures && (
      <a
        href="#features"
        class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition whitespace-nowrap"
      >
        Key Capabilities
      </a>
    )
  }

  {
    addonsCount > 0 && (
      <a
        href="#addons"
        class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition whitespace-nowrap flex items-center gap-1.5"
      >
        <span>Modules &amp; Add-ons</span>
        <span class="px-1.5 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-mono">
          {addonsCount}
        </span>
      </a>
    )
  }

  {
    showGalleryTab && (
      <a
        href="#gallery"
        class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition whitespace-nowrap flex items-center gap-1.5"
      >
        <i data-lucide="images" class="w-3.5 h-3.5" />
        <span>Gallery</span>
        {galleryCount > 0 && (
          <span class="px-1.5 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-mono font-semibold">
            {galleryCount}
          </span>
        )}
      </a>
    )
  }

  {
    changelogsCount > 0 && (
      <a
        href="#changelogs"
        class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition whitespace-nowrap flex items-center gap-1.5"
      >
        <span>Changelogs</span>
        <span class="px-1.5 py-0.5 rounded-full bg-slate-200 dark:bg-slate-800 text-[10px] font-mono">
          {changelogsCount}
        </span>
      </a>
    )
  }

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="ml-auto px-4 py-2 rounded-xl text-xs font-bold bg-[#25D366]/10 hover:bg-[#25D366] text-[#25D366] hover:text-white transition whitespace-nowrap flex items-center gap-1.5"
  >
    <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
    <span>Request Customization</span>
  </a>
</div>
