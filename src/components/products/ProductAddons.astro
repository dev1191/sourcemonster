---
import type { PublicProductDetail } from "../../services/products.service";

interface Props {
  addons: PublicProductDetail["addons"];
}

const { addons } = Astro.props;

if (!addons || addons.length === 0) return null;
---

<section id="addons" class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl space-y-6">
  <div class="flex items-center justify-between flex-wrap gap-4 pb-5 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-3">
      <span class="p-2.5 rounded-2xl bg-primary/10 text-primary">
        <i data-lucide="puzzle" class="w-6 h-6"></i>
      </span>
      <div>
        <h2 class="text-2xl font-black font-heading text-slate-900 dark:text-white tracking-tight">
          Companion Add-ons &amp; Modules
        </h2>
        <p class="text-xs text-slate-500 font-mono">Extend functionality with drop-in enhancements</p>
      </div>
    </div>
    <span class="px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-mono font-bold">
      {addons.length} {addons.length === 1 ? "module" : "modules"} available
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {addons.map((addon) => (
      <div class="bg-slate-50/80 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 hover:border-primary/50 dark:hover:border-primary/40 rounded-3xl p-5 flex flex-col justify-between transition-all duration-300 group shadow-sm hover:shadow-xl">
        <div>
          {addon.thumbnailUrl ? (
            <div class="rounded-2xl overflow-hidden mb-4 border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-48 relative">
              <img
                src={addon.thumbnailUrl}
                alt={addon.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
          ) : (
            <div class="rounded-2xl mb-4 border border-dashed border-slate-300 dark:border-slate-800 bg-slate-100/50 dark:bg-slate-900/50 aspect-video max-h-36 flex items-center justify-center text-slate-400">
              <i data-lucide="puzzle" class="w-8 h-8 opacity-40"></i>
            </div>
          )}

          <div class="flex items-start justify-between gap-3 mb-2.5">
            <h3 class="font-bold text-lg text-slate-900 dark:text-white group-hover:text-primary transition-colors">
              {addon.name}
            </h3>
            {addon.isFree ? (
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-bold uppercase tracking-wider shrink-0 font-mono">
                Free
              </span>
            ) : addon.price ? (
              <span class="px-3 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20 text-xs font-black font-mono shrink-0">
                ${parseFloat(addon.price).toFixed(2)}
              </span>
            ) : null}
          </div>

          {addon.description && (
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 mb-4">
              {addon.description}
            </p>
          )}

          <!-- Add-on Screenshots Mini Gallery -->
          {addon.gallery && addon.gallery.length > 0 && (
            <div class="mb-4 pt-3 border-t border-slate-200 dark:border-slate-800/60">
              <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-2 uppercase tracking-wider flex items-center gap-1.5 font-mono">
                <i data-lucide="camera" class="w-3.5 h-3.5 text-primary"></i>
                <span>Module Gallery ({addon.gallery.length})</span>
              </div>
              <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-thin">
                {addon.gallery.map((img) => (
                  <a
                    href={img.url || "#"}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-16 h-12 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800 hover:border-primary shrink-0 transition"
                    title={img.caption || addon.name}
                  >
                    <img src={img.url || ""} alt="Screenshot" class="w-full h-full object-cover" loading="lazy" />
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <div class="flex items-center gap-2 pt-3 border-t border-slate-200 dark:border-slate-800/80 mt-auto">
          {addon.buyUrl && (
            <a
              href={addon.buyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 py-2.5 px-3 bg-primary hover:bg-orange-600 text-white rounded-xl text-xs font-bold text-center shadow-md shadow-primary/20 transition flex items-center justify-center gap-1.5"
            >
              <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
              <span>Get Add-on</span>
            </a>
          )}
          {addon.demoUrl && (
            <a
              href={addon.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="py-2.5 px-3 bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 rounded-xl text-xs font-semibold transition flex items-center justify-center gap-1.5"
            >
              <i data-lucide="play-circle" class="w-3.5 h-3.5 text-emerald-500"></i>
              <span>Demo</span>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

