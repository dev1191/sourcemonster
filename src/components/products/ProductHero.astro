---
import type { Product } from "../../lib/db/schema/products";

interface Props {
  product: Product;
  addonsCount?: number;
  changelogsCount?: number;
  lastUpdatedDate?: Date | string;
}

const {
  product,
  addonsCount = 0,
  changelogsCount = 0,
  lastUpdatedDate = product.updatedAt,
} = Astro.props;

const formattedDate = new Date(lastUpdatedDate).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<!-- Ambient Hero Background Aura -->
<div class="relative overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-primary/10 via-primary/5 to-transparent blur-3xl pointer-events-none -z-10"></div>

  <!-- Admin Preview Banner -->
  {product.status !== "published" && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 mb-2">
      <div class="p-4 bg-amber-500/10 border border-amber-500/30 rounded-2xl text-amber-800 dark:text-amber-200 text-xs flex flex-wrap items-center justify-between gap-3 shadow-sm">
        <div class="flex items-center gap-2.5">
          <span class="p-1 rounded-lg bg-amber-500/20 text-amber-600 dark:text-amber-400">
            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
          </span>
          <span>
            <strong>Draft Mode:</strong> This product is currently unpublished and only visible to authenticated administrators.
          </span>
        </div>
        <a
          href={`/admin/products/${product.id}/edit`}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-900 dark:text-amber-100 font-semibold transition"
        >
          <span>Edit in CMS</span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
      </div>
    </div>
  )}

  <!-- Hero Header Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
      <a href="/" class="hover:text-primary transition flex items-center gap-1">
        <i data-lucide="home" class="w-3.5 h-3.5"></i>
        <span>Home</span>
      </a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <a href="/products" class="hover:text-primary transition">Products</a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-slate-900 dark:text-white font-semibold truncate max-w-xs sm:max-w-md">{product.title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8">
        <!-- Badges Row -->
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold font-mono uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            CodeCanyon Verified
          </span>

          {product.version && (
            <span class="px-3 py-1 rounded-full bg-slate-200/80 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono font-semibold">
              {product.version}
            </span>
          )}

          {product.isFeatured && (
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider">
              <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
              Featured Architecture
            </span>
          )}

          <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-medium font-mono">
            Production Ready
          </span>
        </div>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-5xl lg:text-5xl font-black font-heading tracking-tight text-slate-900 dark:text-white mb-5 leading-tight">
          {product.title}
        </h1>

        <!-- Short Description -->
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl mb-6">
          {product.shortDescription}
        </p>

        <!-- Tech Stack Tags -->
        {product.technologies && product.technologies.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs uppercase tracking-wider text-slate-500 font-mono font-bold mr-1">Stack:</span>
            {product.technologies.map((t) => (
              <span class="px-3 py-1 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 font-mono shadow-xs hover:border-primary/40 transition">
                {t}
              </span>
            ))}
          </div>
        )}
      </div>

      <!-- Quick Stat Card in Hero (Desktop) -->
      <div class="lg:col-span-4 bg-white/70 dark:bg-slate-900/60 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-3xl p-5 shadow-lg">
        <div class="grid grid-cols-2 gap-4 text-center">
          <div class="p-3 bg-slate-50 dark:bg-slate-950/70 rounded-2xl border border-slate-200/80 dark:border-slate-800/80">
            <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">Add-ons</div>
            <div class="text-xl font-black text-slate-900 dark:text-white mt-1">
              {addonsCount} <span class="text-xs font-normal text-slate-500">modules</span>
            </div>
          </div>
          <div class="p-3 bg-slate-50 dark:bg-slate-950/70 rounded-2xl border border-slate-200/80 dark:border-slate-800/80">
            <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">Updates</div>
            <div class="text-xl font-black text-primary mt-1">
              {changelogsCount} <span class="text-xs font-normal text-slate-500">releases</span>
            </div>
          </div>
          <div class="p-3 bg-slate-50 dark:bg-slate-950/70 rounded-2xl border border-slate-200/80 dark:border-slate-800/80">
            <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">Last Release</div>
            <div class="text-xs font-bold text-slate-800 dark:text-slate-200 mt-1.5 truncate">
              {formattedDate}
            </div>
          </div>
          <div class="p-3 bg-slate-50 dark:bg-slate-950/70 rounded-2xl border border-slate-200/80 dark:border-slate-800/80">
            <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">License</div>
            <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 mt-1.5">
              Commercial
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

