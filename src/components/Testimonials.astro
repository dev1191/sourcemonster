---
import { getCollection } from 'astro:content';
import { getAllTestimonials } from '../services';

let testimonialsList: Array<{
  data: {
    name: string;
    role: string;
    quote: string;
    color?: string;
    delay?: number;
  };
}> = [];

try {
  const dbTestimonials = await getAllTestimonials({ onlyPublished: true });

  if (dbTestimonials.length > 0) {
    testimonialsList = dbTestimonials.map((t, idx) => ({
      data: {
        name: t.name,
        role: t.role,
        quote: t.quote,
        color: t.color || 'primary',
        delay: idx * 100,
      },
    }));
  } else {
    const rawTestimonials = await getCollection('testimonials');
    testimonialsList = rawTestimonials.map((r) => ({ data: r.data }));
  }
} catch {
  const rawTestimonials = await getCollection('testimonials');
  testimonialsList = rawTestimonials.map((r) => ({ data: r.data }));
}
---
<!-- Testimonials Section -->
<section id="testimonials" class="py-20 sm:py-32 bg-slate-50 dark:bg-slate-950 relative overflow-hidden transition-colors border-t border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-16 sm:mb-20" data-aos="fade-up">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-mono font-bold tracking-widest uppercase mb-4">
                <span class="w-2 h-2 rounded-full bg-primary"></span>
                <span>Verified Client Reviews</span>
            </div>
            <h2 class="text-3xl xs:text-4xl sm:text-5xl font-black font-heading tracking-tight text-slate-900 dark:text-white">
                TRUSTED BY <span class="text-gradient">INDUSTRY LEADERS.</span>
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {testimonialsList.map((item, index) => (
                <div
                    class="bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800/90 p-6 sm:p-8 rounded-3xl hover:border-primary/50 dark:hover:border-primary/50 transition-all duration-300 shadow-lg hover:shadow-2xl hover:-translate-y-1.5 flex flex-col justify-between"
                    data-aos="fade-up"
                    data-aos-delay={item.data.delay || index * 100}
                >
                    <div>
                        <!-- 5 Star Rating -->
                        <div class="flex items-center gap-1 text-amber-500 mb-5">
                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                            <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                        </div>

                        <!-- Quote -->
                        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base italic leading-relaxed mb-8">
                            "{item.data.quote}"
                        </p>
                    </div>

                    <!-- Client Info -->
                    <div class="flex items-center gap-3.5 border-t border-slate-100 dark:border-slate-800 pt-5">
                        <div class="w-11 h-11 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0 font-bold font-mono">
                            <i data-lucide="user-check" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-900 dark:text-white text-base">
                                {item.data.name}
                            </h4>
                            <p class="text-xs text-slate-500 dark:text-slate-400 font-mono font-medium uppercase tracking-wider">
                                {item.data.role}
                            </p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
	.text-gradient {
		background: linear-gradient(135deg, #FF4D1C 0%, #FF8E6E 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
</style>
