---
import { getCollection } from 'astro:content';
import { getAllTestimonials } from '../services';

let testimonialsList: Array<{
  data: {
    name: string;
    role: string;
    quote: string;
    color?: string;
    delay?: number;
  };
}> = [];

try {
  const dbTestimonials = await getAllTestimonials({ onlyPublished: true });

  if (dbTestimonials.length > 0) {
    testimonialsList = dbTestimonials.map((t, idx) => ({
      data: {
        name: t.name,
        role: t.role,
        quote: t.quote,
        color: t.color || 'primary',
        delay: idx * 100,
      },
    }));
  } else {
    const rawTestimonials = await getCollection('testimonials');
    testimonialsList = rawTestimonials.map((r) => ({ data: r.data }));
  }
} catch {
  const rawTestimonials = await getCollection('testimonials');
  testimonialsList = rawTestimonials.map((r) => ({ data: r.data }));
}
---
<!-- Testimonials Section -->
<section id="testimonials" class="py-32 bg-slate-50 dark:bg-slate-950 relative overflow-hidden transition-colors">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-24" data-aos="fade-up">
            <div class="text-primary font-bold tracking-widest uppercase mb-4">Voice of the Market</div>
            <h2 class="text-5xl font-black font-heading tracking-tight text-slate-900 dark:text-white">TRUSTED BY <span class="text-gradient">INDUSTRY LEADERS.</span></h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {testimonialsList.map((item) => (
                <div class="glass-card dark:bg-slate-900/80 dark:border-slate-800 p-10 rounded-[3rem] hover:translate-y-[-10px] transition-all duration-500 shadow-xl dark:shadow-none" data-aos="fade-up" data-aos-delay={item.data.delay}>
                    <div class="flex text-primary mb-6">
                        <i data-lucide="star" class="w-5 h-5 fill-current"></i><i data-lucide="star" class="w-5 h-5 fill-current"></i><i data-lucide="star" class="w-5 h-5 fill-current"></i><i data-lucide="star" class="w-5 h-5 fill-current"></i><i data-lucide="star" class="w-5 h-5 fill-current"></i>
                    </div>
                    <p class="text-lg text-slate-600 dark:text-slate-300 italic leading-relaxed mb-10">
                        "{item.data.quote}"
                    </p>
                    <div class="flex items-center space-x-4 border-t border-slate-100 dark:border-slate-800 pt-8">
                        <div class={`w-14 h-14 bg-${item.data.color}/10 rounded-2xl flex items-center justify-center text-${item.data.color}`}><i data-lucide="user-check" class="w-8 h-8"></i></div>
                        <div>
                            <h4 class="font-bold text-slate-900 dark:text-white text-xl">{item.data.name}</h4>
                            <p class="text-sm text-slate-400 font-bold uppercase tracking-widest">{item.data.role}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
	.text-gradient {
		background: linear-gradient(to right, #FF4D1C, #FF8E6E);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    :global(.dark) .glass-card {
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
</style>
