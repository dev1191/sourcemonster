---
import { getCollection } from 'astro:content';
import { getAllTestimonials } from '../services';

interface TestimonialItem {
  name: string;
  role: string;
  quote: string;
  source?: string;
  verified?: boolean;
}

const defaultReviews: TestimonialItem[] = [
  {
    name: "Alexey D.",
    role: "CTO, FleetLogix",
    quote: "The system is exceptionally solid, particularly the backend API architecture. Saved us 4+ months of heavy engineering time. We recommend SourceMonster highly!",
    source: "Verified Buyer · CodeCanyon",
    verified: true,
  },
  {
    name: "Marcus Vance",
    role: "Founder, SaaSForge",
    quote: "I've purchased multiple boilerplates across marketplaces, but SourceMonster's codebase is far superior. Ultra clean TypeScript, modular architecture, and rapid customer support.",
    source: "Enterprise Client",
    verified: true,
  },
  {
    name: "Mohamad Hassan",
    role: "Lead Architect, PayMatrix",
    quote: "The cleanest code we've encountered in our software journey. Every layer is documented, migration scripts run flawlessly, and performance is blistering fast.",
    source: "Verified Buyer · CodeCanyon",
    verified: true,
  },
];

let reviewsList: TestimonialItem[] = [];

try {
  const dbTestimonials = await getAllTestimonials({ onlyPublished: true });
  if (dbTestimonials && dbTestimonials.length > 0) {
    reviewsList = dbTestimonials.map((t) => ({
      name: t.name,
      role: t.role,
      quote: t.quote,
      source: "Verified Client",
      verified: true,
    }));
  } else {
    reviewsList = defaultReviews;
  }
} catch {
  reviewsList = defaultReviews;
}
---

<!-- Reviews Section (Lume Agency Inspired) -->
<section id="reviews" class="py-20 sm:py-32 bg-slate-100/50 dark:bg-[#070913] relative overflow-hidden transition-colors border-t border-slate-200/80 dark:border-white/[0.08]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 sm:mb-20" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.1] text-xs font-mono uppercase tracking-widest text-primary font-bold mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        <span>Our Reviews</span>
      </div>
      <h2 class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-black font-heading tracking-tight text-slate-900 dark:text-white leading-tight">
        What Our Clients Say.
      </h2>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {reviewsList.map((item, idx) => {
        const initials = item.name
          .split(" ")
          .map((n) => n[0])
          .slice(0, 2)
          .join("");

        return (
          <div
            class="p-7 sm:p-8 rounded-3xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 transition-all duration-300 flex flex-col justify-between group shadow-sm hover:shadow-xl hover:-translate-y-1"
            data-aos="fade-up"
            data-aos-delay={idx * 100}
          >
            <div>
              <!-- Client Avatar & Info -->
              <div class="flex items-center gap-3.5 mb-6">
                <div class="w-11 h-11 rounded-full bg-primary/10 text-primary font-bold text-sm flex items-center justify-center border border-primary/20 shrink-0 font-mono">
                  {initials}
                </div>
                <div>
                  <h4 class="font-bold text-base font-heading text-slate-900 dark:text-white leading-tight">
                    {item.name}
                  </h4>
                  <p class="text-xs text-slate-500 dark:text-slate-400 font-mono mt-0.5">
                    {item.role}
                  </p>
                </div>
              </div>

              <!-- Quote -->
              <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
                "{item.quote}"
              </p>
            </div>

            <!-- Footer Badge -->
            <div class="pt-4 border-t border-slate-100 dark:border-white/[0.06] flex items-center justify-between">
              <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400">
                {item.source}
              </span>
              <div class="flex text-amber-400">
                <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
                <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
                <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
                <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
                <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
