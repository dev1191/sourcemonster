---
import { getCollection } from 'astro:content';
import { getAllServices } from '../services';

let servicesList: Array<{
  data: {
    title: string;
    description: string;
    icon: string;
    color?: string;
    delay?: number;
  };
}> = [];

try {
  const dbServices = await getAllServices({ onlyPublished: true });

  if (dbServices.length > 0) {
    servicesList = dbServices.map((s, idx) => ({
      data: {
        title: s.title,
        description: s.description,
        icon: s.icon,
        color: s.color || 'primary',
        delay: idx * 100,
      },
    }));
  } else {
    const rawServices = await getCollection('services');
    servicesList = rawServices.map((r) => ({ data: r.data }));
  }
} catch {
  const rawServices = await getCollection('services');
  servicesList = rawServices.map((r) => ({ data: r.data }));
}
---
<!-- Services / Specializations Section -->
<section id="services" class="py-20 sm:py-32 relative bg-slate-50 dark:bg-slate-950 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-16 sm:mb-20">
            <div data-aos="fade-up">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-mono font-bold tracking-widest uppercase mb-4">
                    <span class="w-2 h-2 rounded-full bg-primary"></span>
                    <span>Engineering Capabilities</span>
                </div>
                <h2 class="text-3xl xs:text-4xl sm:text-5xl md:text-6xl font-black font-heading leading-tight tracking-tight text-slate-900 dark:text-white">
                    DOMINATE THE <br class="hidden sm:inline" />
                    <span class="text-gradient">DIGITAL WILD.</span>
                </h2>
            </div>
            <p class="mt-6 lg:mt-0 text-slate-600 dark:text-slate-400 max-w-md text-base sm:text-lg leading-relaxed" data-aos="fade-left">
                We provide the precision engineering needed for your venture to outpace competitors with maximum velocity and zero compromise on reliability.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {servicesList.map((item, index) => (
                <div
                    class="group p-6 sm:p-8 bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800/90 hover:border-primary/50 dark:hover:border-primary/50 rounded-3xl transition-all duration-300 shadow-lg hover:shadow-2xl hover:-translate-y-1.5 flex flex-col justify-between"
                    data-aos="fade-up"
                    data-aos-delay={item.data.delay || index * 80}
                >
                    <div>
                        <!-- Icon Box -->
                        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-all duration-300 shadow-sm">
                            <i data-lucide={item.data.icon} class="w-7 h-7 sm:w-8 sm:h-8"></i>
                        </div>

                        <!-- Title -->
                        <h3 class="text-xl sm:text-2xl font-black mb-3 font-heading text-slate-900 dark:text-white group-hover:text-primary transition-colors tracking-tight">
                            {item.data.title}
                        </h3>

                        <!-- Description -->
                        <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed mb-6">
                            {item.data.description}
                        </p>
                    </div>

                    <!-- Footer Link -->
                    <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-bold text-primary group-hover:translate-x-1 transition-transform">
                        <span>Initialize Service</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
	.text-gradient {
		background: linear-gradient(135deg, #FF4D1C 0%, #FF8E6E 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
</style>
