---
import { getPublishedProjects } from "../services";

const projects = await getPublishedProjects();
// Take top 4 or featured projects for the homepage
const featuredProjects = projects.filter((p) => p.isFeatured);
const displayProjects = featuredProjects.length > 0 ? featuredProjects.slice(0, 4) : projects.slice(0, 4);
---

{displayProjects.length > 0 && (
  <section id="projects" class="py-20 sm:py-32 bg-slate-100 dark:bg-slate-900/60 text-slate-900 dark:text-white relative overflow-hidden transition-colors border-y border-slate-200/80 dark:border-slate-800/80">
    <!-- Ambient Background Glows -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary/10 rounded-full blur-[130px] -mr-40 -mt-40 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary/10 rounded-full blur-[130px] -ml-40 -mb-40 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16" data-aos="fade-up">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-mono font-bold tracking-widest uppercase mb-4">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            <span>Commercial Software</span>
          </div>
          <h2 class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-black font-heading tracking-tight text-slate-900 dark:text-white leading-tight">
            ENGINEERED <span class="text-gradient">SOFTWARE BEASTS.</span>
          </h2>
          <p class="mt-4 text-slate-600 dark:text-slate-400 max-w-xl text-base sm:text-lg leading-relaxed">
            Production-grade boilerplates, turnkey apps, and developer scripts ready for immediate commercial deployment.
          </p>
        </div>

        <div class="mt-6 md:mt-0">
          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-white hover:bg-slate-50 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-900 dark:text-white text-xs sm:text-sm font-bold border border-slate-200 dark:border-slate-700/80 hover:border-primary/50 transition-all shadow-xl hover:-translate-y-0.5 group"
          >
            <span>Browse All Projects ({projects.length})</span>
            <i data-lucide="arrow-right" class="w-4 h-4 text-primary group-hover:translate-x-1 transition-transform"></i>
          </a>
        </div>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {displayProjects.map((p, idx) => (
          <article
            class="bg-white dark:bg-slate-950/80 border border-slate-200/90 dark:border-slate-800/90 hover:border-primary/50 dark:hover:border-primary/50 rounded-3xl overflow-hidden transition-all duration-300 flex flex-col group shadow-xl hover:shadow-2xl hover:-translate-y-1"
            data-aos="fade-up"
            data-aos-delay={idx * 120}
          >
            <!-- Thumbnail preview -->
            <a href={`/projects/${p.slug}`} class="block relative aspect-video sm:h-64 overflow-hidden bg-slate-100 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800/80 group">
              {p.thumbnailUrl ? (
                <img
                  src={p.thumbnailUrl}
                  alt={p.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center text-slate-400 dark:text-slate-700">
                  <i data-lucide="package" class="w-12 h-12 mb-2 text-slate-400 dark:text-slate-700"></i>
                  <span class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-600 font-mono">SourceMonster Project</span>
                </div>
              )}

              <!-- Badges Over Image -->
              <div class="absolute top-3 left-3 sm:top-4 sm:left-4 flex items-center gap-2">
                {p.version && (
                  <span class="px-2.5 py-1 rounded-full bg-white/95 dark:bg-slate-950/90 backdrop-blur-md border border-slate-200 dark:border-slate-800 text-[10px] sm:text-[11px] font-mono text-slate-800 dark:text-slate-200 font-bold shadow-xs">
                    v{p.version}
                  </span>
                )}
                {p.isFeatured && (
                  <span class="px-2.5 py-1 rounded-full bg-primary text-white text-[9px] sm:text-[10px] font-bold tracking-wider uppercase shadow-md shadow-primary/20">
                    Featured
                  </span>
                )}
              </div>

              {p.demoUrl && (
                <div class="absolute top-3 right-3 sm:top-4 sm:right-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/90 text-white backdrop-blur-md text-[10px] sm:text-[11px] font-semibold shadow-md">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                    <span>Live Demo</span>
                  </span>
                </div>
              )}
            </a>

            <!-- Card Content -->
            <div class="p-5 sm:p-7 flex flex-col flex-1 justify-between">
              <div>
                <a href={`/projects/${p.slug}`} class="block group">
                  <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white group-hover:text-primary transition-colors tracking-tight mb-2.5">
                    {p.title}
                  </h3>
                </a>

                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-2 mb-5">
                  {p.shortDescription}
                </p>

                <!-- Tech chips -->
                {p.technologies && p.technologies.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-6">
                    {p.technologies.slice(0, 4).map((tech) => (
                      <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] sm:text-[11px] text-slate-700 dark:text-slate-300 font-mono font-medium">
                        {tech}
                      </span>
                    ))}
                    {p.technologies.length > 4 && (
                      <span class="px-2 py-1 rounded-lg bg-slate-100/60 dark:bg-slate-900/60 text-[10px] text-slate-500 font-mono">
                        +{p.technologies.length - 4}
                      </span>
                    )}
                  </div>
                )}
              </div>

              <!-- Action buttons -->
              <div class="flex items-center gap-2.5 pt-4 border-t border-slate-200 dark:border-slate-800/80">
                <a
                  href={`/projects/${p.slug}`}
                  class="flex-1 py-3 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-bold text-xs text-center border border-slate-200 dark:border-slate-700 transition flex items-center justify-center gap-2"
                >
                  <span>Explore Architecture</span>
                  <i data-lucide="arrow-right" class="w-3.5 h-3.5 text-primary"></i>
                </a>

                {p.demoUrl && (
                  <a
                    href={p.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="py-3 px-3.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-bold text-xs transition border border-emerald-500/20 flex items-center gap-1.5"
                    title="Open Live Demo"
                  >
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    <span class="hidden sm:inline">Preview</span>
                  </a>
                )}

                {p.codecanyonUrl && (
                  <a
                    href={p.codecanyonUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="py-3 px-3.5 rounded-xl bg-primary hover:bg-orange-600 text-white font-bold text-xs transition shadow-md shadow-primary/20 flex items-center gap-1.5 shrink-0"
                    title="Purchase on CodeCanyon"
                  >
                    <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                    <span class="hidden sm:inline">CodeCanyon</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
	.text-gradient {
		background: linear-gradient(135deg, #FF4D1C 0%, #FF8E6E 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
</style>

