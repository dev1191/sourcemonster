---
import { Alert, AlertTitle, AlertDescription } from "../starwind/alert";

interface Props {
  variant?: "info" | "success" | "warning" | "error";
  title?: string;
  message?: string | null;
  icon?: string;
  class?: string;
}

const {
  variant = "info",
  title,
  message,
  icon,
  class: className = "my-4",
} = Astro.props;

// If neither message nor slot content is provided, do not render anything
const hasSlot = Astro.slots.has("default");
const shouldRender = Boolean(message || title || hasSlot);

const defaultIcons: Record<string, string> = {
  info: "info",
  success: "check-circle",
  warning: "alert-triangle",
  error: "alert-circle",
};

const resolvedIcon = icon || defaultIcons[variant] || "info";
---

{shouldRender && (
  <div class={className}>
    <Alert variant={variant}>
      <i data-lucide={resolvedIcon} class="w-4 h-4 shrink-0 mr-2.5"></i>
      <div class="flex-1 text-xs">
        {title && <AlertTitle class="font-bold text-sm mb-0.5">{title}</AlertTitle>}
        {message && <AlertDescription>{message}</AlertDescription>}
        <slot />
      </div>
    </Alert>
  </div>
)}

