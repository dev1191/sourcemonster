---
import type { HTMLAttributes } from "astro/types";
import { Table as StarwindTable } from "../starwind/table";
import {
  Pagination,
  PaginationContent,
  PaginationItem,
  PaginationLink,
  PaginationNext,
  PaginationPrevious,
  PaginationEllipsis,
} from "../starwind/pagination";

export interface TableFilterItem {
  label: string;
  value: string;
  href?: string;
  active?: boolean;
  count?: number;
}

export interface TablePaginationConfig {
  currentPage?: number;
  totalPages?: number;
  totalItems?: number;
  pageSize?: number;
  pageParamName?: string;
  baseUrl?: string;
  showPageSummary?: boolean;
}

interface Props extends HTMLAttributes<"table"> {
  isEmpty?: boolean;
  emptyTitle?: string;
  emptySubtitle?: string;
  emptyIcon?: string;
  containerClass?: string;
  class?: string;

  // Search capabilities
  searchable?: boolean;
  searchPlaceholder?: string;
  searchAction?: string;
  searchParamName?: string;
  searchValue?: string;

  // Filter capabilities
  filters?: TableFilterItem[];
  filterParamName?: string;
  activeFilter?: string;

  // Pagination capabilities
  pagination?: TablePaginationConfig | boolean;
  currentPage?: number;
  totalPages?: number;
  totalItems?: number;
  pageSize?: number;
  pageParamName?: string;
  baseUrl?: string;
  showPageSummary?: boolean;
  clientPagination?: boolean;
}

const {
  isEmpty = false,
  emptyTitle = "No records found",
  emptySubtitle,
  emptyIcon = "inbox",
  containerClass = "",
  class: className = "w-full text-left text-xs text-slate-700 dark:text-slate-300",

  searchable = false,
  searchPlaceholder = "Search records...",
  searchAction,
  searchParamName = "q",
  searchValue = "",

  filters = [],
  filterParamName = "status",
  activeFilter,

  pagination = false,
  currentPage,
  totalPages,
  totalItems,
  pageSize,
  pageParamName,
  baseUrl,
  showPageSummary,
  clientPagination = false,
  ...rest
} = Astro.props;

const tableId = `tbl-${Math.random().toString(36).substring(2, 9)}`;

const hasCustomEmpty = Astro.slots.has("empty");
const hasToolbarSlot = Astro.slots.has("toolbar");
const hasFiltersSlot = Astro.slots.has("filters");
const hasActionsSlot = Astro.slots.has("actions");
const hasCustomPagination = Astro.slots.has("pagination");

const showSearch = searchable || Boolean(searchAction);
const hasFilters = filters.length > 0 || hasFiltersSlot;
const hasHeaderBar = hasToolbarSlot || showSearch || hasFilters || hasActionsSlot;

// Resolved pagination settings
const paginationConfig: TablePaginationConfig = typeof pagination === "object" ? pagination : {};
const resolvedCurrentPage = currentPage ?? paginationConfig.currentPage ?? 1;
const resolvedTotalPages = totalPages ?? paginationConfig.totalPages ?? 1;
const resolvedTotalItems = totalItems ?? paginationConfig.totalItems;
const resolvedPageSize = pageSize ?? paginationConfig.pageSize ?? 10;
const resolvedPageParamName = pageParamName ?? paginationConfig.pageParamName ?? "page";
const resolvedBaseUrl = baseUrl ?? paginationConfig.baseUrl;
const resolvedShowPageSummary = showPageSummary ?? paginationConfig.showPageSummary ?? true;

const hasServerPagination = resolvedTotalPages > 1 || Boolean(pagination);
const hasPaginationFooter = hasCustomPagination || (hasServerPagination && !isEmpty) || clientPagination;

// Helper to generate range with ellipses: e.g. [1, "ellipsis-start", 4, 5, 6, "ellipsis-end", 10]
function getPaginationRange(current: number, total: number): (number | string)[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  if (current <= 3) {
    return [1, 2, 3, 4, "ellipsis-end", total];
  }

  if (current >= total - 2) {
    return [1, "ellipsis-start", total - 3, total - 2, total - 1, total];
  }

  return [1, "ellipsis-start", current - 1, current, current + 1, "ellipsis-end", total];
}

const pageNumbers = getPaginationRange(resolvedCurrentPage, resolvedTotalPages);

const startItem = resolvedTotalItems !== undefined && resolvedTotalItems > 0
  ? (resolvedCurrentPage - 1) * resolvedPageSize + 1
  : 0;
const endItem = resolvedTotalItems !== undefined
  ? Math.min(resolvedCurrentPage * resolvedPageSize, resolvedTotalItems)
  : 0;

const getPageUrl = (page: number) => {
  if (resolvedBaseUrl) {
    const separator = resolvedBaseUrl.includes("?") ? "&" : "?";
    return `${resolvedBaseUrl}${separator}${resolvedPageParamName}=${page}`;
  }
  const url = new URL(Astro.url);
  url.searchParams.set(resolvedPageParamName, page.toString());
  return `${url.pathname}?${url.searchParams.toString()}`;
};
---

<div
  id={tableId}
  class:list={[
    "bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl overflow-hidden shadow-sm dark:shadow-xl dark:shadow-black/40 flex flex-col",
    containerClass,
  ]}
>
  {/* Header Toolbar with Search & Filters */}
  {hasHeaderBar && (
    <div class="px-4 py-3.5 border-b border-slate-200 dark:border-slate-800/80 bg-slate-50/70 dark:bg-slate-950/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      {hasToolbarSlot ? (
        <slot name="toolbar" />
      ) : (
        <>
          {/* Left: Filters or Filter Pills */}
          <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none pb-1 sm:pb-0">
            {hasFiltersSlot ? (
              <slot name="filters" />
            ) : (
              filters.map((f) => {
                const isActive = f.active !== undefined ? f.active : activeFilter === f.value;
                const Tag = f.href ? "a" : "button";
                return (
                  <Tag
                    href={f.href}
                    data-filter-value={f.value}
                    class:list={[
                      "px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap transition border inline-flex items-center gap-1.5",
                      isActive
                        ? "bg-primary text-white border-primary shadow-sm shadow-primary/25"
                        : "bg-slate-100 dark:bg-slate-900/80 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800/90 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-800 hover:border-slate-300 dark:hover:border-slate-700",
                    ]}
                  >
                    <span>{f.label}</span>
                    {f.count !== undefined && (
                      <span
                        class:list={[
                          "px-1.5 py-0.2 rounded-full text-[10px] font-mono",
                          isActive
                            ? "bg-white/20 text-white"
                            : "bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400",
                        ]}
                      >
                        {f.count}
                      </span>
                    )}
                  </Tag>
                );
              })
            )}
          </div>

          {/* Right: Search Box & Actions */}
          <div class="flex items-center gap-2.5 shrink-0">
            {showSearch && (
              searchAction ? (
                /* Server-side Search Form */
                <form method="GET" action={searchAction} class="relative w-full sm:w-64">
                  <input
                    type="text"
                    name={searchParamName}
                    value={searchValue}
                    placeholder={searchPlaceholder}
                    class="w-full pl-9 pr-8 py-1.5 bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                  />
                  <div class="absolute left-3 top-2 text-slate-400 pointer-events-none">
                    <i data-lucide="search" class="w-3.5 h-3.5"></i>
                  </div>
                  {searchValue && (
                    <a
                      href={searchAction}
                      class="absolute right-2.5 top-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition"
                      title="Clear search"
                    >
                      <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    </a>
                  )}
                </form>
              ) : (
                /* Client-side Live Filter Search */
                <div class="relative w-full sm:w-64">
                  <input
                    type="text"
                    data-table-search
                    placeholder={searchPlaceholder}
                    class="w-full pl-9 pr-14 py-1.5 bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                  />
                  <div class="absolute left-3 top-2 text-slate-400 pointer-events-none">
                    <i data-lucide="search" class="w-3.5 h-3.5"></i>
                  </div>
                  <div class="absolute right-2.5 top-1.5 flex items-center gap-1">
                    <button
                      type="button"
                      data-search-clear
                      class="hidden text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition p-0.5"
                      title="Clear search"
                    >
                      <i data-lucide="x" class="w-3 h-3"></i>
                    </button>
                    <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono text-slate-400 bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 rounded">
                      /
                    </kbd>
                  </div>
                </div>
              )
            )}

            {hasActionsSlot && (
              <div class="flex items-center gap-2">
                <slot name="actions" />
              </div>
            )}
          </div>
        </>
      )}
    </div>
  )}

  {/* Main Table Content or Initial Empty State */}
  {
    isEmpty ? (
      hasCustomEmpty ? (
        <slot name="empty" />
      ) : (
        <div class="py-16 text-center text-slate-500 text-xs">
          {emptyIcon && (
            <i
              data-lucide={emptyIcon}
              class="w-12 h-12 mx-auto mb-3 text-slate-400 dark:text-slate-600"
            />
          )}
          <div class="font-semibold text-slate-800 dark:text-slate-300 text-sm">{emptyTitle}</div>
          {emptySubtitle && <div class="mt-1 text-slate-500 dark:text-slate-400">{emptySubtitle}</div>}
          {Astro.slots.has("empty-action") && (
            <div class="mt-4 flex justify-center">
              <slot name="empty-action" />
            </div>
          )}
        </div>
      )
    ) : (
      <div class="relative w-full overflow-x-auto">
        <StarwindTable class={className} {...rest}>
          <slot />
        </StarwindTable>

        {/* Dynamic Client-Side "No Search Results" State */}
        {!searchAction && showSearch && (
          <div
            data-search-no-results
            class="hidden py-14 text-center text-slate-500 text-xs border-t border-slate-200 dark:border-slate-800/60"
          >
            <i data-lucide="search-x" class="w-10 h-10 mx-auto mb-2 text-slate-400 dark:text-slate-600"></i>
            <div class="font-semibold text-slate-800 dark:text-slate-300 text-sm">No matching records found</div>
            <div class="mt-1 text-slate-500 dark:text-slate-400">
              No results match your search query: <span data-search-query-display class="font-mono text-primary font-bold"></span>
            </div>
            <div class="mt-3">
              <button
                type="button"
                data-reset-filter
                class="px-3 py-1 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white rounded-lg text-xs font-medium transition cursor-pointer"
              >
                Reset search
              </button>
            </div>
          </div>
        )}
      </div>
    )
  }

  {/* Table Footer / Pagination */}
  {hasPaginationFooter && (
    <div
      data-table-footer
      class="px-4 py-3 border-t border-slate-200 dark:border-slate-800/80 bg-slate-50/70 dark:bg-slate-950/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400"
    >
      {hasCustomPagination ? (
        <slot name="pagination" />
      ) : hasServerPagination ? (
        <>
          {/* Summary */}
          {resolvedShowPageSummary && (
            <div class="text-xs text-slate-500 dark:text-slate-400">
              {resolvedTotalItems !== undefined ? (
                <>
                  Showing <span class="font-semibold text-slate-800 dark:text-slate-200">{startItem}</span> to{" "}
                  <span class="font-semibold text-slate-800 dark:text-slate-200">{endItem}</span> of{" "}
                  <span class="font-semibold text-slate-800 dark:text-slate-200">{resolvedTotalItems}</span> records
                </>
              ) : (
                <>
                  Page <span class="font-semibold text-slate-800 dark:text-slate-200">{resolvedCurrentPage}</span> of{" "}
                  <span class="font-semibold text-slate-800 dark:text-slate-200">{resolvedTotalPages}</span>
                </>
              )}
            </div>
          )}

          {/* Starwind Pagination Controls */}
          {resolvedTotalPages > 1 && (
            <Pagination class="w-auto mx-0 justify-end">
              <PaginationContent class="gap-1">
                {/* Previous Button */}
                <PaginationItem>
                  <PaginationPrevious
                    href={resolvedCurrentPage > 1 ? getPageUrl(resolvedCurrentPage - 1) : undefined}
                    class={resolvedCurrentPage <= 1 ? "pointer-events-none opacity-40 cursor-not-allowed" : "cursor-pointer"}
                    size="sm"
                  />
                </PaginationItem>

                {/* Page Number Links with Ellipsis */}
                {pageNumbers.map((p) => {
                  if (p === "ellipsis-start" || p === "ellipsis-end") {
                    return (
                      <PaginationItem>
                        <PaginationEllipsis size="icon-sm" />
                      </PaginationItem>
                    );
                  }
                  const pageNum = Number(p);
                  const isCurrent = pageNum === resolvedCurrentPage;
                  return (
                    <PaginationItem>
                      <PaginationLink
                        href={getPageUrl(pageNum)}
                        isActive={isCurrent}
                        size="icon-sm"
                        class={isCurrent ? "font-bold shadow-xs" : ""}
                      >
                        {pageNum}
                      </PaginationLink>
                    </PaginationItem>
                  );
                })}

                {/* Next Button */}
                <PaginationItem>
                  <PaginationNext
                    href={resolvedCurrentPage < resolvedTotalPages ? getPageUrl(resolvedCurrentPage + 1) : undefined}
                    class={resolvedCurrentPage >= resolvedTotalPages ? "pointer-events-none opacity-40 cursor-not-allowed" : "cursor-pointer"}
                    size="sm"
                  />
                </PaginationItem>
              </PaginationContent>
            </Pagination>
          )}
        </>
      ) : clientPagination ? (
        <div data-client-pagination-container class="w-full flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div data-client-pagination-summary class="text-xs text-slate-500 dark:text-slate-400"></div>
          <div data-client-pagination-controls class="flex items-center gap-1 justify-end"></div>
        </div>
      ) : null}
    </div>
  )}
</div>

{/* Client-side Live Search Script */}
{!searchAction && showSearch && (
  <script is:inline define:vars={{ tableId }}>
    (() => {
      const root = document.getElementById(tableId);
      if (!root) return;

      const searchInput = root.querySelector("[data-table-search]");
      const clearBtn = root.querySelector("[data-search-clear]");
      const noResultsBox = root.querySelector("[data-search-no-results]");
      const queryDisplay = root.querySelector("[data-search-query-display]");
      const resetBtn = root.querySelector("[data-reset-filter]");
      const table = root.querySelector("table");

      if (!searchInput || !table) return;

      const getRows = () => Array.from(table.querySelectorAll("tbody tr"));

      const performFilter = (query) => {
        const rows = getRows();
        const trimmed = (query || "").trim().toLowerCase();
        let visibleCount = 0;

        if (clearBtn) {
          clearBtn.classList.toggle("hidden", trimmed.length === 0);
        }

        rows.forEach((row) => {
          if (row.getAttribute("data-slot") === "empty-row") return;

          const text = (row.textContent || "").toLowerCase();
          const matches = trimmed === "" || text.includes(trimmed);

          row.style.display = matches ? "" : "none";
          if (matches) visibleCount++;
        });

        if (noResultsBox) {
          if (visibleCount === 0 && trimmed.length > 0) {
            noResultsBox.classList.remove("hidden");
            if (queryDisplay) queryDisplay.textContent = `"${query.trim()}"`;
          } else {
            noResultsBox.classList.add("hidden");
          }
        }
      };

      searchInput.addEventListener("input", (e) => {
        performFilter(e.target.value);
      });

      const clearSearch = () => {
        searchInput.value = "";
        performFilter("");
        searchInput.focus();
      };

      if (clearBtn) clearBtn.addEventListener("click", clearSearch);
      if (resetBtn) resetBtn.addEventListener("click", clearSearch);

      // Keyboard shortcuts: "/" to focus, "Esc" to clear
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "/" &&
          document.activeElement !== searchInput &&
          !["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName)
        ) {
          e.preventDefault();
          searchInput.focus();
        } else if (e.key === "Escape" && document.activeElement === searchInput) {
          clearSearch();
          searchInput.blur();
        }
      });
    })();
  </script>
)}

