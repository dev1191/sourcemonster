---
import type { HTMLAttributes } from "astro/types";
import {
  Dropzone as StarwindDropzone,
  DropzoneUploadIndicator,
  DropzoneLoadingIndicator,
  DropzoneFilesList,
} from "../starwind/dropzone";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  label?: string;
  description?: string;
  helperText?: string;
  error?: string;
  isUploading?: boolean;
  disabled?: boolean;
  multiple?: boolean;
  accept?: string;
  name?: string;
  id?: string;
  required?: boolean;
  icon?: string;
  maxSizeLabel?: string;
  class?: string;
  dropzoneClass?: string;
  preview?: boolean;
}

const {
  label,
  description,
  helperText = description,
  error,
  isUploading = false,
  disabled = false,
  multiple = false,
  accept,
  name,
  id,
  required = false,
  icon = "cloud-upload",
  maxSizeLabel,
  class: className = "",
  dropzoneClass = "",
  preview = true,
  ...rest
} = Astro.props;

// Generate deterministic ID if none provided
const inputId = id || (name ? `dropzone-${name}` : `dropzone-${Math.random().toString(36).substring(2, 9)}`);
const previewContainerId = `${inputId}-preview`;
---

<div class:list={["w-full space-y-1.5", className]}>
  {label && (
    <div class="flex items-center justify-between">
      <label
        for={inputId}
        class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300"
      >
        {label}
        {required && <span class="text-rose-400 ml-1 font-bold">*</span>}
      </label>
      {maxSizeLabel && (
        <span class="text-[11px] text-slate-500 font-medium">{maxSizeLabel}</span>
      )}
    </div>
  )}

  <div class="relative group">
    <StarwindDropzone
      id={inputId}
      name={name}
      accept={accept}
      multiple={multiple}
      disabled={disabled}
      required={required}
      isUploading={isUploading}
      aria-invalid={Boolean(error) || undefined}
      class:list={[
        "relative flex flex-col items-center justify-center p-6 border-2 border-dashed rounded-xl cursor-pointer transition-all duration-200",
        "bg-slate-50/70 dark:bg-slate-950/40 hover:bg-slate-100 dark:hover:bg-slate-900/60 border-slate-300 dark:border-slate-700/80 hover:border-primary/60",
        "data-[drag-active=true]:border-primary data-[drag-active=true]:bg-primary/10 data-[drag-active=true]:scale-[0.99]",
        "focus-within:ring-2 focus-within:ring-primary/40 focus-within:border-primary",
        error ? "border-rose-500/80 bg-rose-500/5 hover:border-rose-500" : "",
        disabled ? "opacity-50 cursor-not-allowed pointer-events-none" : "",
        dropzoneClass,
      ]}
      {...rest}
    >
      <slot>
        <!-- Upload State -->
        <DropzoneUploadIndicator isUploading={isUploading} class="flex flex-col items-center justify-center text-center py-2">
          <div class="w-12 h-12 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center text-primary mb-3 group-hover:scale-110 group-hover:text-orange-500 transition-all shadow-sm dark:shadow-lg dark:shadow-black/40">
            <i data-lucide={icon} class="w-6 h-6"></i>
          </div>

          <p class="text-sm font-medium text-slate-700 dark:text-slate-200">
            <span class="text-primary hover:underline font-semibold">Click to upload</span> or drag and drop
          </p>

          {helperText && (
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 max-w-xs">{helperText}</p>
          )}
        </DropzoneUploadIndicator>

        <!-- Loading / In-Progress State -->
        <DropzoneLoadingIndicator isUploading={isUploading} class="flex flex-col items-center justify-center text-center py-4">
          <div class="w-10 h-10 rounded-full border-2 border-primary border-t-transparent animate-spin mb-3"></div>
          <p class="text-sm font-medium text-slate-700 dark:text-slate-200">Processing file(s)...</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Please wait while the upload finishes</p>
        </DropzoneLoadingIndicator>

        <!-- Selected Files List -->
        <DropzoneFilesList class="mt-3 text-xs text-slate-600 dark:text-slate-300 [&_div]:bg-white dark:[&_div]:bg-slate-900/80 [&_div]:border [&_div]:border-slate-200 dark:[&_div]:border-slate-800 [&_div]:px-3 [&_div]:py-1.5 [&_div]:rounded-lg [&_div]:shadow-sm" />
      </slot>
    </StarwindDropzone>

    <!-- Optional Instant Client-Side Image Preview (Hidden until image selected) -->
    {preview && (
      <div
        id={previewContainerId}
        class="hidden mt-3 p-3 bg-slate-900/90 border border-slate-800 rounded-xl flex-col gap-3 shadow-md"
        data-preview-wrapper
      >
        <!-- Single File Preview -->
        <div class="hidden items-center justify-between gap-3 w-full" data-preview-single>
          <div class="flex items-center gap-3 min-w-0">
            <img
              src=""
              alt="Upload Preview"
              class="w-12 h-12 rounded-lg object-cover border border-slate-700/80 shrink-0 bg-slate-950"
              data-preview-img
            />
            <div class="min-w-0">
              <p class="text-xs font-semibold text-slate-200 truncate" data-preview-name>
                file-name.png
              </p>
              <p class="text-[11px] text-slate-400 font-mono" data-preview-size>
                0 KB
              </p>
            </div>
          </div>
          <button
            type="button"
            class="p-1.5 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition shrink-0 cursor-pointer"
            title="Remove file"
            data-preview-remove
          >
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- Multi Files Preview -->
        <div class="hidden flex-col gap-2.5 w-full" data-preview-multi>
          <div class="flex items-center justify-between pb-2 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-semibold text-slate-200" data-preview-multi-count>
                0 files selected
              </span>
              <span class="text-[11px] text-slate-400 font-mono" data-preview-multi-size>
                (0 KB)
              </span>
            </div>
            <button
              type="button"
              class="text-xs text-rose-400 hover:text-rose-300 font-semibold px-2 py-1 rounded hover:bg-rose-500/10 transition cursor-pointer"
              data-preview-clear-all
            >
              Clear all
            </button>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 max-h-60 overflow-y-auto" data-preview-multi-grid>
            <!-- Generated dynamically via JS -->
          </div>
        </div>
      </div>
    )}
  </div>

  {error && (
    <p class="text-xs font-medium text-rose-400 flex items-center gap-1.5 mt-1">
      <i data-lucide="alert-circle" class="w-3.5 h-3.5 shrink-0"></i>
      <span>{error}</span>
    </p>
  )}
</div>

{preview && (
  <script is:inline define:vars={{ inputId, previewContainerId }}>
    document.addEventListener("DOMContentLoaded", () => {
      const container = document.getElementById(inputId);
      const previewWrapper = document.getElementById(previewContainerId);
      if (!container || !previewWrapper) return;

      const fileInput = container.matches('input[type="file"]')
        ? container
        : container.querySelector('input[type="file"]');
      if (!fileInput) return;

      const singleContainer = previewWrapper.querySelector("[data-preview-single]");
      const multiContainer = previewWrapper.querySelector("[data-preview-multi]");
      const multiGrid = previewWrapper.querySelector("[data-preview-multi-grid]");
      const multiCount = previewWrapper.querySelector("[data-preview-multi-count]");
      const multiSize = previewWrapper.querySelector("[data-preview-multi-size]");
      const previewImg = previewWrapper.querySelector("[data-preview-img]");
      const previewName = previewWrapper.querySelector("[data-preview-name]");
      const previewSize = previewWrapper.querySelector("[data-preview-size]");
      const removeBtn = previewWrapper.querySelector("[data-preview-remove]");
      const clearAllBtn = previewWrapper.querySelector("[data-preview-clear-all]");

      const formatBytes = (bytes) => {
        if (!bytes || bytes === 0) return "0 Bytes";
        const k = 1024;
        const sizes = ["Bytes", "KB", "MB", "GB"];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
      };

      const handleFiles = (files) => {
        if (!files || files.length === 0) {
          previewWrapper.classList.add("hidden");
          previewWrapper.classList.remove("flex");
          if (multiGrid) multiGrid.innerHTML = "";
          return;
        }

        if (files.length === 1) {
          // Single file preview
          if (multiContainer) {
            multiContainer.classList.add("hidden");
            multiContainer.classList.remove("flex");
          }
          if (singleContainer) {
            singleContainer.classList.remove("hidden");
            singleContainer.classList.add("flex");
          }
          previewWrapper.classList.remove("hidden");
          previewWrapper.classList.add("flex");

          const file = files[0];
          if (file.type.startsWith("image/")) {
            const reader = new FileReader();
            reader.onload = (e) => {
              if (previewImg) previewImg.src = e.target.result;
              if (previewName) previewName.textContent = file.name;
              if (previewSize) previewSize.textContent = formatBytes(file.size);
              if (typeof lucide !== "undefined") lucide.createIcons();
            };
            reader.readAsDataURL(file);
          } else {
            if (previewImg) {
              previewImg.src = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23ff4d1c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z'/><polyline points='14 2 14 8 20 8'/></svg>";
            }
            if (previewName) previewName.textContent = file.name;
            if (previewSize) previewSize.textContent = formatBytes(file.size);
          }
        } else {
          // Multiple files preview
          if (singleContainer) {
            singleContainer.classList.add("hidden");
            singleContainer.classList.remove("flex");
          }
          if (multiContainer) {
            multiContainer.classList.remove("hidden");
            multiContainer.classList.add("flex");
          }
          previewWrapper.classList.remove("hidden");
          previewWrapper.classList.add("flex");

          let totalBytes = 0;
          for (let i = 0; i < files.length; i++) {
            totalBytes += files[i].size;
          }
          if (multiCount) multiCount.textContent = `${files.length} images selected`;
          if (multiSize) multiSize.textContent = `(${formatBytes(totalBytes)})`;

          if (multiGrid) {
            multiGrid.innerHTML = "";
            Array.from(files).forEach((file) => {
              const card = document.createElement("div");
              card.className = "flex items-center gap-2.5 p-2 rounded-lg bg-slate-950/70 border border-slate-800 text-xs min-w-0";

              const img = document.createElement("img");
              img.className = "w-10 h-10 rounded object-cover border border-slate-700/60 bg-slate-900 shrink-0";
              img.alt = file.name;

              if (file.type.startsWith("image/")) {
                const reader = new FileReader();
                reader.onload = (e) => {
                  img.src = e.target.result;
                };
                reader.readAsDataURL(file);
              }

              const info = document.createElement("div");
              info.className = "min-w-0 flex-1";

              const nameEl = document.createElement("p");
              nameEl.className = "font-medium text-slate-200 truncate";
              nameEl.textContent = file.name;

              const sizeEl = document.createElement("p");
              sizeEl.className = "text-[10px] text-slate-400 font-mono";
              sizeEl.textContent = formatBytes(file.size);

              info.appendChild(nameEl);
              info.appendChild(sizeEl);
              card.appendChild(img);
              card.appendChild(info);
              multiGrid.appendChild(card);
            });
          }
        }
      };

      fileInput.addEventListener("change", (e) => {
        handleFiles(e.target.files);
      });

      const clearSelection = () => {
        fileInput.value = "";
        fileInput.dispatchEvent(new Event("change", { bubbles: true }));
        previewWrapper.classList.add("hidden");
        previewWrapper.classList.remove("flex");
        if (multiGrid) multiGrid.innerHTML = "";
      };

      if (removeBtn) removeBtn.addEventListener("click", clearSelection);
      if (clearAllBtn) clearAllBtn.addEventListener("click", clearSelection);
    });
  </script>
)}
