---
import StarwindButton from "../starwind/button/Button.astro";
import type { ComponentProps } from "astro/types";

type StarwindButtonProps = ComponentProps<typeof StarwindButton>;

interface Props extends Omit<StarwindButtonProps, "variant"> {
  variant?: StarwindButtonProps["variant"] | "danger";
  icon?: string;
  iconPosition?: "left" | "right";
  loading?: boolean;
}

const {
  variant = "default",
  icon,
  iconPosition = "left",
  loading = false,
  disabled = false,
  class: className = "",
  ...rest
} = Astro.props;

// Map "danger" alias to Starwind's "error" variant
const resolvedVariant = variant === "danger" ? "error" : variant;
---

<StarwindButton
  variant={resolvedVariant}
  disabled={disabled || loading}
  class={className}
  {...rest}
>
  {loading ? (
    <svg class="animate-spin -ml-0.5 mr-1.5 w-4 h-4 text-current shrink-0" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  ) : (
    icon && iconPosition === "left" && <i data-lucide={icon} class="shrink-0"></i>
  )}

  <slot />

  {!loading && icon && iconPosition === "right" && <i data-lucide={icon} class="shrink-0"></i>}
</StarwindButton>
