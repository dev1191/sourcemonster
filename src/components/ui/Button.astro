---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  variant?: "primary" | "secondary" | "outline" | "ghost" | "danger" | "success" | "white";
  size?: "xs" | "sm" | "md" | "lg";
  href?: string;
  target?: string;
  rel?: string;
  icon?: string;
  iconPosition?: "left" | "right";
  loading?: boolean;
  class?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  target,
  rel,
  icon,
  iconPosition = "left",
  loading = false,
  disabled = false,
  class: className = "",
  type = "button",
  ...rest
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center font-semibold rounded-xl transition-all duration-200 select-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none";

const sizeStyles: Record<string, string> = {
  xs: "px-2.5 py-1 text-xs gap-1.5 [&_i]:w-3 [&_i]:h-3",
  sm: "px-3.5 py-1.5 text-xs gap-1.5 [&_i]:w-3.5 [&_i]:h-3.5",
  md: "px-5 py-2.5 text-sm gap-2 [&_i]:w-4 [&_i]:h-4",
  lg: "px-7 py-3 text-base gap-2.5 [&_i]:w-5 [&_i]:h-5",
};

const variantStyles: Record<string, string> = {
  primary:
    "bg-primary hover:bg-orange-600 text-white shadow-lg shadow-primary/25 hover:shadow-primary/40 focus:ring-primary focus:ring-offset-slate-950",
  secondary:
    "bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700/60 focus:ring-slate-700 focus:ring-offset-slate-950",
  outline:
    "bg-transparent hover:bg-slate-800/60 text-slate-300 hover:text-white border border-slate-700 focus:ring-slate-600 focus:ring-offset-slate-950",
  ghost:
    "bg-transparent hover:bg-slate-800/60 text-slate-400 hover:text-white focus:ring-slate-700 focus:ring-offset-slate-950",
  danger:
    "bg-rose-500/15 hover:bg-rose-500/25 text-rose-400 border border-rose-500/30 hover:border-rose-500/50 focus:ring-rose-500 focus:ring-offset-slate-950",
  success:
    "bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-400 border border-emerald-500/30 hover:border-emerald-500/50 focus:ring-emerald-500 focus:ring-offset-slate-950",
  white:
    "bg-white hover:bg-slate-100 text-slate-950 shadow-md shadow-white/10 focus:ring-white focus:ring-offset-slate-950",
};

const classes = [
  baseStyles,
  sizeStyles[size] || sizeStyles.md,
  variantStyles[variant] || variantStyles.primary,
  className,
]
  .filter(Boolean)
  .join(" ");

const isExternal = href && (href.startsWith("http://") || href.startsWith("https://"));
const resolvedRel = rel || (isExternal ? "noopener noreferrer" : undefined);
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={resolvedRel}
      class={classes}
      {...(rest as any)}
    >
      {loading ? (
        <svg class="animate-spin -ml-1 mr-2 w-4 h-4 text-current" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      ) : (
        icon && iconPosition === "left" && <i data-lucide={icon} class="shrink-0"></i>
      )}
      <slot />
      {!loading && icon && iconPosition === "right" && <i data-lucide={icon} class="shrink-0"></i>}
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled || loading}
      class={classes}
      {...rest}
    >
      {loading ? (
        <svg class="animate-spin -ml-1 mr-2 w-4 h-4 text-current" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      ) : (
        icon && iconPosition === "left" && <i data-lucide={icon} class="shrink-0"></i>
      )}
      <slot />
      {!loading && icon && iconPosition === "right" && <i data-lucide={icon} class="shrink-0"></i>}
    </button>
  )
}
