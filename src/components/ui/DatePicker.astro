---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "size"> {
  id?: string;
  name?: string;
  label?: string;
  value?: string;
  placeholder?: string;
  helperText?: string;
  required?: boolean;
  disabled?: boolean;
  minDate?: string;
  maxDate?: string;
  enableTime?: boolean;
  dateFormat?: string; // Stored/submitted format (default: Y-m-d or Y-m-d H:i)
  displayFormat?: string; // Visual display format (default: M j, Y or M j, Y - h:i K)
  mode?: "single" | "multiple" | "range";
  class?: string;
  containerClass?: string;
  icon?: string;
  clearable?: boolean;
  defaultDate?: string;
}

const {
  id = `datepicker-${Math.random().toString(36).substring(2, 9)}`,
  name,
  label,
  value = "",
  placeholder = "Select date...",
  helperText,
  required = false,
  disabled = false,
  minDate,
  maxDate,
  enableTime = false,
  dateFormat = enableTime ? "Y-m-d H:i" : "Y-m-d",
  displayFormat = enableTime ? "M j, Y - h:i K" : "M j, Y",
  mode = "single",
  class: className = "",
  containerClass = "",
  icon = "calendar",
  clearable = true,
  defaultDate,
  ...restProps
} = Astro.props;

const initialValue = value || defaultDate || "";
---

<div class:list={["w-full starwind-datepicker-root", containerClass]}>
  {label && (
    <div class="flex items-center justify-between mb-1.5">
      <label for={id} class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider flex items-center gap-1">
        <span>{label}</span>
        {required && <span class="text-rose-500">*</span>}
      </label>
      {clearable && (
        <button
          type="button"
          data-clear-target={id}
          class="text-[10px] font-semibold text-slate-400 hover:text-rose-500 transition cursor-pointer hidden"
          title="Clear date"
        >
          Reset Date
        </button>
      )}
    </div>
  )}

  <div class="relative flex items-center">
    <div class="absolute left-3.5 pointer-events-none text-slate-400 dark:text-slate-500 flex items-center justify-center z-10">
      <i data-lucide={icon} class="w-4 h-4"></i>
    </div>

    <input
      id={id}
      name={name}
      type="text"
      value={initialValue}
      placeholder={placeholder}
      required={required}
      disabled={disabled}
      data-flatpickr
      data-enable-time={enableTime ? "true" : "false"}
      data-date-format={dateFormat}
      data-alt-format={displayFormat}
      data-mode={mode}
      data-min-date={minDate || ""}
      data-max-date={maxDate || ""}
      data-default-date={initialValue || ""}
      data-clearable={clearable ? "true" : "false"}
      class:list={[
        "w-full pl-10 pr-9 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700/80 bg-white dark:bg-slate-950/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 text-sm focus:outline-hidden focus:border-primary focus:ring-2 focus:ring-primary/20 transition cursor-pointer shadow-xs",
        className,
      ]}
      {...restProps}
    />

    {clearable && (
      <button
        type="button"
        data-clear-btn={id}
        class="absolute right-3 p-1 rounded-md text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition opacity-0 pointer-events-none z-10 cursor-pointer"
        title="Clear selection"
      >
        <i data-lucide="x" class="w-3.5 h-3.5"></i>
      </button>
    )}
  </div>

  {helperText && (
    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">{helperText}</p>
  )}
</div>

<script>
  import flatpickr from "flatpickr";
  import "flatpickr/dist/flatpickr.min.css";

  function initDatePickers() {
    const inputs = document.querySelectorAll<HTMLInputElement>(
      "input[data-flatpickr]:not([data-fp-initialized])"
    );

    inputs.forEach((input) => {
      input.setAttribute("data-fp-initialized", "true");

      const enableTime = input.dataset.enableTime === "true";
      const dateFormat = input.dataset.dateFormat || (enableTime ? "Y-m-d H:i" : "Y-m-d");
      const altFormat = input.dataset.altFormat || (enableTime ? "M j, Y - h:i K" : "M j, Y");
      const mode = (input.dataset.mode as "single" | "multiple" | "range") || "single";
      const minDate = input.dataset.minDate || undefined;
      const maxDate = input.dataset.maxDate || undefined;
      const defaultDate = input.dataset.defaultDate || undefined;
      const id = input.id;

      const clearBtn = document.querySelector<HTMLElement>(`[data-clear-btn="${id}"]`);
      const clearLabelBtn = document.querySelector<HTMLElement>(`[data-clear-target="${id}"]`);

      const updateClearBtn = (selectedDates: Date[]) => {
        const hasVal = selectedDates.length > 0 || !!input.value;
        if (clearBtn) {
          if (hasVal) {
            clearBtn.classList.remove("opacity-0", "pointer-events-none");
            clearBtn.classList.add("opacity-100");
          } else {
            clearBtn.classList.add("opacity-0", "pointer-events-none");
            clearBtn.classList.remove("opacity-100");
          }
        }
        if (clearLabelBtn) {
          clearLabelBtn.classList.toggle("hidden", !hasVal);
        }
      };

      const fp = flatpickr(input, {
        altInput: true,
        altFormat: altFormat,
        dateFormat: dateFormat,
        enableTime: enableTime,
        mode: mode,
        minDate: minDate,
        maxDate: maxDate,
        defaultDate: defaultDate,
        altInputClass: input.className,
        prevArrow: '<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>',
        nextArrow: '<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>',
        onReady: (selectedDates) => {
          updateClearBtn(selectedDates);
          if (typeof (window as any).lucide !== "undefined") {
            (window as any).lucide.createIcons();
          }
        },
        onChange: (selectedDates) => {
          updateClearBtn(selectedDates);
          input.dispatchEvent(new Event("change", { bubbles: true }));
        },
      });

      const handleClear = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        fp.clear();
        updateClearBtn([]);
        input.dispatchEvent(new Event("change", { bubbles: true }));
      };

      if (clearBtn) {
        clearBtn.addEventListener("click", handleClear);
      }
      if (clearLabelBtn) {
        clearLabelBtn.addEventListener("click", handleClear);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDatePickers);
  } else {
    initDatePickers();
  }
  document.addEventListener("astro:page-load", initDatePickers);
</script>

<style is:global>
  /* Starwind / SourceMonster Flatpickr Global Theme Overrides */
  .flatpickr-calendar {
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 1rem !important;
    box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.12), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
    font-family: inherit !important;
    width: 310px !important;
    padding: 0.5rem !important;
    z-index: 99999 !important;
  }

  .flatpickr-calendar.arrowTop:before,
  .flatpickr-calendar.arrowTop:after {
    border-bottom-color: #ffffff !important;
  }
  .flatpickr-calendar.arrowBottom:before,
  .flatpickr-calendar.arrowBottom:after {
    border-top-color: #ffffff !important;
  }

  .flatpickr-months {
    background: transparent !important;
    padding: 0.25rem 0.5rem 0.5rem !important;
    display: flex !important;
    align-items: center !important;
  }
  .flatpickr-current-month {
    font-size: 0.9375rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    padding-top: 0 !important;
  }
  .flatpickr-current-month .numInputWrapper {
    font-weight: 700 !important;
    color: #0f172a !important;
  }
  .flatpickr-current-month select {
    font-weight: 700 !important;
    color: #0f172a !important;
    border-radius: 0.5rem !important;
    padding: 0.2rem 0.4rem !important;
    background: #f8fafc !important;
    border: 1px solid #e2e8f0 !important;
  }
  .flatpickr-months .flatpickr-prev-month,
  .flatpickr-months .flatpickr-next-month {
    fill: #64748b !important;
    color: #64748b !important;
    padding: 0.4rem !important;
    border-radius: 0.5rem !important;
    transition: all 0.15s ease !important;
  }
  .flatpickr-months .flatpickr-prev-month:hover,
  .flatpickr-months .flatpickr-next-month:hover {
    background: #f1f5f9 !important;
    fill: #0f172a !important;
    color: #0f172a !important;
  }

  .flatpickr-weekdays {
    background: transparent !important;
    margin-bottom: 0.25rem !important;
  }
  span.flatpickr-weekday {
    color: #64748b !important;
    font-weight: 700 !important;
    font-size: 0.725rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
  }

  .flatpickr-days {
    width: 100% !important;
  }
  .dayContainer {
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
  }
  .flatpickr-day {
    border-radius: 0.625rem !important;
    font-size: 0.8125rem !important;
    font-weight: 500 !important;
    color: #1e293b !important;
    height: 38px !important;
    line-height: 38px !important;
    margin: 1px 0 !important;
    border: 1px solid transparent !important;
    transition: all 0.15s ease !important;
  }
  .flatpickr-day:hover,
  .flatpickr-day:focus {
    background: #f1f5f9 !important;
    color: #0f172a !important;
  }
  .flatpickr-day.today {
    border-color: #f97316 !important;
    color: #f97316 !important;
    font-weight: 700 !important;
  }
  .flatpickr-day.today:hover {
    background: rgba(249, 115, 22, 0.1) !important;
  }
  .flatpickr-day.selected,
  .flatpickr-day.startRange,
  .flatpickr-day.endRange {
    background: #f97316 !important;
    border-color: #f97316 !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    box-shadow: 0 4px 10px rgba(249, 115, 22, 0.35) !important;
  }
  .flatpickr-day.prevMonthDay,
  .flatpickr-day.nextMonthDay {
    color: #94a3b8 !important;
  }

  .flatpickr-time {
    border-top: 1px solid #e2e8f0 !important;
    padding: 0.5rem 0 !important;
  }
  .flatpickr-time input {
    font-weight: 600 !important;
    color: #0f172a !important;
    border-radius: 0.375rem !important;
  }
  .flatpickr-time .flatpickr-am-pm {
    font-weight: 700 !important;
    color: #0f172a !important;
  }

  /* Dark mode */
  .dark .flatpickr-calendar,
  html.dark .flatpickr-calendar {
    background: #090d16 !important;
    border-color: rgba(51, 65, 85, 0.8) !important;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 10px 10px -5px rgba(0, 0, 0, 0.4) !important;
  }
  .dark .flatpickr-calendar.arrowTop:before,
  .dark .flatpickr-calendar.arrowTop:after,
  html.dark .flatpickr-calendar.arrowTop:before,
  html.dark .flatpickr-calendar.arrowTop:after {
    border-bottom-color: #090d16 !important;
  }
  .dark .flatpickr-calendar.arrowBottom:before,
  .dark .flatpickr-calendar.arrowBottom:after,
  html.dark .flatpickr-calendar.arrowBottom:before,
  html.dark .flatpickr-calendar.arrowBottom:after {
    border-top-color: #090d16 !important;
  }
  .dark .flatpickr-current-month,
  html.dark .flatpickr-current-month,
  .dark .flatpickr-current-month .numInputWrapper,
  html.dark .flatpickr-current-month .numInputWrapper {
    color: #f8fafc !important;
  }
  .dark .flatpickr-current-month select,
  html.dark .flatpickr-current-month select {
    background: #0f172a !important;
    border-color: #334155 !important;
    color: #f8fafc !important;
  }
  .dark .flatpickr-months .flatpickr-prev-month,
  .dark .flatpickr-months .flatpickr-next-month,
  html.dark .flatpickr-months .flatpickr-prev-month,
  html.dark .flatpickr-months .flatpickr-next-month {
    fill: #94a3b8 !important;
    color: #94a3b8 !important;
  }
  .dark .flatpickr-months .flatpickr-prev-month:hover,
  .dark .flatpickr-months .flatpickr-next-month:hover,
  html.dark .flatpickr-months .flatpickr-prev-month:hover,
  html.dark .flatpickr-months .flatpickr-next-month:hover {
    background: #1e293b !important;
    fill: #ffffff !important;
    color: #ffffff !important;
  }
  .dark span.flatpickr-weekday,
  html.dark span.flatpickr-weekday {
    color: #94a3b8 !important;
  }
  .dark .flatpickr-day,
  html.dark .flatpickr-day {
    color: #e2e8f0 !important;
  }
  .dark .flatpickr-day:hover,
  .dark .flatpickr-day:focus,
  html.dark .flatpickr-day:hover,
  html.dark .flatpickr-day:focus {
    background: #1e293b !important;
    color: #ffffff !important;
  }
  .dark .flatpickr-day.prevMonthDay,
  .dark .flatpickr-day.nextMonthDay,
  html.dark .flatpickr-day.prevMonthDay,
  html.dark .flatpickr-day.nextMonthDay {
    color: #475569 !important;
  }
  .dark .flatpickr-time,
  html.dark .flatpickr-time {
    border-top-color: #1e293b !important;
    background: #090d16 !important;
  }
  .dark .flatpickr-time input,
  html.dark .flatpickr-time input,
  .dark .flatpickr-time .flatpickr-am-pm,
  html.dark .flatpickr-time .flatpickr-am-pm {
    color: #f8fafc !important;
  }
  .dark .flatpickr-time input:hover,
  .dark .flatpickr-time .flatpickr-am-pm:hover,
  html.dark .flatpickr-time input:hover,
  html.dark .flatpickr-time .flatpickr-am-pm:hover {
    background: #1e293b !important;
  }
</style>

