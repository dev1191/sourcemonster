---
import type { HTMLAttributes } from "astro/types";
import { Label as StarwindLabel } from "../starwind/label";

interface Props extends HTMLAttributes<"label"> {
  label?: string;
  required?: boolean;
  optional?: boolean;
  subtext?: string;
  size?: "sm" | "md" | "lg";
  class?: string;
  for?: string;
}

const {
  label,
  required = false,
  optional = false,
  subtext,
  size = "sm",
  class: className = "",
  for: htmlFor,
  ...rest
} = Astro.props;
---

<div class="flex items-center justify-between gap-2 mb-1.5">
  <StarwindLabel
    for={htmlFor}
    size={size}
    class:list={[
      "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider cursor-pointer select-none",
      className,
    ]}
    {...rest}
  >
    {label ? (
      <span class="inline-flex items-center gap-1">
        <span>{label}</span>
        {required && <span class="text-rose-500 font-bold text-xs" title="Required field">*</span>}
      </span>
    ) : (
      <span class="inline-flex items-center gap-1">
        <slot />
        {required && <span class="text-rose-500 font-bold text-xs" title="Required field">*</span>}
      </span>
    )}
  </StarwindLabel>

  {optional && !required && (
    <span class="text-[10px] font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wider">
      Optional
    </span>
  )}

  {subtext && !optional && (
    <span class="text-[11px] font-mono text-slate-400 dark:text-slate-500">
      {subtext}
    </span>
  )}
</div>
