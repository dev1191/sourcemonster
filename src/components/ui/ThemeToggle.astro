---
import StarwindThemeToggle from "../starwind-vue/theme-toggle/ThemeToggle.vue";

interface Props {
  variant?: "outline" | "default";
  size?: "sm" | "md" | "lg";
  class?: string;
  ariaLabel?: string;
}

const {
  variant = "outline",
  size = "sm",
  class: className = "",
  ariaLabel = "Toggle light / dark theme",
} = Astro.props;
---

<StarwindThemeToggle
  client:load
  variant={variant}
  size={size}
  ariaLabel={ariaLabel}
  class={className}
/>
