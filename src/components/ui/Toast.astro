---
interface Props {
  variant?: "success" | "error" | "warning" | "info" | "default";
  title?: string;
  message?: string | null;
  duration?: number;
}

const {
  variant = "info",
  title,
  message,
  duration,
} = Astro.props;

const shouldTrigger = Boolean(message || title);
---

{shouldTrigger && (
  <div
    data-starwind-toast
    data-variant={variant}
    data-title={title || ""}
    data-message={message || ""}
    data-duration={duration ? String(duration) : ""}
    style="display:none;"
    aria-hidden="true"
  />
)}

<script>
  import { toast } from "../starwind/toast";

  declare global {
    interface Window {
      __starwindRuntime__?: {
        toast?: any;
        [key: string]: any;
      };
    }
  }

  const dispatchToast = (el: HTMLElement) => {
    const variant = (el.dataset.variant as "info" | "success" | "warning" | "error" | "default") || "info";
    const title = el.dataset.title || "";
    const message = el.dataset.message || "";
    const durationAttr = el.dataset.duration;
    const duration = durationAttr ? Number(durationAttr) : undefined;

    const toastFn = (typeof (toast as any)[variant] === "function" ? (toast as any)[variant] : toast) as (
      msg: string,
      opts?: Record<string, unknown>
    ) => string;

    try {
      if (title && message) {
        toastFn(title, { description: message, duration });
      } else if (message || title) {
        toastFn(title || message, { duration });
      }
    } catch (err) {
      console.warn("Failed to dispatch toast:", err);
    }
    el.remove();
  };

  const triggerToasts = () => {
    const elements = document.querySelectorAll<HTMLElement>("[data-starwind-toast]");
    if (elements.length === 0) return;

    let attempts = 0;
    const interval = setInterval(() => {
      attempts++;
      const hasManager = Boolean(window.__starwindRuntime__?.toast);

      if (hasManager || attempts > 25) {
        clearInterval(interval);
        elements.forEach(dispatchToast);

        // Clean up status params from browser URL without reloading
        const url = new URL(window.location.href);
        const flashKeys = ["created", "updated", "cl_added", "cl_updated", "cl_deleted", "img_deleted"];
        let modified = false;
        flashKeys.forEach((key) => {
          if (url.searchParams.has(key)) {
            url.searchParams.delete(key);
            modified = true;
          }
        });
        if (modified) {
          window.history.replaceState({}, "", url.pathname + (url.search ? url.search : ""));
        }
      }
    }, 30);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", triggerToasts, { once: true });
  } else {
    triggerToasts();
  }
  document.addEventListener("astro:page-load", triggerToasts);
</script>
