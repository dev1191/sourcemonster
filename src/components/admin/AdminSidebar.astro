---
import logoImg from "../../assets/images/logo.png";
import logo2Img from "../../assets/images/logo-2.png";
import { ConfirmDialog } from "@/components/ui";
import {
  Sidebar,
  SidebarHeader,
  SidebarContent,
  SidebarFooter,
  SidebarGroup,
  SidebarGroupLabel,
  SidebarGroupContent,
  SidebarMenu,
  SidebarMenuItem,
  SidebarMenuButton,
  SidebarMenuSub,
  SidebarMenuSubItem,
  SidebarMenuSubButton,
  SidebarRail,
} from "@/components/starwind/sidebar";

interface Props {
  activeNav?: string;
  user?: {
    id: string;
    email: string;
    name?: string | null;
  } | null;
}

const { activeNav = "dashboard", user } = Astro.props;
const currentPath = Astro.url.pathname;
const isProductActive = activeNav === "products" || activeNav === "addons" || currentPath.startsWith("/admin/products");
---

<Sidebar collapsible="icon" class="border-r border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/95 transition-colors duration-200">
  <!-- Brand Logo Header -->
  <SidebarHeader class="p-4 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center justify-between">
      <a href="/admin" class="flex items-center gap-2" title="Admin Dashboard">
        <img src={logoImg.src} alt="SourceMonster" class="h-8 w-auto object-contain dark:hidden" />
        <img src={logo2Img.src} alt="SourceMonster" class="h-8 w-auto object-contain hidden dark:block" />
      </a>
      <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20 font-mono group-data-[collapsible=icon]:hidden">
        Admin
      </span>
    </div>
  </SidebarHeader>

  <!-- Navigation Content -->
  <SidebarContent class="p-3">
    <SidebarGroup>
      <SidebarGroupLabel class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold px-2 mb-1 group-data-[collapsible=icon]:hidden">
        Management
      </SidebarGroupLabel>
      <SidebarGroupContent>
        <SidebarMenu>
          <!-- Dashboard -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin"
              isActive={activeNav === "dashboard" && currentPath === "/admin"}
            >
              <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0"></i>
              <span>Dashboard</span>
            </SidebarMenuButton>
          </SidebarMenuItem>

          <!-- Products & Add-ons Dropdown Menu -->
          <SidebarMenuItem>
            <details open={isProductActive} class="group/prod w-full">
              <summary
                class={`flex w-full items-center justify-between gap-3 overflow-hidden rounded-md p-2.5 text-left text-sm font-medium transition-all cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden ring-sidebar-outline outline-hidden focus-visible:ring-2 ${
                  isProductActive
                    ? "bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold"
                    : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white"
                }`}
                data-sidebar="menu-button"
                data-active={isProductActive}
              >
                <span class="flex items-center gap-3 min-w-0">
                  <i data-lucide="package" class="w-4 h-4 shrink-0 text-slate-400 group-hover/prod:text-slate-900 dark:group-hover/prod:text-white"></i>
                  <span class="truncate group-data-[collapsible=icon]:hidden">Products</span>
                </span>
                <i
                  data-lucide="chevron-down"
                  class="w-3.5 h-3.5 shrink-0 transition-transform duration-200 group-open/prod:rotate-180 opacity-70 group-data-[collapsible=icon]:hidden"
                ></i>
              </summary>

              <SidebarMenuSub class="mt-1 space-y-1">
                <SidebarMenuSubItem>
                  <SidebarMenuSubButton
                    href="/admin/products"
                    isActive={currentPath === "/admin/products"}
                  >
                    <i data-lucide="list" class="w-3.5 h-3.5 shrink-0"></i>
                    <span>All Products</span>
                  </SidebarMenuSubButton>
                </SidebarMenuSubItem>

                <SidebarMenuSubItem>
                  <SidebarMenuSubButton
                    href="/admin/products/new"
                    isActive={currentPath === "/admin/products/new"}
                  >
                    <i data-lucide="plus-circle" class="w-3.5 h-3.5 shrink-0"></i>
                    <span>Add New Product</span>
                  </SidebarMenuSubButton>
                </SidebarMenuSubItem>

                <SidebarMenuSubItem>
                  <SidebarMenuSubButton
                    href="/admin/products/addons"
                    isActive={currentPath.startsWith("/admin/products/addons") || activeNav === "addons"}
                  >
                    <i data-lucide="puzzle" class="w-3.5 h-3.5 shrink-0"></i>
                    <span>Product Add-ons</span>
                  </SidebarMenuSubButton>
                </SidebarMenuSubItem>
              </SidebarMenuSub>
            </details>
          </SidebarMenuItem>

          <!-- Leads -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin/leads"
              isActive={activeNav === "leads"}
            >
              <i data-lucide="inbox" class="w-4 h-4 shrink-0"></i>
              <span>Leads &amp; Inquiries</span>
            </SidebarMenuButton>
          </SidebarMenuItem>

          <!-- Services -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin/services"
              isActive={activeNav === "services"}
            >
              <i data-lucide="layers" class="w-4 h-4 shrink-0"></i>
              <span>Services</span>
            </SidebarMenuButton>
          </SidebarMenuItem>

          <!-- Testimonials -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin/testimonials"
              isActive={activeNav === "testimonials"}
            >
              <i data-lucide="message-circle" class="w-4 h-4 shrink-0"></i>
              <span>Testimonials</span>
            </SidebarMenuButton>
          </SidebarMenuItem>

          <!-- Site Settings -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin/settings"
              isActive={activeNav === "settings"}
            >
              <i data-lucide="sliders" class="w-4 h-4 shrink-0"></i>
              <span>Site Settings</span>
            </SidebarMenuButton>
          </SidebarMenuItem>
        </SidebarMenu>
      </SidebarGroupContent>
    </SidebarGroup>
  </SidebarContent>

  <!-- Sidebar Footer -->
  <SidebarFooter class="p-3 border-t border-slate-200 dark:border-slate-800/80 space-y-2">
    <a
      href="/"
      target="_blank"
      class="flex items-center justify-between px-3 py-2 text-xs text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/40 transition group-data-[collapsible=icon]:justify-center group-data-[collapsible=icon]:px-1"
      title="View Live Site"
    >
      <span class="flex items-center gap-2 group-data-[collapsible=icon]:hidden">
        <i data-lucide="external-link" class="w-3.5 h-3.5 shrink-0"></i>
        <span>View Live Site</span>
      </span>
      <i data-lucide="external-link" class="w-3.5 h-3.5 shrink-0 hidden group-data-[collapsible=icon]:block"></i>
      <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50 shrink-0 group-data-[collapsible=icon]:hidden"></i>
    </a>

    <div class="p-2.5 bg-slate-50 dark:bg-slate-950/60 rounded-xl border border-slate-200 dark:border-slate-800/60 flex items-center justify-between group-data-[collapsible=icon]:p-1 group-data-[collapsible=icon]:justify-center">
      <div class="overflow-hidden pr-2 group-data-[collapsible=icon]:hidden">
        <div class="text-xs font-semibold text-slate-900 dark:text-white truncate">{user?.name || "Administrator"}</div>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate">{user?.email || "admin@sourcemonster.in"}</div>
      </div>
      <ConfirmDialog
        title="Sign Out"
        description="Are you sure you want to end your administrative session?"
        confirmText="Sign Out"
        confirmVariant="destructive"
        confirmIcon="log-out"
        icon="log-out"
        formAction="/admin/logout"
        formMethod="POST"
      >
        <button
          slot="trigger"
          type="button"
          title="Logout"
          class="p-1.5 text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 rounded-lg transition cursor-pointer"
        >
          <i data-lucide="log-out" class="w-4 h-4 shrink-0"></i>
        </button>
      </ConfirmDialog>
    </div>
  </SidebarFooter>

  <SidebarRail />
</Sidebar>
