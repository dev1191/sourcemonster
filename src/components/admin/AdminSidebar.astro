---
import { Image } from "astro:assets";
import logo2Img from "../../assets/images/logo-2.png";
import {
  Sidebar,
  SidebarHeader,
  SidebarContent,
  SidebarFooter,
  SidebarGroup,
  SidebarGroupLabel,
  SidebarGroupContent,
  SidebarMenu,
  SidebarMenuItem,
  SidebarMenuButton,
  SidebarMenuSub,
  SidebarMenuSubItem,
  SidebarMenuSubButton,
  SidebarRail,
} from "@/components/starwind/sidebar";

interface Props {
  activeNav?: string;
  user?: {
    id: string;
    email: string;
    name?: string | null;
  } | null;
}

const { activeNav = "dashboard", user } = Astro.props;
const currentPath = Astro.url.pathname;
const isProductActive = activeNav === "products" || activeNav === "addons" || currentPath.startsWith("/admin/products");
---

<Sidebar collapsible="icon" class="border-r border-slate-800/80 bg-slate-900/95 backdrop-blur-md">
  <!-- Brand Logo Header -->
  <SidebarHeader class="p-4 border-b border-slate-800">
    <div class="flex items-center justify-between">
      <a href="/admin" class="flex items-center gap-2" title="Admin Dashboard">
        <Image src={logo2Img} alt="SourceMonster" class="h-8 w-auto object-contain" />
      </a>
      <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20 font-mono group-data-[collapsible=icon]:hidden">
        Admin
      </span>
    </div>
  </SidebarHeader>

  <!-- Navigation Content -->
  <SidebarContent class="p-3">
    <SidebarGroup>
      <SidebarGroupLabel class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold px-2 mb-1 group-data-[collapsible=icon]:hidden">
        Management
      </SidebarGroupLabel>
      <SidebarGroupContent>
        <SidebarMenu>
          <!-- Dashboard -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin"
              isActive={activeNav === "dashboard" && currentPath === "/admin"}
              tooltip="Dashboard"
            >
              <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0"></i>
              <span>Dashboard</span>
            </SidebarMenuButton>
          </SidebarMenuItem>

          <!-- Products & Add-ons Dropdown Menu -->
          <SidebarMenuItem>
            <details open={isProductActive} class="group/prod w-full">
              <summary class="list-none cursor-pointer outline-hidden focus-visible:ring-2 focus-visible:ring-sidebar-outline rounded-md">
                <SidebarMenuButton
                  asChild={true}
                  isActive={isProductActive}
                  tooltip="Products & Modules"
                  class="w-full justify-between"
                >
                  <div class="flex items-center gap-2 overflow-hidden">
                    <i data-lucide="package" class="w-4 h-4 shrink-0"></i>
                    <span>Products</span>
                  </div>
                  <i data-lucide="chevron-down" class="w-3.5 h-3.5 shrink-0 transition-transform duration-200 group-open/prod:rotate-180 opacity-70 group-data-[collapsible=icon]:hidden"></i>
                </SidebarMenuButton>
              </summary>

              <SidebarMenuSub class="mt-1 space-y-1">
                <SidebarMenuSubItem>
                  <SidebarMenuSubButton
                    href="/admin/products"
                    isActive={currentPath === "/admin/products"}
                  >
                    <i data-lucide="list" class="w-3.5 h-3.5 shrink-0"></i>
                    <span>All Products</span>
                  </SidebarMenuSubButton>
                </SidebarMenuSubItem>

                <SidebarMenuSubItem>
                  <SidebarMenuSubButton
                    href="/admin/products/new"
                    isActive={currentPath === "/admin/products/new"}
                  >
                    <i data-lucide="plus-circle" class="w-3.5 h-3.5 shrink-0"></i>
                    <span>Add New Product</span>
                  </SidebarMenuSubButton>
                </SidebarMenuSubItem>

                <SidebarMenuSubItem>
                  <SidebarMenuSubButton
                    href="/admin/products/addons"
                    isActive={currentPath.startsWith("/admin/products/addons") || activeNav === "addons"}
                  >
                    <i data-lucide="puzzle" class="w-3.5 h-3.5 shrink-0"></i>
                    <span>Product Add-ons</span>
                  </SidebarMenuSubButton>
                </SidebarMenuSubItem>
              </SidebarMenuSub>
            </details>
          </SidebarMenuItem>

          <!-- Leads -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin/leads"
              isActive={activeNav === "leads"}
              tooltip="Leads & Inquiries"
            >
              <i data-lucide="inbox" class="w-4 h-4 shrink-0"></i>
              <span>Leads &amp; Inquiries</span>
            </SidebarMenuButton>
          </SidebarMenuItem>

          <!-- Services -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin/services"
              isActive={activeNav === "services"}
              tooltip="Services"
            >
              <i data-lucide="layers" class="w-4 h-4 shrink-0"></i>
              <span>Services</span>
            </SidebarMenuButton>
          </SidebarMenuItem>

          <!-- Testimonials -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin/testimonials"
              isActive={activeNav === "testimonials"}
              tooltip="Testimonials"
            >
              <i data-lucide="message-circle" class="w-4 h-4 shrink-0"></i>
              <span>Testimonials</span>
            </SidebarMenuButton>
          </SidebarMenuItem>

          <!-- Site Settings -->
          <SidebarMenuItem>
            <SidebarMenuButton
              href="/admin/settings"
              isActive={activeNav === "settings"}
              tooltip="Site Settings"
            >
              <i data-lucide="sliders" class="w-4 h-4 shrink-0"></i>
              <span>Site Settings</span>
            </SidebarMenuButton>
          </SidebarMenuItem>
        </SidebarMenu>
      </SidebarGroupContent>
    </SidebarGroup>
  </SidebarContent>

  <!-- Sidebar Footer -->
  <SidebarFooter class="p-3 border-t border-slate-800/80 space-y-2">
    <a
      href="/"
      target="_blank"
      class="flex items-center justify-between px-3 py-2 text-xs text-slate-400 hover:text-white rounded-lg hover:bg-slate-800/40 transition group-data-[collapsible=icon]:justify-center group-data-[collapsible=icon]:px-1"
      title="View Live Site"
    >
      <span class="flex items-center gap-2 group-data-[collapsible=icon]:hidden">
        <i data-lucide="external-link" class="w-3.5 h-3.5 shrink-0"></i>
        <span>View Live Site</span>
      </span>
      <i data-lucide="external-link" class="w-3.5 h-3.5 shrink-0 hidden group-data-[collapsible=icon]:block"></i>
      <i data-lucide="chevron-right" class="w-3.5 h-3.5 opacity-50 shrink-0 group-data-[collapsible=icon]:hidden"></i>
    </a>

    <div class="p-2.5 bg-slate-950/60 rounded-xl border border-slate-800/60 flex items-center justify-between group-data-[collapsible=icon]:p-1 group-data-[collapsible=icon]:justify-center">
      <div class="overflow-hidden pr-2 group-data-[collapsible=icon]:hidden">
        <div class="text-xs font-semibold text-white truncate">{user?.name || "Administrator"}</div>
        <div class="text-[11px] text-slate-400 truncate">{user?.email || "admin@sourcemonster.in"}</div>
      </div>
      <form method="POST" action="/admin/logout">
        <button
          type="submit"
          title="Logout"
          class="p-1.5 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition"
        >
          <i data-lucide="log-out" class="w-4 h-4 shrink-0"></i>
        </button>
      </form>
    </div>
  </SidebarFooter>

  <SidebarRail />
</Sidebar>
