---

---

<!-- About Section (Lume Agency Inspired) -->
<section id="about" class="py-20 sm:py-32 bg-slate-50 dark:bg-[#070913] relative overflow-hidden transition-colors">
  <!-- Subtle ambient glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <!-- Header Block -->
    <div class="max-w-3xl mb-14 sm:mb-20" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.1] text-xs font-mono uppercase tracking-widest text-primary font-bold mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        <span>About SourceMonster</span>
      </div>

      <h2 class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-black font-heading tracking-tight text-slate-900 dark:text-white leading-[1.12] mb-6">
        Your Partner in Building the Next Generation of Apps and Software.
      </h2>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
        From first launch to long-term growth, we've got you covered. We combine surgical software engineering, refined product design, and commercial production readiness to give founders a decisive edge.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-xs sm:text-sm bg-primary hover:bg-orange-600 text-white shadow-md shadow-primary/25 hover:shadow-primary/40 transition-all hover:-translate-y-0.5"
        >
          <span>Work With Us</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
        <a
          href="#services"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-xs sm:text-sm bg-white dark:bg-white/[0.05] hover:bg-slate-100 dark:hover:bg-white/[0.1] text-slate-900 dark:text-white border border-slate-200 dark:border-white/10 transition-all"
        >
          <span>Explore Capabilities</span>
        </a>
      </div>
    </div>

    <!-- 3-Column Bento Cards Grid (Lume Agency Pattern) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <!-- Card 1 -->
      <div
        class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 transition-all duration-300 flex flex-col justify-between group shadow-sm hover:shadow-xl hover:-translate-y-1"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div>
          <!-- Icon Bubble -->
          <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <i data-lucide="layers" class="w-7 h-7"></i>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold font-heading text-slate-900 dark:text-white mb-4 tracking-tight">
            Design + Development, Together
          </h3>

          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            No handoffs, no silos. Our designers, frontend architects, and systems engineers collaborate side by side to ensure pixel-perfect fidelity and peak runtime performance.
          </p>
        </div>

        <div class="pt-8 mt-8 border-t border-slate-100 dark:border-white/[0.06] flex items-center justify-between text-xs font-mono text-slate-400">
          <span>PILLAR 01</span>
          <i data-lucide="check-circle" class="w-4 h-4 text-primary"></i>
        </div>
      </div>

      <!-- Card 2 -->
      <div
        class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 transition-all duration-300 flex flex-col justify-between group shadow-sm hover:shadow-xl hover:-translate-y-1"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div>
          <!-- Icon Bubble -->
          <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <i data-lucide="rocket" class="w-7 h-7"></i>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold font-heading text-slate-900 dark:text-white mb-4 tracking-tight">
            From Idea to Launch
          </h3>

          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            Whether it's an initial MVP, a battle-tested commercial boilerplate, or an enterprise multi-tenant platform, we support your entire product lifecycle from prototype to global scale.
          </p>
        </div>

        <div class="pt-8 mt-8 border-t border-slate-100 dark:border-white/[0.06] flex items-center justify-between text-xs font-mono text-slate-400">
          <span>PILLAR 02</span>
          <i data-lucide="check-circle" class="w-4 h-4 text-indigo-400"></i>
        </div>
      </div>

      <!-- Card 3 -->
      <div
        class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 transition-all duration-300 flex flex-col justify-between group shadow-sm hover:shadow-xl hover:-translate-y-1"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div>
          <!-- Icon Bubble -->
          <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <i data-lucide="handshake" class="w-7 h-7"></i>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold font-heading text-slate-900 dark:text-white mb-4 tracking-tight">
            Partners, Not Vendors
          </h3>

          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            We act like your dedicated in-house technical collective — agile, transparent, communicative, and deeply invested in the commercial triumph of your software.
          </p>
        </div>

        <div class="pt-8 mt-8 border-t border-slate-100 dark:border-white/[0.06] flex items-center justify-between text-xs font-mono text-slate-400">
          <span>PILLAR 03</span>
          <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i>
        </div>
      </div>
    </div>
  </div>
</section>
