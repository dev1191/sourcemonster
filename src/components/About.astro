---
---
<!-- About Section -->
<section id="about" class="py-20 sm:py-32 bg-white dark:bg-slate-900/90 relative overflow-hidden transition-colors">
    <!-- Ambient Blur -->
    <div class="absolute top-1/2 -left-20 w-80 h-80 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <!-- Visual Media with Floating Badge -->
            <div class="relative order-2 lg:order-1" data-aos="fade-right">
                <div class="relative rounded-3xl sm:rounded-[3rem] overflow-hidden border border-slate-200 dark:border-slate-800 shadow-2xl bg-slate-100 dark:bg-slate-950">
                    <img
                        src="/assets/images/resource/about.png"
                        alt="Source Monster Team"
                        class="w-full h-auto object-cover transition-transform duration-700 hover:scale-105"
                    />
                </div>

                <!-- Responsive Floating Satisfaction Badge -->
                <div class="absolute bottom-4 right-4 sm:-bottom-6 sm:-right-6 glass-card dark:bg-slate-900/95 dark:border-slate-800 p-5 sm:p-7 rounded-2xl sm:rounded-3xl shadow-2xl border border-white/40">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                            <i data-lucide="award" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-heading">100%</div>
                            <div class="text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-widest font-mono font-bold">
                                Client Satisfaction
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            <div class="order-1 lg:order-2" data-aos="fade-left">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-mono font-bold tracking-widest uppercase mb-4">
                    <span class="w-2 h-2 rounded-full bg-primary"></span>
                    <span>Our DNA &amp; Philosophy</span>
                </div>

                <h2 class="text-3xl xs:text-4xl sm:text-5xl font-black font-heading leading-tight tracking-tight mb-6 sm:mb-8 text-slate-900 dark:text-white">
                    ENGINEERING SUCCESS <br class="hidden sm:inline" />
                    <span class="text-gradient">THROUGH EXPERTISE.</span>
                </h2>

                <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
                    SourceMonster operates as a specialized digital task force. We bypass bloated corporate overhead to deploy surgical engineering teams that design, construct, and scale high-concurrency systems on tight deadlines.
                </p>

                <!-- Key Pillars Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-10">
                    <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80">
                        <div class="w-10 sm:w-12 h-10 sm:h-12 bg-secondary/10 dark:bg-secondary/20 rounded-xl flex items-center justify-center text-secondary dark:text-blue-400 shrink-0">
                            <i data-lucide="target" class="w-5 sm:w-6 h-5 sm:h-6"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-900 dark:text-white text-base">Alpha Mission</h4>
                            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                                Empowering brands with high-velocity product execution.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80">
                        <div class="w-10 sm:w-12 h-10 sm:h-12 bg-primary/10 dark:bg-primary/20 rounded-xl flex items-center justify-center text-primary dark:text-orange-400 shrink-0">
                            <i data-lucide="shield-check" class="w-5 sm:w-6 h-5 sm:h-6"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-900 dark:text-white text-base">Full Ownership</h4>
                            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                                100% intellectual property &amp; source code handover.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                    <a
                        href="#contact"
                        class="inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white dark:bg-primary dark:hover:bg-orange-600 px-8 py-4 rounded-2xl font-bold text-sm sm:text-base shadow-xl transition-all"
                    >
                        <span>Start A Conversation</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                    <a
                        href="#services"
                        class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl font-bold text-sm sm:text-base text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                    >
                        <span>Explore Capabilities</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
	.text-gradient {
		background: linear-gradient(135deg, #FF4D1C 0%, #FF8E6E 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
    }
    :global(.dark) .glass-card {
        background: rgba(15, 23, 42, 0.9);
    }
</style>
