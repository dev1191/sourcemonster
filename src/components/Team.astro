---
import { getCollection } from 'astro:content';

const rawMembers = await getCollection('team');

// Map department/discipline for interactive filtering
const getDepartment = (role: string) => {
  const r = role.toLowerCase();
  if (r.includes('architect') || r.includes('backend') || r.includes('full stack') || r.includes('dev')) {
    return 'engineering';
  }
  if (r.includes('design') || r.includes('ui') || r.includes('ux')) {
    return 'design';
  }
  return 'strategy';
};

const teamMembers = rawMembers.map((m) => ({
  ...m,
  department: getDepartment(m.data.role),
}));

const departments = [
  { id: 'all', label: 'All Makers', count: teamMembers.length },
  { id: 'engineering', label: 'Engineering & Systems', count: teamMembers.filter(m => m.department === 'engineering').length },
  { id: 'design', label: 'Product & Design', count: teamMembers.filter(m => m.department === 'design').length },
  { id: 'strategy', label: 'Strategy & Growth', count: teamMembers.filter(m => m.department === 'strategy').length },
];
---

<!-- Team Section (Lume Agency Inspired & Refined UX) -->
<section id="team" class="py-20 sm:py-32 bg-slate-50 dark:bg-[#070913] relative overflow-hidden transition-colors border-t border-slate-200/80 dark:border-white/[0.08]">
  <!-- Subtle ambient glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-gradient-to-b from-primary/10 via-indigo-500/5 to-transparent rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <!-- Header Block -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-12 sm:mb-16 gap-6" data-aos="fade-up">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.1] text-xs font-mono uppercase tracking-widest text-primary font-bold mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
          <span>The Team</span>
        </div>

        <h2 class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-black font-heading tracking-tight text-slate-900 dark:text-white leading-[1.1]">
          The Makers Behind the Magic.
        </h2>

        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
          We're a tight-knit team of software architects, engineers, and product designers building next-generation digital products — one idea at a time.
        </p>
      </div>

      <!-- Header CTAs (Lume Agency Pattern) -->
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-xs sm:text-sm bg-primary hover:bg-orange-600 text-white shadow-md shadow-primary/25 hover:shadow-primary/40 transition-all hover:-translate-y-0.5"
        >
          <span>Start Your Project</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
        <a
          href="https://wa.me/918607248802?text=Hello%20SourceMonster,%20I%20would%20like%20to%20talk%20to%20your%20team."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full font-semibold text-xs sm:text-sm bg-white dark:bg-white/[0.05] hover:bg-slate-100 dark:hover:bg-white/[0.1] text-slate-900 dark:text-white border border-slate-200 dark:border-white/10 transition-all"
        >
          <i data-lucide="message-circle" class="w-4 h-4 text-emerald-500"></i>
          <span>Say Hello</span>
        </a>
      </div>
    </div>

    <!-- Interactive Department Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 mb-10" id="team-filter-bar" data-aos="fade-up">
      {departments.map((dept, idx) => (
        <button
          type="button"
          data-filter={dept.id}
          class={`team-filter-btn px-4 py-2 rounded-full text-xs font-semibold tracking-wide transition-all cursor-pointer flex items-center gap-2 ${
            idx === 0
              ? 'bg-primary text-white shadow-md shadow-primary/25'
              : 'bg-white dark:bg-white/[0.03] text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-white/[0.08] hover:border-slate-300 dark:hover:border-white/20'
          }`}
        >
          <span>{dept.label}</span>
          <span class={`text-[10px] font-mono px-1.5 py-0.2 rounded-full ${
            idx === 0 ? 'bg-white/20 text-white' : 'bg-slate-100 dark:bg-white/10 text-slate-500 dark:text-slate-400'
          }`}>
            {dept.count}
          </span>
        </button>
      ))}
    </div>

    <!-- Team Bento Grid (3x3 on Desktop, 2 cols on Mobile) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8" id="team-grid">
      {teamMembers.map((member, idx) => (
        <div
          class="team-card group relative rounded-3xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/50 dark:hover:border-primary/50 transition-all duration-300 overflow-hidden shadow-sm hover:shadow-2xl hover:-translate-y-1.5 flex flex-col justify-between"
          data-department={member.department}
          data-aos="fade-up"
          data-aos-delay={(idx % 3) * 100}
        >
          <!-- Portrait Media Container -->
          <div class="relative w-full aspect-[4/4.2] sm:aspect-[4/4.5] overflow-hidden bg-slate-100 dark:bg-white/[0.03]">
            <img
              src={`/assets/images/resource/${member.data.img}`}
              class="w-full h-full object-cover object-top grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500"
              alt={member.data.name}
              loading="lazy"
            />

            <!-- Subtle Gradient Mask over Bottom of Photo -->
            <div class="absolute inset-0 bg-gradient-to-t from-white via-white/20 to-transparent dark:from-[#0a0d18] dark:via-transparent dark:to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>

            <!-- Top Corner Status Badge -->
            <div class="absolute top-3 left-3 sm:top-4 sm:left-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/90 dark:bg-[#070913]/90 backdrop-blur-md border border-slate-200 dark:border-white/10 text-[10px] sm:text-[11px] font-mono text-slate-700 dark:text-slate-300 shadow-xs font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Active</span>
              </span>
            </div>
          </div>

          <!-- Member Details Container -->
          <div class="p-4 sm:p-6 bg-white dark:bg-[#0a0d18] border-t border-slate-100 dark:border-white/[0.06] flex items-center justify-between">
            <div>
              <h3 class="text-base sm:text-xl font-bold font-heading text-slate-900 dark:text-white group-hover:text-primary transition-colors tracking-tight">
                {member.data.name}
              </h3>
              <p class="text-xs sm:text-sm font-medium text-slate-500 dark:text-slate-400 mt-0.5">
                {member.data.role}
              </p>
            </div>

            <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-white/[0.05] text-slate-400 group-hover:bg-primary group-hover:text-white flex items-center justify-center transition-all duration-300 shrink-0">
              <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom "Join the Collective" Banner -->
    <div
      class="mt-14 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-primary/10 via-indigo-500/5 to-transparent border border-primary/20 flex flex-col sm:flex-row items-center justify-between gap-6"
      data-aos="fade-up"
    >
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
          <i data-lucide="sparkles" class="w-6 h-6"></i>
        </div>
        <div>
          <h4 class="text-base sm:text-lg font-bold font-heading text-slate-900 dark:text-white">
            Want to build with us?
          </h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
            We're always looking for exceptional software architects, mobile engineers, and product designers.
          </p>
        </div>
      </div>

      <a
        href="mailto:contact@sourcemonster.in?subject=Joining%20the%20SourceMonster%20Collective"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-xs sm:text-sm bg-white dark:bg-white/[0.08] hover:bg-slate-100 dark:hover:bg-white/[0.15] text-slate-900 dark:text-white border border-slate-200 dark:border-white/10 transition-all shrink-0 hover:scale-105 active:scale-95"
      >
        <span>Get in Touch</span>
        <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.team-filter-btn');
    const teamCards = document.querySelectorAll('.team-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active tab styling
        filterButtons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-white', 'shadow-md', 'shadow-primary/25');
          b.classList.add('bg-white', 'dark:bg-white/[0.03]', 'text-slate-600', 'dark:text-slate-400');
          const countBadge = b.querySelector('span:last-child');
          if (countBadge) {
            countBadge.classList.remove('bg-white/20', 'text-white');
            countBadge.classList.add('bg-slate-100', 'dark:bg-white/10', 'text-slate-500', 'dark:text-slate-400');
          }
        });

        btn.classList.add('bg-primary', 'text-white', 'shadow-md', 'shadow-primary/25');
        btn.classList.remove('bg-white', 'dark:bg-white/[0.03]', 'text-slate-600', 'dark:text-slate-400');
        const activeBadge = btn.querySelector('span:last-child');
        if (activeBadge) {
          activeBadge.classList.remove('bg-slate-100', 'dark:bg-white/10', 'text-slate-500', 'dark:text-slate-400');
          activeBadge.classList.add('bg-white/20', 'text-white');
        }

        // Filter cards with smooth fade
        teamCards.forEach((card) => {
          const dept = card.getAttribute('data-department');
          if (filter === 'all' || dept === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
