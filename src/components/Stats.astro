---

---

<!-- Stats Section (Lume Agency Inspired) -->
<section class="py-16 sm:py-20 relative overflow-hidden bg-slate-100/50 dark:bg-[#070913] text-slate-900 dark:text-white border-y border-slate-200/80 dark:border-white/[0.08]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <!-- Stat 1 -->
      <div
        class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 transition-all duration-300 flex flex-col items-center sm:items-start text-center sm:text-left shadow-xs"
        data-aos="fade-up"
        data-aos-delay="0"
      >
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mb-2 tracking-tight font-heading">
          40<span class="text-primary">+</span>
        </div>
        <div class="text-xs uppercase tracking-widest font-mono font-bold text-slate-500 dark:text-slate-400">
          Global Partners
        </div>
        <p class="text-[11px] text-slate-400 font-mono mt-1 hidden sm:block">
          Across 8+ countries
        </p>
      </div>

      <!-- Stat 2 -->
      <div
        class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 transition-all duration-300 flex flex-col items-center sm:items-start text-center sm:text-left shadow-xs"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mb-2 tracking-tight font-heading">
          110<span class="text-indigo-400">+</span>
        </div>
        <div class="text-xs uppercase tracking-widest font-mono font-bold text-slate-500 dark:text-slate-400">
          Products Deployed
        </div>
        <p class="text-[11px] text-slate-400 font-mono mt-1 hidden sm:block">
          Production web &amp; mobile apps
        </p>
      </div>

      <!-- Stat 3 -->
      <div
        class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 transition-all duration-300 flex flex-col items-center sm:items-start text-center sm:text-left shadow-xs"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mb-2 tracking-tight font-heading">
          12<span class="text-emerald-400">+</span>
        </div>
        <div class="text-xs uppercase tracking-widest font-mono font-bold text-slate-500 dark:text-slate-400">
          Core Architects
        </div>
        <p class="text-[11px] text-slate-400 font-mono mt-1 hidden sm:block">
          Full-stack &amp; DevOps specialists
        </p>
      </div>

      <!-- Stat 4 -->
      <div
        class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 transition-all duration-300 flex flex-col items-center sm:items-start text-center sm:text-left shadow-xs"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mb-2 tracking-tight font-heading">
          99.9<span class="text-amber-400">%</span>
        </div>
        <div class="text-xs uppercase tracking-widest font-mono font-bold text-slate-500 dark:text-slate-400">
          Quality Score
        </div>
        <p class="text-[11px] text-slate-400 font-mono mt-1 hidden sm:block">
          Zero-defect delivery rate
        </p>
      </div>
    </div>
  </div>
</section>
