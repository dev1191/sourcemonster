---
---
<!-- Modern Stats Banner -->
<section class="py-16 sm:py-20 relative overflow-hidden bg-slate-900 text-white border-y border-slate-800">
    <!-- Ambient backlights -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-secondary/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
            <!-- Stat 1 -->
            <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/60 border border-slate-800/80 backdrop-blur-xl flex flex-col items-center sm:items-start text-center sm:text-left transition-all duration-300 hover:border-primary/40 hover:-translate-y-1 group" data-aos="fade-up" data-aos-delay="0">
                <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i data-lucide="handshake" class="w-6 h-6"></i>
                </div>
                <div class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mb-2 tracking-tight font-heading">
                    40<span class="text-primary">+</span>
                </div>
                <div class="text-slate-400 uppercase tracking-widest text-xs font-mono font-bold">
                    Elite Partners
                </div>
                <p class="text-[11px] text-slate-500 font-mono mt-1 hidden sm:block">Across 8+ international territories</p>
            </div>

            <!-- Stat 2 -->
            <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/60 border border-slate-800/80 backdrop-blur-xl flex flex-col items-center sm:items-start text-center sm:text-left transition-all duration-300 hover:border-primary/40 hover:-translate-y-1 group" data-aos="fade-up" data-aos-delay="100">
                <div class="w-12 h-12 rounded-2xl bg-secondary/20 text-blue-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i data-lucide="rocket" class="w-6 h-6"></i>
                </div>
                <div class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mb-2 tracking-tight font-heading">
                    110<span class="text-blue-400">+</span>
                </div>
                <div class="text-slate-400 uppercase tracking-widest text-xs font-mono font-bold">
                    Digital Hunts
                </div>
                <p class="text-[11px] text-slate-500 font-mono mt-1 hidden sm:block">Production products &amp; systems</p>
            </div>

            <!-- Stat 3 -->
            <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/60 border border-slate-800/80 backdrop-blur-xl flex flex-col items-center sm:items-start text-center sm:text-left transition-all duration-300 hover:border-primary/40 hover:-translate-y-1 group" data-aos="fade-up" data-aos-delay="200">
                <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i data-lucide="users" class="w-6 h-6"></i>
                </div>
                <div class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mb-2 tracking-tight font-heading">
                    12<span class="text-emerald-400">+</span>
                </div>
                <div class="text-slate-400 uppercase tracking-widest text-xs font-mono font-bold">
                    Master Minds
                </div>
                <p class="text-[11px] text-slate-500 font-mono mt-1 hidden sm:block">Full-stack &amp; DevOps specialists</p>
            </div>

            <!-- Stat 4 -->
            <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/60 border border-slate-800/80 backdrop-blur-xl flex flex-col items-center sm:items-start text-center sm:text-left transition-all duration-300 hover:border-primary/40 hover:-translate-y-1 group" data-aos="fade-up" data-aos-delay="300">
                <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i data-lucide="activity" class="w-6 h-6"></i>
                </div>
                <div class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mb-2 tracking-tight font-heading">
                    99.9<span class="text-amber-400">%</span>
                </div>
                <div class="text-slate-400 uppercase tracking-widest text-xs font-mono font-bold">
                    Quality Score
                </div>
                <p class="text-[11px] text-slate-500 font-mono mt-1 hidden sm:block">Zero-defect delivery rate</p>
            </div>
        </div>
    </div>
</section>
