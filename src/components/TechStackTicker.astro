---
const categories = [
  {
    name: "Frontend & Reactive UI",
    items: [
      { name: "Vue.js", icon: "layers" },
      { name: "Livewire", icon: "activity" },
      { name: "Flutter", icon: "smartphone" },
      { name: "Tailwind CSS", icon: "palette" },
      { name: "TypeScript", icon: "file-code" },
      { name: "Astro", icon: "rocket" },
    ],
  },
  {
    name: "Backend & Databases",
    items: [
      { name: "Laravel", icon: "box" },
      { name: "Node.js", icon: "server" },
      { name: "MySQL", icon: "hard-drive" },
      { name: "PostgreSQL", icon: "database" },
      { name: "Redis Cache", icon: "zap" },
      { name: "GraphQL & REST", icon: "network" },
    ],
  },
  {
    name: "DevOps & Cloud",
    items: [
      { name: "Docker", icon: "container" },
      { name: "AWS Cloud", icon: "cloud" },
      { name: "CI/CD Pipelines", icon: "git-merge" },
      { name: "Linux VPS", icon: "terminal" },
      { name: "Cloudflare", icon: "shield" },
    ],
  },
  {
    name: "AI & Intelligence",
    items: [
      { name: "OpenAI API", icon: "sparkles" },
      { name: "LangChain", icon: "cpu" },
      { name: "Vector Embeddings", icon: "binary" },
      { name: "Custom LLMs", icon: "bot" },
      { name: "Intelligent Automation", icon: "workflow" },
    ],
  },
];
---

<!-- Tech Stack Section (Lume Agency Inspired) -->
<section
  class="py-16 sm:py-24 border-y border-slate-200 dark:border-white/[0.08] bg-slate-100/50 dark:bg-[#070913] relative overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <!-- Header -->
    <div
      class="text-center max-w-2xl mx-auto mb-12 sm:mb-16"
      data-aos="fade-up"
    >
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.1] text-xs font-mono uppercase tracking-widest text-primary font-bold mb-4"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        <span>Technologies</span>
      </div>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-black font-heading tracking-tight text-slate-900 dark:text-white mb-4"
      >
        The Stack That Adapts to Your Product
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Every layer is optimized for speed, stability, and scale — from
        front-end design to AI-driven backend services.
      </p>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
      {
        categories.map((cat, idx) => (
          <div
            class="p-6 rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.07] hover:border-primary/40 dark:hover:border-primary/40 transition-all duration-300 flex flex-col justify-between group shadow-sm hover:shadow-md"
            data-aos="fade-up"
            data-aos-delay={idx * 100}
          >
            <div>
              <div class="text-xs font-mono uppercase tracking-wider font-semibold text-primary mb-4 pb-3 border-b border-slate-100 dark:border-white/[0.06] flex items-center justify-between">
                <span>{cat.name}</span>
                <span class="text-[10px] text-slate-400 font-mono">
                  0{idx + 1}
                </span>
              </div>

              <div class="space-y-2.5">
                {cat.items.map((item) => (
                  <div class="flex items-center gap-3 p-2 rounded-xl group-hover:bg-slate-50 dark:group-hover:bg-white/[0.03] transition-colors">
                    <div class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-white/[0.05] text-slate-700 dark:text-slate-300 flex items-center justify-center group-hover:text-primary transition-colors">
                      <i data-lucide={item.icon} class="w-3.5 h-3.5" />
                    </div>
                    <span class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200">
                      {item.name}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
