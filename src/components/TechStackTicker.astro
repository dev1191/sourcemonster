---
const technologies = [
  { name: "Astro 5", icon: "rocket", category: "Core Framework" },
  { name: "TypeScript", icon: "file-code-2", category: "Type Safe" },
  { name: "Next.js", icon: "layers", category: "Fullstack" },
  { name: "Tailwind CSS", icon: "palette", category: "Modern UI" },
  { name: "PostgreSQL", icon: "database", category: "Data Layer" },
  { name: "Docker", icon: "container", category: "DevOps" },
  { name: "Flutter", icon: "smartphone", category: "Mobile Apps" },
  { name: "AWS Cloud", icon: "cloud", category: "Infrastructure" },
  { name: "Node.js", icon: "server", category: "Backend Runtime" },
  { name: "Redis", icon: "zap", category: "In-Memory Cache" },
];
---

<div class="py-10 border-y border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-900/40 backdrop-blur-md overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-4 flex items-center justify-between">
    <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">
      <span class="w-2 h-2 rounded-full bg-primary inline-block"></span>
      <span>Enterprise Engineering Stack</span>
    </div>
    <span class="text-[11px] text-slate-500 font-mono hidden sm:inline">Built for high concurrency &amp; low latency</span>
  </div>

  <!-- Horizontal Scroll / Flex Row -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center gap-3 sm:gap-4 overflow-x-auto pb-2 scrollbar-none sm:grid sm:grid-cols-5 lg:grid-cols-10">
      {technologies.map((tech) => (
        <div class="shrink-0 flex flex-col items-center justify-center p-3 sm:p-3.5 rounded-2xl bg-white dark:bg-slate-950/70 border border-slate-200/90 dark:border-slate-800/90 hover:border-primary/50 transition-all group shadow-xs hover:shadow-md">
          <div class="w-8 h-8 rounded-xl bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-700 dark:text-slate-300 group-hover:text-primary transition-colors mb-2">
            <i data-lucide={tech.icon} class="w-4 h-4"></i>
          </div>
          <span class="text-xs font-bold text-slate-900 dark:text-white truncate max-w-full font-heading">
            {tech.name}
          </span>
          <span class="text-[9px] text-slate-500 font-mono truncate max-w-full">
            {tech.category}
          </span>
        </div>
      ))}
    </div>
  </div>
</div>
