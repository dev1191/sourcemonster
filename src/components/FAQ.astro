---
import { getPublishedFaqs } from "../services";

// Default fallback FAQs if none exist in the database yet
const defaultFaqs = [
  {
    question: "How long does it take to build and deploy a software project?",
    answer: "It depends on scope and complexity. A turnkey commercial boilerplate can be deployed to your live server in under 30 minutes. A custom MVP typically takes 3 to 6 weeks, while more complex multi-tenant SaaS platforms take 8 to 12 weeks. We provide clear milestone timelines after understanding your requirements.",
    category: "Timeline",
  },
  {
    question: "Do I get full ownership and access to the source code?",
    answer: "Yes, 100%. When you purchase our commercial projects or hire our bespoke development collective, you receive full, unencrypted source code (frontend, backend, database migrations, and Docker configurations) with zero obfuscation or vendor lock-in.",
    category: "Licensing",
  },
  {
    question: "Do you work with early-stage startups or established enterprises?",
    answer: "We work with both! From early-stage founders needing rapid MVP builds to validate their market hypotheses, to established brands requiring high-concurrency SaaS refactoring, we tailor our team size and sprint cadence to your specific stage.",
    category: "General",
  },
  {
    question: "Can you customize and integrate AI capabilities into our product?",
    answer: "Absolutely. We specialize in engineering LLM-powered applications, AI copilots, OpenAI/LangChain integrations, and custom workflow automation that elevate your software above standard competitors.",
    category: "AI & Tech",
  },
  {
    question: "What is included in your engineering service?",
    answer: "End-to-end execution: product architecture, UI/UX design, full-stack frontend & backend engineering, database schemas, DevOps containerization (Docker), QA testing, and post-launch maintenance.",
    category: "Services",
  },
  {
    question: "How do updates and support work for purchased commercial projects?",
    answer: "All our commercial boilerplates receive continuous maintenance, performance optimizations, and security patches. You can review detailed version logs on each project page, and our technical support is available directly via email and WhatsApp.",
    category: "Support",
  },
];

let faqsList: Array<{
  question: string;
  answer: string;
  category: string;
}> = [];

try {
  const dbFaqs = await getPublishedFaqs();
  if (dbFaqs && dbFaqs.length > 0) {
    faqsList = dbFaqs.map((f) => ({
      question: f.question,
      answer: f.answer,
      category: f.category || "General",
    }));
  } else {
    faqsList = defaultFaqs;
  }
} catch {
  faqsList = defaultFaqs;
}

// Extract distinct categories
const categories = ["All", ...Array.from(new Set(faqsList.map((f) => f.category)))];
---

<!-- FAQ Section (Lume Agency Inspired) -->
<section id="faq" class="py-20 sm:py-32 bg-slate-50 dark:bg-[#070913] relative overflow-hidden transition-colors border-t border-slate-200/80 dark:border-white/[0.08]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
    <!-- Header -->
    <div class="text-center mb-12 sm:mb-16" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.1] text-xs font-mono uppercase tracking-widest text-primary font-bold mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        <span>FAQs</span>
      </div>
      <h2 class="text-3xl xs:text-4xl sm:text-5xl lg:text-6xl font-black font-heading tracking-tight text-slate-900 dark:text-white leading-tight">
        The Things People Ask Before We Start.
      </h2>
      <p class="max-w-xl mx-auto text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-4 leading-relaxed">
        Clear answers about our software architecture, licensing terms, code access, and customization capabilities.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    {categories.length > 2 && (
      <div class="flex flex-wrap items-center justify-center gap-2 mb-10" id="faq-filter-container">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`faq-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition cursor-pointer ${
              idx === 0
                ? "bg-primary text-white shadow-md shadow-primary/20"
                : "bg-white dark:bg-white/[0.04] text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-white/10"
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    )}

    <!-- FAQ Accordion List -->
    <div class="space-y-4" id="faq-list">
      {faqsList.map((faq, idx) => (
        <div
          class="faq-item rounded-2xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-slate-300 dark:hover:border-white/20 transition-all duration-300 overflow-hidden shadow-xs"
          data-category={faq.category}
          data-aos="fade-up"
          data-aos-delay={idx * 40}
        >
          <button
            type="button"
            class="faq-trigger w-full flex items-center justify-between p-5 sm:p-6 text-left cursor-pointer group"
            aria-expanded="false"
          >
            <span class="text-base sm:text-lg font-bold font-heading text-slate-900 dark:text-white group-hover:text-primary transition-colors pr-4">
              {faq.question}
            </span>
            <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-white/[0.05] text-slate-600 dark:text-slate-300 flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
              <i data-lucide="plus" class="faq-icon-plus w-4 h-4 transition-transform duration-300"></i>
              <i data-lucide="minus" class="faq-icon-minus w-4 h-4 hidden transition-transform duration-300"></i>
            </div>
          </button>

          <div class="faq-content hidden px-5 sm:px-6 pb-6 pt-0 text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-white/[0.04] mt-2">
            <div class="pt-4">
              {faq.answer}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom "Got Another Question?" Card (Lume Pattern) -->
    <div
      class="mt-12 p-8 rounded-3xl bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left"
      data-aos="fade-up"
    >
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
          <i data-lucide="help-circle" class="w-6 h-6"></i>
        </div>
        <div>
          <h4 class="text-lg font-bold font-heading text-slate-900 dark:text-white">
            Got Another Question?
          </h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
            We're here to help. Schedule a call or email us directly at <a href="mailto:contact@sourcemonster.in" class="text-primary hover:underline">contact@sourcemonster.in</a>.
          </p>
        </div>
      </div>

      <a
        href="#contact"
        class="px-6 py-3 rounded-full font-semibold text-xs sm:text-sm bg-primary hover:bg-orange-600 text-white shadow-md shadow-primary/20 transition-all shrink-0 hover:scale-105 active:scale-95"
      >
        <span>Book a Call</span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Accordion Toggle
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach((item) => {
      const trigger = item.querySelector('.faq-trigger');
      const content = item.querySelector('.faq-content');
      const plusIcon = item.querySelector('.faq-icon-plus');
      const minusIcon = item.querySelector('.faq-icon-minus');

      trigger?.addEventListener('click', () => {
        const isOpen = !content?.classList.contains('hidden');

        // Close all other items
        faqItems.forEach((otherItem) => {
          if (otherItem !== item) {
            otherItem.querySelector('.faq-content')?.classList.add('hidden');
            otherItem.querySelector('.faq-icon-plus')?.classList.remove('hidden');
            otherItem.querySelector('.faq-icon-minus')?.classList.add('hidden');
            otherItem.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle this item
        if (isOpen) {
          content?.classList.add('hidden');
          plusIcon?.classList.remove('hidden');
          minusIcon?.classList.add('hidden');
          trigger?.setAttribute('aria-expanded', 'false');
        } else {
          content?.classList.remove('hidden');
          plusIcon?.classList.add('hidden');
          minusIcon?.classList.remove('hidden');
          trigger?.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Category Filter
    const filterButtons = document.querySelectorAll('.faq-filter-btn');
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedCat = btn.getAttribute('data-category');

        filterButtons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-white', 'shadow-md', 'shadow-primary/20');
          b.classList.add('bg-white', 'dark:bg-white/[0.04]', 'text-slate-600', 'dark:text-slate-400');
        });
        btn.classList.add('bg-primary', 'text-white', 'shadow-md', 'shadow-primary/20');
        btn.classList.remove('bg-white', 'dark:bg-white/[0.04]', 'text-slate-600', 'dark:text-slate-400');

        faqItems.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (selectedCat === 'All' || itemCat === selectedCat) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
