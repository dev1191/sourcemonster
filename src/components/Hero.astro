---

---

<!-- Hero Section -->
<section
  id="home"
  class="min-h-screen relative flex items-center pt-28 pb-16 sm:pb-24 overflow-hidden bg-mesh bg-slate-50 dark:bg-slate-950 transition-colors duration-200"
>
  <!-- Ambient Lighting Glows -->
  <div class="hero-glow top-10 -left-20"></div>
  <div class="hero-glow bottom-10 -right-20 opacity-60"></div>
  <div
    class="absolute inset-0 bg-grid-pattern opacity-[0.03] dark:opacity-[0.06] pointer-events-none"
  >
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-10 lg:gap-12 items-center relative z-10 w-full"
  >
    <!-- Left Content Column -->
    <div
      class="lg:col-span-7 text-left"
      data-aos="fade-right"
      data-aos-duration="1000"
    >
      <!-- Dynamic Main Headline -->
      <h1
        class="text-4xl xs:text-5xl sm:text-6xl md:text-7xl lg:text-7xl xl:text-8xl font-black font-heading leading-[1.08] tracking-tight mb-6 sm:mb-8 text-slate-900 dark:text-white"
      >
        WE BUILD <br class="hidden sm:inline" />
        <span class="text-gradient">DIGITAL BEASTS.</span>
      </h1>

      <p
        class="text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-xl leading-relaxed mb-8 sm:mb-10 font-normal"
      >
        SourceMonster is a high-performance software collective. We engineer
        robust digital products, bespoke SaaS platforms, and enterprise
        solutions that dominate their niche.
      </p>

      <!-- Dual Action CTAs -->
      <div
        class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 mb-10 sm:mb-12"
      >
        <a
          href="#contact"
          class="group bg-primary hover:bg-orange-600 active:scale-95 text-white px-7 sm:px-8 py-3.5 sm:py-4 rounded-2xl font-bold text-base sm:text-lg shadow-xl shadow-primary/25 hover:shadow-2xl hover:shadow-primary/40 transition-all flex items-center justify-center gap-2"
        >
          <span>Launch Project</span>
          <i
            data-lucide="arrow-right"
            class="w-5 h-5 group-hover:translate-x-1.5 transition-transform"
          ></i>
        </a>
        <a
          href="/products"
          class="glass-card dark:bg-slate-900/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-900 dark:text-white px-7 sm:px-8 py-3.5 sm:py-4 rounded-2xl font-bold text-base sm:text-lg border border-slate-200 dark:border-slate-800 hover:border-primary/50 transition-all flex items-center justify-center gap-2 shadow-sm"
        >
          <i data-lucide="box" class="w-5 h-5 text-primary"></i>
          <span>Explore Products</span>
        </a>
      </div>

      <!-- Trust Proof Avatar Stack -->
      <div
        class="flex flex-wrap items-center gap-4 sm:gap-6 pt-4 border-t border-slate-200/80 dark:border-slate-800/80"
      >
        <div class="flex -space-x-3">
          <img
            src="/assets/images/resource/ankit.jpeg"
            class="w-10 sm:w-11 h-10 sm:h-11 rounded-full border-2 border-white dark:border-slate-950 object-cover shadow-sm"
            alt="Team Ankit"
          />
          <img
            src="/assets/images/resource/dev.jpeg"
            class="w-10 sm:w-11 h-10 sm:h-11 rounded-full border-2 border-white dark:border-slate-950 object-cover shadow-sm"
            alt="Team Dev"
          />
          <img
            src="/assets/images/resource/anil.jpeg"
            class="w-10 sm:w-11 h-10 sm:h-11 rounded-full border-2 border-white dark:border-slate-950 object-cover shadow-sm"
            alt="Team Anil"
          />
          <div
            class="w-10 sm:w-11 h-10 sm:h-11 rounded-full border-2 border-white dark:border-slate-950 bg-secondary flex items-center justify-center text-[11px] font-mono font-bold text-white shadow-sm"
          >
            +12
          </div>
        </div>
        <div>
          <div class="flex items-center gap-1 text-amber-500 mb-0.5">
            <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
            <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
            <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
            <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
            <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
            <span
              class="text-xs font-bold text-slate-800 dark:text-slate-200 ml-1.5 font-mono"
              >4.9 / 5</span
            >
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">
            Trusted by <span class="text-slate-900 dark:text-white font-bold"
              >110+ brands &amp; developers</span
            > globally
          </p>
        </div>
      </div>
    </div>

    <!-- Right Visual Showcase Column (Responsive on Mobile & Desktop) -->
    <div
      class="lg:col-span-5 relative mt-6 lg:mt-0"
      data-aos="zoom-in"
      data-aos-duration="1200"
    >
      <div
        class="absolute -inset-4 sm:-inset-8 bg-gradient-to-tr from-primary/20 to-secondary/20 rounded-3xl blur-2xl opacity-40 dark:opacity-50"
      >
      </div>

      <!-- Window Container Mockup -->
      <div
        class="relative z-10 rounded-2xl sm:rounded-3xl overflow-hidden border border-slate-200/90 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl shadow-2xl"
      >
        <!-- Window Titlebar -->
        <div
          class="flex items-center justify-between px-4 py-3 bg-slate-100/80 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800"
        >
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 block"></span>
          </div>
        </div>

        <!-- Showcase Media Area -->
        <div
          class="relative p-3 sm:p-5 bg-gradient-to-b from-slate-100/50 to-slate-200/50 dark:from-slate-950/60 dark:to-slate-900/80 overflow-hidden"
        >
          <img
            src="/assets/images/resource/banner-1.png"
            alt="Source Monster Engineering"
            class="w-full h-auto object-contain rounded-xl max-h-[340px] sm:max-h-[420px] transition-transform duration-700 hover:scale-[1.02]"
          />

          <!-- Floating Performance Chip (Top-Right) -->
          <div
            class="absolute top-5 right-5 glass-card dark:bg-slate-900/90 dark:border-slate-700/70 p-3 sm:p-4 rounded-2xl shadow-xl border border-white/40 backdrop-blur-md"
          >
            <div class="flex items-center gap-2 mb-1">
              <div class="w-2 h-2 rounded-full bg-primary animate-ping"></div>
              <span
                class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400"
                >Uptime</span
              >
            </div>
            <div
              class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white font-mono"
            >
              99.99%
            </div>
          </div>

          <!-- Floating Security Chip (Bottom-Left) -->
          <div
            class="absolute bottom-5 left-5 glass-card dark:bg-slate-900/90 dark:border-slate-700/70 p-3 sm:p-4 rounded-2xl shadow-xl border border-white/40 backdrop-blur-md flex items-center gap-3"
          >
            <div
              class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center"
            >
              <i data-lucide="shield-check" class="w-4 h-4"></i>
            </div>
            <div>
              <div
                class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white"
              >
                Production Ready
              </div>
              <div class="text-[10px] text-slate-500 font-mono">
                Zero-Vulnerability Baseline
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .text-gradient {
    background: linear-gradient(135deg, #ff4d1c 0%, #ff8e6e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .bg-mesh {
    background-color: #f8fafc;
    background-image:
      radial-gradient(at 0% 0%, rgba(255, 77, 28, 0.06) 0px, transparent 50%),
      radial-gradient(at 100% 0%, rgba(0, 40, 162, 0.06) 0px, transparent 50%);
  }
  :global(.dark) .bg-mesh {
    background-color: #020617;
    background-image:
      radial-gradient(at 0% 0%, rgba(255, 77, 28, 0.08) 0px, transparent 50%),
      radial-gradient(at 100% 0%, rgba(0, 40, 162, 0.14) 0px, transparent 50%);
  }
  .hero-glow {
    position: absolute;
    width: 550px;
    height: 550px;
    background: radial-gradient(
      circle,
      rgba(255, 77, 28, 0.12) 0%,
      transparent 70%
    );
    border-radius: 50%;
    filter: blur(90px);
    z-index: 1;
    pointer-events: none;
  }
  .glass-card {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  :global(.dark) .glass-card {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .bg-grid-pattern {
    background-image: radial-gradient(
      rgba(100, 116, 139, 0.4) 1px,
      transparent 0
    );
    background-size: 24px 24px;
  }
</style>
