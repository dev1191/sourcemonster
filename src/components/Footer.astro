---
import { getSiteSettings } from "../lib/settings";

const settings = await getSiteSettings();
---
<footer class="pb-16 bg-white border-t border-slate-100 overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-6 relative z-10">
	<div class="pt-16 flex flex-col md:flex-row justify-between items-center">
	  <div class="flex items-center space-x-3 mb-8 md:mb-0">
		<img src="/assets/images/logo.png" alt={settings.site_name} class="h-6 w-auto opacity-70" />
		<span class="text-[10px] font-bold text-slate-400 mt-1 uppercase tracking-widest">V2.0</span>
	  </div>

	  <p class="text-slate-600 text-sm font-semibold uppercase">
		{settings.footer_copyright}
	  </p>

	  <div class="flex space-x-6 mt-8 md:mt-0">
		{settings.social_twitter && (
		  <a href={settings.social_twitter} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-primary transition-colors" title="Twitter / X">
			<i data-lucide="twitter"></i>
		  </a>
		)}
		{settings.social_github && (
		  <a href={settings.social_github} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-primary transition-colors" title="GitHub">
			<i data-lucide="github"></i>
		  </a>
		)}
		{settings.social_linkedin && (
		  <a href={settings.social_linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-primary transition-colors" title="LinkedIn">
			<i data-lucide="linkedin"></i>
		  </a>
		)}
	  </div>
	</div>
  </div>
</footer>
