---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getPublishedProjects } from "../../services";

const publishedProjects = await getPublishedProjects();
---

<BaseLayout
  title="Projects & Commercial Solutions | SourceMonster"
  description="Explore production-tested web applications, full-stack SaaS boilerplates, and developer scripts engineered by SourceMonster."
>
  <Navbar />

  <main class="pt-32 sm:pt-40 pb-24 min-h-screen bg-slate-50 dark:bg-[#070913] text-slate-900 dark:text-slate-100 transition-colors duration-200">
    <!-- Header Banner (Lume Agency Inspired) -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 sm:mb-20 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.1] text-xs font-mono uppercase tracking-widest text-primary font-bold mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        <span>Commercial Catalog</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black font-heading tracking-tight text-slate-900 dark:text-white mb-6 leading-tight">
        Architected for <span class="text-primary">Performance</span> &amp; Scale.
      </h1>
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        Production-tested web applications, full-stack SaaS boilerplates, and automated toolkits ready for immediate commercial deployment.
      </p>
    </section>

    <!-- Projects Grid -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      {publishedProjects.length === 0 ? (
        <div class="py-20 text-center text-slate-500 dark:text-slate-400">
          <p class="text-lg">Our project catalog is currently being updated. Check back shortly!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10">
          {publishedProjects.map((p) => (
            <article class="bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 rounded-3xl overflow-hidden transition-all duration-300 flex flex-col group shadow-sm hover:shadow-2xl hover:-translate-y-1.5">
              <!-- Thumbnail -->
              <div class="relative aspect-video sm:h-64 bg-slate-100 dark:bg-white/[0.03] overflow-hidden border-b border-slate-200 dark:border-white/[0.06]">
                {p.thumbnailUrl ? (
                  <img
                    src={p.thumbnailUrl}
                    alt={p.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center text-slate-400 dark:text-slate-600">
                    <i data-lucide="package" class="w-12 h-12 mb-2"></i>
                    <span class="text-xs uppercase tracking-wider font-mono">SourceMonster Project</span>
                  </div>
                )}

                <div class="absolute top-4 left-4 flex gap-2">
                  {p.isFeatured && (
                    <span class="px-3 py-1 rounded-full bg-primary text-white text-[10px] font-bold uppercase tracking-wider shadow-md shadow-primary/30">
                      Featured
                    </span>
                  )}
                  {p.version && (
                    <span class="px-3 py-1 rounded-full bg-white/95 dark:bg-[#070913]/90 backdrop-blur-md text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-white/10 text-[11px] font-mono font-medium shadow-xs">
                      v{p.version}
                    </span>
                  )}
                </div>

                {p.demoUrl && (
                  <div class="absolute top-4 right-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/90 text-white backdrop-blur-md text-[11px] font-semibold shadow-md">
                      <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                      <span>Live Demo</span>
                    </span>
                  </div>
                )}
              </div>

              <!-- Content Body -->
              <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
                <div>
                  <h2 class="text-2xl font-bold font-heading text-slate-900 dark:text-white group-hover:text-primary transition-colors tracking-tight mb-3">
                    <a href={`/projects/${p.slug}`} class="text-slate-900 dark:text-white group-hover:text-primary transition-colors">{p.title}</a>
                  </h2>

                  <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-6 line-clamp-3">
                    {p.shortDescription}
                  </p>

                  <!-- Technologies -->
                  {p.technologies && p.technologies.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-6">
                      {p.technologies.map((t) => (
                        <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.06] text-[11px] font-medium text-slate-700 dark:text-slate-300 font-mono">
                          {t}
                        </span>
                      ))}
                    </div>
                  )}
                </div>

                <!-- Action Buttons -->
                <div class="pt-6 border-t border-slate-100 dark:border-white/[0.06] flex flex-wrap items-center justify-between gap-3">
                  <a
                    href={`/projects/${p.slug}`}
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-800 dark:text-white hover:text-primary dark:hover:text-primary transition"
                  >
                    <span>View Details &amp; Architecture</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5 text-primary"></i>
                  </a>

                  {p.codecanyonUrl && (
                    <a
                      href={p.codecanyonUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-5 py-2.5 bg-primary hover:bg-orange-600 text-white rounded-full text-xs font-semibold shadow-md shadow-primary/25 hover:shadow-primary/40 transition flex items-center gap-2"
                    >
                      <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                      <span>Get Code</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  </main>

  <Footer />
</BaseLayout>
