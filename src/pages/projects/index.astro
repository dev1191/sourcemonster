---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getPublishedProjects } from "../../services";

const publishedProjects = await getPublishedProjects();

// Extract unique categories / tags
const allTags = Array.from(
  new Set(
    publishedProjects.flatMap((p) => p.technologies || [])
  )
).slice(0, 7);

const filterTabs = ["All", ...allTags];
---

<BaseLayout
  title="Projects & Commercial Solutions | SourceMonster"
  description="Building digital products that move ideas forward. Explore our production-tested web applications, full-stack SaaS boilerplates, and developer toolkits."
>
  <Navbar />

  <main class="pt-32 sm:pt-40 pb-24 min-h-screen bg-slate-50 dark:bg-[#070913] text-slate-900 dark:text-slate-100 transition-colors duration-200">
    <!-- Ambient Lighting Glow -->
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-primary/15 via-primary/5 to-transparent rounded-full blur-[150px] pointer-events-none -z-10"></div>

    <!-- Header Section (Lume Agency Inspired) -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 sm:mb-16 text-center" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.1] text-xs font-mono uppercase tracking-widest text-primary font-bold mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        <span>Selected Works</span>
      </div>

      <h1 class="text-4xl xs:text-5xl sm:text-6xl font-black font-heading tracking-tight text-slate-900 dark:text-white mb-6 leading-[1.08]">
        Building digital products that move ideas forward.
      </h1>

      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 dark:text-slate-400 mb-8 leading-relaxed">
        Explore our selected products, boilerplates, and systems — each one architected, engineered, and launched by the SourceMonster team.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/#contact"
          class="inline-flex items-center gap-2 px-7 py-3 rounded-full font-semibold text-sm bg-primary hover:bg-orange-600 active:scale-95 text-white shadow-lg shadow-primary/25 hover:shadow-primary/40 transition-all hover:-translate-y-0.5"
        >
          <span>Start Your Project</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
        <a
          href="/#faq"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-sm bg-white dark:bg-white/[0.05] hover:bg-slate-100 dark:hover:bg-white/[0.1] text-slate-900 dark:text-white border border-slate-200 dark:border-white/10 transition-all"
        >
          <span>Read FAQs</span>
        </a>
      </div>
    </section>

    <!-- Category Filter Tabs (Lume Style) -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-12 sm:mb-16" data-aos="fade-up">
      <div class="flex flex-wrap items-center justify-center gap-2" id="project-filter-bar">
        {filterTabs.map((tab, idx) => (
          <button
            type="button"
            data-filter={tab}
            class={`project-filter-btn px-4 py-2 rounded-full text-xs font-semibold tracking-wide transition-all cursor-pointer ${
              idx === 0
                ? "bg-primary text-white shadow-md shadow-primary/25"
                : "bg-white dark:bg-white/[0.03] text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-white/[0.08] hover:border-slate-300 dark:hover:border-white/20"
            }`}
          >
            {tab}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid (Lume Agency Inspired) -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6">
      {publishedProjects.length === 0 ? (
        <div class="py-20 text-center text-slate-500 dark:text-slate-400">
          <p class="text-lg">Our project catalog is currently being updated. Check back shortly!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10" id="project-grid">
          {publishedProjects.map((p, idx) => (
            <article
              class="project-card bg-white dark:bg-white/[0.02] border border-slate-200 dark:border-white/[0.08] hover:border-primary/40 dark:hover:border-primary/40 rounded-3xl overflow-hidden transition-all duration-300 flex flex-col group shadow-sm hover:shadow-2xl hover:-translate-y-1.5"
              data-tags={JSON.stringify(p.technologies || [])}
              data-aos="fade-up"
              data-aos-delay={(idx % 2) * 100}
            >
              <!-- Thumbnail Viewport -->
              <a
                href={`/projects/${p.slug}`}
                class="block relative aspect-video sm:h-72 bg-slate-100 dark:bg-white/[0.03] overflow-hidden border-b border-slate-200 dark:border-white/[0.06] group/thumb"
              >
                {p.thumbnailUrl ? (
                  <img
                    src={p.thumbnailUrl}
                    alt={p.title}
                    class="w-full h-full object-cover group-hover/thumb:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center text-slate-400 dark:text-slate-600">
                    <i data-lucide="package" class="w-12 h-12 mb-2"></i>
                    <span class="text-xs uppercase tracking-wider font-mono">SourceMonster Project</span>
                  </div>
                )}

                <!-- Top Left Badges -->
                <div class="absolute top-4 left-4 flex items-center gap-2">
                  {p.isFeatured && (
                    <span class="px-3 py-1 rounded-full bg-primary text-white text-[10px] font-bold uppercase tracking-wider shadow-md shadow-primary/30">
                      Featured
                    </span>
                  )}
                  {p.version && (
                    <span class="px-3 py-1 rounded-full bg-white/95 dark:bg-[#070913]/90 backdrop-blur-md text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-white/10 text-[11px] font-mono font-medium shadow-xs">
                      v{p.version}
                    </span>
                  )}
                </div>

                <!-- Top Right Live Demo Badge -->
                {p.demoUrl && (
                  <div class="absolute top-4 right-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/90 text-white backdrop-blur-md text-[11px] font-semibold shadow-md">
                      <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                      <span>Live Demo</span>
                    </span>
                  </div>
                )}

                <!-- Center Floating "View Project" Pill on Hover -->
                <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px] opacity-0 group-hover/thumb:opacity-100 transition-opacity flex items-center justify-center">
                  <span class="px-5 py-2.5 rounded-full bg-white text-slate-900 font-semibold text-xs flex items-center gap-2 shadow-xl transform translate-y-2 group-hover/thumb:translate-y-0 transition-transform">
                    <span>View Architecture</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                  </span>
                </div>
              </a>

              <!-- Content Body -->
              <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
                <div>
                  <h2 class="text-2xl font-bold font-heading text-slate-900 dark:text-white group-hover:text-primary transition-colors tracking-tight mb-2.5">
                    <a href={`/projects/${p.slug}`} class="text-slate-900 dark:text-white group-hover:text-primary transition-colors">{p.title}</a>
                  </h2>

                  <!-- Technologies Pills (Lume Pattern) -->
                  {p.technologies && p.technologies.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-4">
                      {p.technologies.slice(0, 4).map((tech) => (
                        <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.06] text-[11px] font-medium text-slate-700 dark:text-slate-300 font-mono">
                          {tech}
                        </span>
                      ))}
                    </div>
                  )}

                  <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-6 line-clamp-2">
                    {p.shortDescription}
                  </p>
                </div>

                <!-- Action Buttons -->
                <div class="pt-5 border-t border-slate-100 dark:border-white/[0.06] flex flex-wrap items-center justify-between gap-3">
                  <a
                    href={`/projects/${p.slug}`}
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-800 dark:text-white hover:text-primary dark:hover:text-primary transition"
                  >
                    <span>View Details &amp; Architecture</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5 text-primary"></i>
                  </a>

                  {p.codecanyonUrl && (
                    <a
                      href={p.codecanyonUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-5 py-2.5 bg-primary hover:bg-orange-600 text-white rounded-full text-xs font-semibold shadow-md shadow-primary/25 hover:shadow-primary/40 transition flex items-center gap-2"
                    >
                      <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                      <span>Get Code</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    <!-- Bottom CTA Banner (Lume Pattern) -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-20" data-aos="fade-up">
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-primary/10 via-indigo-500/5 to-transparent border border-primary/20 flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="text-2xl sm:text-3xl font-black font-heading text-slate-900 dark:text-white mb-2">
            Need a bespoke custom software solution?
          </h3>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-xl">
            Our engineering collective builds tailor-made SaaS applications, mobile apps, and enterprise backends to your exact specifications.
          </p>
        </div>

        <a
          href="/#contact"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold text-sm bg-primary hover:bg-orange-600 text-white shadow-lg shadow-primary/25 hover:shadow-primary/40 transition-all shrink-0 hover:scale-105 active:scale-95"
        >
          <span>Schedule an Intro Call</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.project-filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Toggle active button style
        filterButtons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-white', 'shadow-md', 'shadow-primary/25');
          b.classList.add('bg-white', 'dark:bg-white/[0.03]', 'text-slate-600', 'dark:text-slate-400');
        });
        btn.classList.add('bg-primary', 'text-white', 'shadow-md', 'shadow-primary/25');
        btn.classList.remove('bg-white', 'dark:bg-white/[0.03]', 'text-slate-600', 'dark:text-slate-400');

        // Filter cards
        projectCards.forEach((card) => {
          const rawTags = card.getAttribute('data-tags') || '[]';
          const tags = JSON.parse(rawTags);

          if (filter === 'All' || tags.includes(filter)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
