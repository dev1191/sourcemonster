---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getProductBySlug } from "../../services";
import { Prose } from "../../components/starwind/prose";

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const isAdmin = !!Astro.locals.adminUser;
const data = await getProductBySlug(slug, { allowDraft: isAdmin });

if (!data) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const { product, thumbnailUrl, galleryItems, addons, changelogs = [] } = data;
const pageTitle = product.seoTitle || `${product.title} | SourceMonster`;

// Gather all preview media (thumbnail + gallery screenshots)
const validGallery = galleryItems.filter((item) => Boolean(item.url));
const allShowcaseImages = [
  ...(thumbnailUrl ? [{ url: thumbnailUrl, caption: `${product.title} - Main Cover` }] : []),
  ...validGallery,
];

// Determine latest update timestamp
const latestChangelog = changelogs.length > 0 ? changelogs[0] : null;
const lastUpdatedDate = latestChangelog?.createdAt || product.updatedAt;
---

<BaseLayout title={pageTitle}>
  <Navbar />

  <main class="pt-28 pb-24 min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-200">
    <!-- Admin Preview Banner -->
    {product.status !== "published" && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
        <div class="p-4 bg-amber-500/10 border border-amber-500/30 rounded-2xl text-amber-800 dark:text-amber-200 text-xs flex flex-wrap items-center justify-between gap-3 shadow-sm">
          <div class="flex items-center gap-2.5">
            <span class="p-1 rounded-lg bg-amber-500/20 text-amber-600 dark:text-amber-400">
              <i data-lucide="alert-triangle" class="w-4 h-4"></i>
            </span>
            <span>
              <strong>Draft Mode:</strong> This product is currently unpublished and only visible to authenticated administrators.
            </span>
          </div>
          <a
            href={`/admin/products/${product.id}/edit`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-900 dark:text-amber-100 font-semibold transition"
          >
            <span>Edit in CMS</span>
            <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
          </a>
        </div>
      </div>
    )}

    <!-- Ambient Hero Background Aura -->
    <div class="relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-primary/10 via-primary/5 to-transparent blur-3xl pointer-events-none -z-10"></div>

      <!-- Hero Header Section -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-10">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
          <a href="/" class="hover:text-primary transition flex items-center gap-1">
            <i data-lucide="home" class="w-3.5 h-3.5"></i>
            <span>Home</span>
          </a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a href="/products" class="hover:text-primary transition">Products</a>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <span class="text-slate-900 dark:text-white font-semibold truncate max-w-xs sm:max-w-md">{product.title}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-8">
            <!-- Badges Row -->
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold font-mono uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                CodeCanyon Verified
              </span>

              {product.version && (
                <span class="px-3 py-1 rounded-full bg-slate-200/80 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono font-semibold">
                  {product.version}
                </span>
              )}

              {product.isFeatured && (
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider">
                  <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                  Featured Architecture
                </span>
              )}

              <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-medium font-mono">
                Production Ready
              </span>
            </div>

            <!-- Main Title -->
            <h1 class="text-3xl sm:text-5xl lg:text-5xl font-black font-heading tracking-tight text-slate-900 dark:text-white mb-5 leading-tight">
              {product.title}
            </h1>

            <!-- Short Description -->
            <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl mb-6">
              {product.shortDescription}
            </p>

            <!-- Tech Stack Tags -->
            {product.technologies && product.technologies.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs uppercase tracking-wider text-slate-500 font-mono font-bold mr-1">Stack:</span>
                {product.technologies.map((t) => (
                  <span class="px-3 py-1 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 font-mono shadow-xs hover:border-primary/40 transition">
                    {t}
                  </span>
                ))}
              </div>
            )}
          </div>

          <!-- Quick Stat Card in Hero (Desktop) -->
          <div class="lg:col-span-4 bg-white/70 dark:bg-slate-900/60 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-3xl p-5 shadow-lg">
            <div class="grid grid-cols-2 gap-4 text-center">
              <div class="p-3 bg-slate-50 dark:bg-slate-950/70 rounded-2xl border border-slate-200/80 dark:border-slate-800/80">
                <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">Add-ons</div>
                <div class="text-xl font-black text-slate-900 dark:text-white mt-1">
                  {addons.length} <span class="text-xs font-normal text-slate-500">modules</span>
                </div>
              </div>
              <div class="p-3 bg-slate-50 dark:bg-slate-950/70 rounded-2xl border border-slate-200/80 dark:border-slate-800/80">
                <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">Updates</div>
                <div class="text-xl font-black text-primary mt-1">
                  {changelogs.length} <span class="text-xs font-normal text-slate-500">releases</span>
                </div>
              </div>
              <div class="p-3 bg-slate-50 dark:bg-slate-950/70 rounded-2xl border border-slate-200/80 dark:border-slate-800/80">
                <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">Last Release</div>
                <div class="text-xs font-bold text-slate-800 dark:text-slate-200 mt-1.5 truncate">
                  {new Date(lastUpdatedDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                </div>
              </div>
              <div class="p-3 bg-slate-50 dark:bg-slate-950/70 rounded-2xl border border-slate-200/80 dark:border-slate-800/80">
                <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">License</div>
                <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 mt-1.5">
                  Commercial
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content & Sticky Conversion Dock -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: Media Showcase & Rich Details (8 cols) -->
        <div class="lg:col-span-8 space-y-10">

          <!-- Interactive macOS Window Media Showcase -->
          <section class="rounded-3xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl">
            <!-- Window Bezel -->
            <div class="flex items-center justify-between px-4 sm:px-6 py-3.5 bg-slate-100/90 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 block"></span>
                <span class="ml-3 text-xs font-mono text-slate-500 dark:text-slate-400 truncate max-w-[200px] sm:max-w-md">
                  {product.slug}.app
                </span>
              </div>
              <div class="flex items-center gap-3">
                {product.demoUrl && (
                  <a
                    href={product.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold transition"
                  >
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Live Demo</span>
                    <i data-lucide="external-link" class="w-3 h-3"></i>
                  </a>
                )}
                <button
                  type="button"
                  id="fullscreen-image-btn"
                  class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-800 transition cursor-pointer"
                  title="Open full resolution"
                >
                  <i data-lucide="maximize-2" class="w-4 h-4"></i>
                </button>
              </div>
            </div>

            <!-- Primary Showcase Viewer -->
            <div class="relative bg-slate-100 dark:bg-slate-950 flex items-center justify-center overflow-hidden min-h-[320px] sm:min-h-[460px]">
              {thumbnailUrl ? (
                <img
                  id="main-showcase-img"
                  src={thumbnailUrl}
                  alt={product.title}
                  class="w-full h-auto max-h-[540px] object-contain transition-all duration-300"
                />
              ) : (
                <div class="py-24 text-center text-slate-400 dark:text-slate-600">
                  <i data-lucide="image" class="w-16 h-16 mx-auto mb-2 opacity-50"></i>
                  <p class="font-mono text-xs">No media preview available</p>
                </div>
              )}
            </div>

            <!-- Interactive Gallery Strip (if screenshots exist) -->
            {allShowcaseImages.length > 1 && (
              <div class="p-4 bg-slate-50 dark:bg-slate-950/80 border-t border-slate-200 dark:border-slate-800">
                <div class="flex items-center justify-between mb-2.5">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                    <i data-lucide="camera" class="w-3.5 h-3.5 text-primary"></i>
                    <span>Preview Gallery ({allShowcaseImages.length} views)</span>
                  </span>
                  <span class="text-[11px] text-slate-500">Click to preview</span>
                </div>
                <div class="flex items-center gap-3 overflow-x-auto pb-1 scrollbar-thin">
                  {allShowcaseImages.map((img, idx) => (
                    <button
                      type="button"
                      class={`gallery-thumb-btn shrink-0 w-20 sm:w-24 h-14 sm:h-16 rounded-xl overflow-hidden border-2 transition cursor-pointer relative ${
                        idx === 0
                          ? "border-primary ring-2 ring-primary/20 shadow-md"
                          : "border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600 opacity-75 hover:opacity-100"
                      }`}
                      data-img-src={img.url}
                      data-caption={img.caption || `Preview ${idx + 1}`}
                      title={img.caption || `Preview image ${idx + 1}`}
                    >
                      <img src={img.url} alt={img.caption || "Thumbnail"} class="w-full h-full object-cover" />
                    </button>
                  ))}
                </div>
              </div>
            )}
          </section>

          <!-- Floating Section Navigation Bar -->
          <div class="sticky top-20 z-10 p-1.5 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-2xl shadow-lg flex items-center gap-1 overflow-x-auto">
            <a
              href="#overview"
              class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition whitespace-nowrap"
            >
              Overview
            </a>
            {product.features && (
              <a
                href="#features"
                class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition whitespace-nowrap"
              >
                Key Capabilities
              </a>
            )}
            {addons.length > 0 && (
              <a
                href="#addons"
                class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition whitespace-nowrap flex items-center gap-1.5"
              >
                <span>Modules &amp; Add-ons</span>
                <span class="px-1.5 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-mono">{addons.length}</span>
              </a>
            )}
            {changelogs.length > 0 && (
              <a
                href="#changelogs"
                class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition whitespace-nowrap flex items-center gap-1.5"
              >
                <span>Changelogs</span>
                <span class="px-1.5 py-0.5 rounded-full bg-slate-200 dark:bg-slate-800 text-[10px] font-mono">{changelogs.length}</span>
              </a>
            )}
            <a
              href="#inquire"
              class="ml-auto px-4 py-2 rounded-xl text-xs font-bold bg-primary/10 hover:bg-primary text-primary hover:text-white transition whitespace-nowrap"
            >
              Request Customization
            </a>
          </div>

          <!-- Section: Architectural Overview -->
          <section id="overview" class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl">
            <div class="flex items-center gap-3 pb-5 mb-6 border-b border-slate-200 dark:border-slate-800">
              <span class="p-2.5 rounded-2xl bg-primary/10 text-primary">
                <i data-lucide="layers" class="w-6 h-6"></i>
              </span>
              <div>
                <h2 class="text-2xl font-black font-heading text-slate-900 dark:text-white tracking-tight">
                  Architectural Overview
                </h2>
                <p class="text-xs text-slate-500 font-mono">System breakdown &amp; core capabilities</p>
              </div>
            </div>

            <Prose class="max-w-none text-slate-700 dark:text-slate-300 leading-relaxed text-sm sm:text-base">
              <div set:html={product.description} />
            </Prose>
          </section>

          <!-- Section: Key Capabilities -->
          {product.features && (
            <section id="features" class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl">
              <div class="flex items-center gap-3 pb-5 mb-6 border-b border-slate-200 dark:border-slate-800">
                <span class="p-2.5 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                  <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                </span>
                <div>
                  <h2 class="text-2xl font-black font-heading text-slate-900 dark:text-white tracking-tight">
                    Key Capabilities &amp; Features
                  </h2>
                  <p class="text-xs text-slate-500 font-mono">Highlights &amp; performance specs</p>
                </div>
              </div>

              {typeof product.features === "string" ? (
                <Prose class="text-sm sm:text-base text-slate-700 dark:text-slate-300 max-w-none" set:html={product.features} />
              ) : Array.isArray(product.features) ? (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {product.features.map((feature: any) => (
                    <div class="flex items-start gap-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800/80">
                      <div class="p-1 rounded-full bg-primary/10 text-primary shrink-0 mt-0.5">
                        <i data-lucide="check" class="w-4 h-4"></i>
                      </div>
                      <span class="text-sm text-slate-800 dark:text-slate-200 leading-relaxed font-medium" set:html={feature} />
                    </div>
                  ))}
                </div>
              ) : null}
            </section>
          )}

          <!-- Section: Companion Modules & Add-ons -->
          {addons.length > 0 && (
            <section id="addons" class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl space-y-6">
              <div class="flex items-center justify-between flex-wrap gap-4 pb-5 border-b border-slate-200 dark:border-slate-800">
                <div class="flex items-center gap-3">
                  <span class="p-2.5 rounded-2xl bg-primary/10 text-primary">
                    <i data-lucide="puzzle" class="w-6 h-6"></i>
                  </span>
                  <div>
                    <h2 class="text-2xl font-black font-heading text-slate-900 dark:text-white tracking-tight">
                      Companion Add-ons &amp; Modules
                    </h2>
                    <p class="text-xs text-slate-500 font-mono">Extend functionality with drop-in enhancements</p>
                  </div>
                </div>
                <span class="px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-mono font-bold">
                  {addons.length} {addons.length === 1 ? "module" : "modules"} available
                </span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {addons.map((addon) => (
                  <div class="bg-slate-50/80 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 hover:border-primary/50 dark:hover:border-primary/40 rounded-3xl p-5 flex flex-col justify-between transition-all duration-300 group shadow-sm hover:shadow-xl">
                    <div>
                      {addon.thumbnailUrl ? (
                        <div class="rounded-2xl overflow-hidden mb-4 border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-48 relative">
                          <img
                            src={addon.thumbnailUrl}
                            alt={addon.name}
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            loading="lazy"
                          />
                        </div>
                      ) : (
                        <div class="rounded-2xl mb-4 border border-dashed border-slate-300 dark:border-slate-800 bg-slate-100/50 dark:bg-slate-900/50 aspect-video max-h-36 flex items-center justify-center text-slate-400">
                          <i data-lucide="puzzle" class="w-8 h-8 opacity-40"></i>
                        </div>
                      )}

                      <div class="flex items-start justify-between gap-3 mb-2.5">
                        <h3 class="font-bold text-lg text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                          {addon.name}
                        </h3>
                        {addon.isFree ? (
                          <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-bold uppercase tracking-wider shrink-0 font-mono">
                            Free
                          </span>
                        ) : addon.price ? (
                          <span class="px-3 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20 text-xs font-black font-mono shrink-0">
                            ${parseFloat(addon.price).toFixed(2)}
                          </span>
                        ) : null}
                      </div>

                      {addon.description && (
                        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 mb-4">
                          {addon.description}
                        </p>
                      )}

                      <!-- Add-on Screenshots Mini Gallery -->
                      {addon.gallery && addon.gallery.length > 0 && (
                        <div class="mb-4 pt-3 border-t border-slate-200 dark:border-slate-800/60">
                          <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-2 uppercase tracking-wider flex items-center gap-1.5 font-mono">
                            <i data-lucide="camera" class="w-3.5 h-3.5 text-primary"></i>
                            <span>Module Gallery ({addon.gallery.length})</span>
                          </div>
                          <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-thin">
                            {addon.gallery.map((img) => (
                              <a
                                href={img.url || "#"}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="w-16 h-12 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800 hover:border-primary shrink-0 transition"
                                title={img.caption || addon.name}
                              >
                                <img src={img.url || ""} alt="Screenshot" class="w-full h-full object-cover" loading="lazy" />
                              </a>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>

                    <div class="flex items-center gap-2 pt-3 border-t border-slate-200 dark:border-slate-800/80 mt-auto">
                      {addon.buyUrl && (
                        <a
                          href={addon.buyUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex-1 py-2.5 px-3 bg-primary hover:bg-orange-600 text-white rounded-xl text-xs font-bold text-center shadow-md shadow-primary/20 transition flex items-center justify-center gap-1.5"
                        >
                          <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                          <span>Get Add-on</span>
                        </a>
                      )}
                      {addon.demoUrl && (
                        <a
                          href={addon.demoUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="py-2.5 px-3 bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 rounded-xl text-xs font-semibold transition flex items-center justify-center gap-1.5"
                        >
                          <i data-lucide="play-circle" class="w-3.5 h-3.5 text-emerald-500"></i>
                          <span>Demo</span>
                        </a>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Section: Version History & Changelogs -->
          {changelogs.length > 0 && (
            <section id="changelogs" class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl space-y-6">
              <div class="flex items-center justify-between flex-wrap gap-4 pb-5 border-b border-slate-200 dark:border-slate-800">
                <div class="flex items-center gap-3">
                  <span class="p-2.5 rounded-2xl bg-primary/10 text-primary">
                    <i data-lucide="history" class="w-6 h-6"></i>
                  </span>
                  <div>
                    <h2 class="text-2xl font-black font-heading text-slate-900 dark:text-white tracking-tight">
                      Version History &amp; Changelogs
                    </h2>
                    <p class="text-xs text-slate-500 font-mono">Continuous delivery &amp; release updates</p>
                  </div>
                </div>
                <span class="px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono font-semibold">
                  {changelogs.length} {changelogs.length === 1 ? "release" : "releases"}
                </span>
              </div>

              <div class="relative pl-6 space-y-8 before:absolute before:left-2.5 before:top-3 before:bottom-3 before:w-0.5 before:bg-slate-200 dark:before:bg-slate-800">
                {changelogs.map((log) => (
                  <div class="relative group">
                    <!-- Timeline Dot -->
                    <div class="absolute -left-[27px] top-1.5 w-3.5 h-3.5 rounded-full bg-primary ring-4 ring-white dark:ring-slate-900"></div>

                    <div class="p-5 rounded-2xl bg-slate-50/80 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 group-hover:border-slate-300 dark:group-hover:border-slate-700 transition">
                      <div class="flex items-center justify-between flex-wrap gap-2 mb-3 pb-2.5 border-b border-slate-200 dark:border-slate-800">
                        <div class="flex items-center gap-2">
                          <span class="px-2.5 py-0.5 rounded-lg bg-primary/10 text-primary border border-primary/20 text-xs font-mono font-black">
                            {log.version || product.version || "Release"}
                          </span>
                          <span class="text-xs text-slate-500 font-mono">
                            {new Date(log.createdAt).toLocaleDateString("en-US", {
                              year: "numeric",
                              month: "short",
                              day: "numeric",
                            })}
                          </span>
                        </div>
                        <span class="text-[10px] uppercase font-mono tracking-wider text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
                          <i data-lucide="check" class="w-3 h-3"></i>
                          Verified Release
                        </span>
                      </div>

                      <Prose class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 max-w-none" set:html={log.content} />
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

        </div>

        <!-- Right Column: Sticky Conversion Dock (4 cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-28">

          <!-- Main Purchase / Download Card -->
          <div class="bg-white dark:bg-slate-900/90 backdrop-blur-xl border-2 border-primary/30 dark:border-primary/40 rounded-3xl p-6 sm:p-7 shadow-2xl relative overflow-hidden">
            <!-- Glow Accent -->
            <div class="absolute -top-16 -right-16 w-36 h-36 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="inline-flex items-center gap-1 text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                <i data-lucide="shield-check" class="w-4 h-4 text-emerald-500"></i>
                <span>Official Release</span>
              </span>
              <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20 text-[10px] font-mono font-bold">
                Commercial
              </span>
            </div>

            <div class="mb-6">
              <div class="text-2xl font-black font-heading text-slate-900 dark:text-white tracking-tight">
                Get Instant Access
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed">
                Full production source code, lifetime updates, and comprehensive setup documentation.
              </p>
            </div>

            <!-- Primary Action Buttons -->
            <div class="space-y-3 mb-6">
              {product.codecanyonUrl ? (
                <a
                  href={product.codecanyonUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-4 px-5 bg-gradient-to-r from-primary to-orange-500 hover:from-orange-500 hover:to-primary text-white font-black rounded-2xl text-center text-sm shadow-xl shadow-primary/30 hover:shadow-primary/50 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2 group cursor-pointer"
                >
                  <i data-lucide="shopping-bag" class="w-4 h-4 group-hover:scale-110 transition-transform"></i>
                  <span>Buy on CodeCanyon</span>
                  <i data-lucide="arrow-right" class="w-4 h-4 ml-1"></i>
                </a>
              ) : (
                <a
                  href="#inquire"
                  class="w-full py-4 px-5 bg-primary hover:bg-orange-600 text-white font-black rounded-2xl text-center text-sm shadow-xl shadow-primary/30 hover:shadow-primary/50 transition-all flex items-center justify-center gap-2"
                >
                  <i data-lucide="send" class="w-4 h-4"></i>
                  <span>Request Deployment</span>
                </a>
              )}

              {product.demoUrl && (
                <a
                  href={product.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-3 px-4 bg-slate-100 dark:bg-slate-800/90 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-bold rounded-2xl text-center text-xs border border-slate-200 dark:border-slate-700 transition flex items-center justify-center gap-2 group"
                >
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span>Explore Live Demo Sandbox</span>
                  <i data-lucide="external-link" class="w-3.5 h-3.5 opacity-60 group-hover:opacity-100 transition-opacity"></i>
                </a>
              )}

              {product.documentationUrl && (
                <a
                  href={product.documentationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2.5 px-4 bg-transparent hover:bg-slate-100 dark:hover:bg-slate-800/50 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white font-medium rounded-xl text-center text-xs transition flex items-center justify-center gap-1.5"
                >
                  <i data-lucide="file-code-2" class="w-3.5 h-3.5"></i>
                  <span>Browse Documentation</span>
                </a>
              )}
            </div>

            <!-- Specs Sheet Table -->
            <div class="pt-5 border-t border-slate-200 dark:border-slate-800/80 space-y-2.5 text-xs">
              <div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
                <span class="flex items-center gap-1.5">
                  <i data-lucide="git-branch" class="w-3.5 h-3.5 text-primary"></i>
                  <span>Version</span>
                </span>
                <span class="font-mono font-bold text-slate-900 dark:text-white">{product.version || "v1.0.0"}</span>
              </div>

              <div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
                <span class="flex items-center gap-1.5">
                  <i data-lucide="calendar" class="w-3.5 h-3.5 text-primary"></i>
                  <span>Last Updated</span>
                </span>
                <span class="font-mono text-slate-900 dark:text-white">
                  {new Date(lastUpdatedDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                </span>
              </div>

              <div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
                <span class="flex items-center gap-1.5">
                  <i data-lucide="code-2" class="w-3.5 h-3.5 text-primary"></i>
                  <span>Architecture</span>
                </span>
                <span class="font-mono font-semibold text-slate-900 dark:text-white">Full-Stack SaaS</span>
              </div>

              <div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
                <span class="flex items-center gap-1.5">
                  <i data-lucide="puzzle" class="w-3.5 h-3.5 text-primary"></i>
                  <span>Add-on Modules</span>
                </span>
                <span class="font-mono text-slate-900 dark:text-white">{addons.length} available</span>
              </div>

              <div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
                <span class="flex items-center gap-1.5">
                  <i data-lucide="headphones" class="w-3.5 h-3.5 text-primary"></i>
                  <span>Support</span>
                </span>
                <span class="text-emerald-600 dark:text-emerald-400 font-semibold">Dedicated Team</span>
              </div>
            </div>

            <!-- Assurance Checklist -->
            <div class="mt-6 pt-5 border-t border-slate-200 dark:border-slate-800 space-y-2">
              <div class="flex items-center gap-2 text-[11px] text-slate-600 dark:text-slate-400">
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0"></i>
                <span>100% Full Source Code &amp; Database Schemas</span>
              </div>
              <div class="flex items-center gap-2 text-[11px] text-slate-600 dark:text-slate-400">
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0"></i>
                <span>Free Lifetime Updates &amp; Security Patches</span>
              </div>
              <div class="flex items-center gap-2 text-[11px] text-slate-600 dark:text-slate-400">
                <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500 shrink-0"></i>
                <span>Clean Architecture, Easy to Brand &amp; Deploy</span>
              </div>
            </div>
          </div>

          <!-- Bespoke Customization Hunt Box -->
          <div id="inquire" class="bg-gradient-to-br from-slate-900 to-black text-white rounded-3xl p-6 sm:p-7 shadow-xl border border-slate-800 relative overflow-hidden">
            <div class="absolute -bottom-10 -right-10 w-28 h-28 bg-primary/30 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-2 text-primary font-mono text-xs font-bold uppercase tracking-wider mb-2">
              <i data-lucide="hammer" class="w-4 h-4"></i>
              <span>Engineering Services</span>
            </div>

            <h3 class="text-xl font-black font-heading tracking-tight mb-2">
              Need Tailored Features?
            </h3>

            <p class="text-xs text-slate-400 leading-relaxed mb-5">
              The SourceMonster team can deploy, configure, customize, and build bespoke extensions for <strong>{product.title}</strong> directly on your cloud infrastructure.
            </p>

            <a
              href={`/#contact?product=${encodeURIComponent(product.title)}`}
              class="w-full py-3 px-4 bg-white hover:bg-slate-100 text-slate-900 font-bold rounded-xl text-center text-xs shadow-md transition flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>Request Customization &rarr;</span>
            </a>
          </div>

        </div>

      </div>
    </div>
  </main>

  <Footer />

  <!-- Client-side Interactive Gallery Controller -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const mainImg = document.getElementById("main-showcase-img");
      const fullscreenBtn = document.getElementById("fullscreen-image-btn");
      const thumbBtns = document.querySelectorAll(".gallery-thumb-btn");

      if (thumbBtns.length > 0 && mainImg) {
        thumbBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            const newSrc = btn.getAttribute("data-img-src");
            if (newSrc && mainImg) {
              // Smooth cross-fade
              mainImg.style.opacity = "0.3";
              setTimeout(() => {
                mainImg.src = newSrc;
                mainImg.style.opacity = "1";
              }, 120);

              // Update active thumb ring
              thumbBtns.forEach((t) => {
                t.classList.remove("border-primary", "ring-2", "ring-primary/20", "shadow-md");
                t.classList.add("border-slate-200", "dark:border-slate-800", "opacity-75");
              });
              btn.classList.remove("border-slate-200", "dark:border-slate-800", "opacity-75");
              btn.classList.add("border-primary", "ring-2", "ring-primary/20", "shadow-md");
            }
          });
        });
      }

      if (fullscreenBtn && mainImg) {
        fullscreenBtn.addEventListener("click", () => {
          if (mainImg.src) {
            window.open(mainImg.src, "_blank");
          }
        });
      }
    });
  </script>
</BaseLayout>
