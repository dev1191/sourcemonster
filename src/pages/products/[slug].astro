---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getProductBySlug } from "../../services";

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const isAdmin = !!Astro.locals.adminUser;
const data = await getProductBySlug(slug, { allowDraft: isAdmin });

if (!data) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const { product, thumbnailUrl, galleryItems, addons } = data;
const pageTitle = product.seoTitle || `${product.title} | SourceMonster`;
---

<BaseLayout title={pageTitle}>
  <Navbar />

  <main class="pt-28 pb-24 min-h-screen transition-colors duration-200">
    <!-- Admin Preview Banner -->
    {product.status !== "published" && (
      <div class="max-w-7xl mx-auto px-4 mb-6">
        <div class="p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-700 dark:text-amber-300 text-xs flex items-center justify-between">
          <div class="flex items-center gap-2">
            <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-500 dark:text-amber-400"></i>
            <span><strong>Admin Preview:</strong> This product is currently in <strong>DRAFT</strong> mode and not visible to public visitors.</span>
          </div>
          <a href={`/admin/products/${product.id}/edit`} class="font-bold underline hover:text-amber-900 dark:hover:text-white">
            Edit in CMS &rarr;
          </a>
        </div>
      </div>
    )}

    <!-- Breadcrumb & Header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-mono">
        <a href="/" class="hover:text-primary transition">Home</a>
        <span>/</span>
        <a href="/products" class="hover:text-primary transition">Products</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white font-semibold truncate">{product.title}</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-8 pb-10 border-b border-slate-200 dark:border-slate-800">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2.5 mb-4">
            {product.version && (
              <span class="px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-xs font-mono font-medium">
                {product.version}
              </span>
            )}
            {product.isFeatured && (
              <span class="px-3 py-1 rounded-full bg-primary/10 dark:bg-primary/20 border border-primary/30 dark:border-primary/40 text-primary text-xs font-bold uppercase tracking-wider">
                Featured Item
              </span>
            )}
          </div>

          <h1 class="text-3xl sm:text-5xl font-black font-heading tracking-tight text-slate-900 dark:text-white mb-5 leading-tight">
            {product.title}
          </h1>

          <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            {product.shortDescription}
          </p>

          <!-- Technology Chips -->
          {product.technologies && product.technologies.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-6">
              {product.technologies.map((t) => (
                <span class="px-3 py-1 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 font-mono">
                  {t}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Sticky Action Box -->
        <div class="w-full lg:w-80 shrink-0 bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-xl dark:shadow-2xl space-y-4">
          <div class="text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 font-mono font-bold">
            Acquire & Implement
          </div>

          <!-- Primary CTA: CodeCanyon -->
          {product.codecanyonUrl && (
            <a
              href={product.codecanyonUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3.5 px-4 bg-primary hover:bg-orange-600 text-white font-bold rounded-2xl text-center text-sm shadow-xl shadow-primary/30 hover:shadow-primary/50 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2"
            >
              <i data-lucide="shopping-cart" class="w-4 h-4"></i>
              Buy on CodeCanyon
            </a>
          )}

          <!-- Secondary CTA: Custom Development -->
          <a
            href="#inquire"
            class="w-full py-3 px-4 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-semibold rounded-2xl text-center text-xs border border-slate-200 dark:border-slate-700 transition flex items-center justify-center gap-2"
          >
            <i data-lucide="message-square" class="w-4 h-4 text-primary"></i>
            Request Customization
          </a>

          <!-- Supporting Links -->
          <div class="pt-4 border-t border-slate-200 dark:border-slate-800/80 space-y-2">
            {product.demoUrl && (
              <a
                href={product.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between px-3 py-2 text-xs text-slate-600 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/50 transition"
              >
                <span class="flex items-center gap-2">
                  <i data-lucide="play-circle" class="w-4 h-4 text-emerald-500 dark:text-emerald-400"></i>
                  View Live Demo
                </span>
                <i data-lucide="external-link" class="w-3.5 h-3.5 opacity-60"></i>
              </a>
            )}

            {product.documentationUrl && (
              <a
                href={product.documentationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between px-3 py-2 text-xs text-slate-600 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/50 transition"
              >
                <span class="flex items-center gap-2">
                  <i data-lucide="file-text" class="w-4 h-4 text-blue-500 dark:text-blue-400"></i>
                  Documentation
                </span>
                <i data-lucide="external-link" class="w-3.5 h-3.5 opacity-60"></i>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Product Details Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Column -->
      <div class="lg:col-span-2 space-y-12">
        <!-- Main Image / Gallery -->
        {thumbnailUrl && (
          <div class="rounded-3xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl dark:shadow-2xl">
            <img
              src={thumbnailUrl}
              alt={product.title}
              class="w-full h-auto max-h-[500px] object-cover"
            />
          </div>
        )}

        <!-- Screenshots Gallery -->
        {galleryItems.length > 0 && (
          <div>
            <h2 class="text-xl font-black text-slate-900 dark:text-white tracking-tight mb-4 flex items-center gap-2">
              <i data-lucide="camera" class="w-5 h-5 text-primary"></i>
              Screenshots & Interface Preview
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {galleryItems.map((item) => (
                <div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 group">
                  <img
                    src={getPublicUrl(item.objectKey, item.disk)}
                    alt={item.caption || product.title}
                    class="w-full h-48 object-cover group-hover:scale-105 transition duration-300"
                  />
                  {item.caption && (
                    <div class="p-2.5 text-[11px] text-slate-600 dark:text-slate-400 font-mono truncate bg-white/90 dark:bg-slate-950/80 border-t border-slate-200 dark:border-slate-800">
                      {item.caption}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Full Description -->
        <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-xl dark:shadow-none rounded-3xl p-6 sm:p-8">
          <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight mb-6 flex items-center gap-2">
            <i data-lucide="layers" class="w-6 h-6 text-primary"></i>
            Architectural Overview
          </h2>
          <div class="prose dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-line text-sm sm:text-base">
            {product.description}
          </div>
        </div>

        <!-- Add-ons & Extended Modules -->
        {addons.length > 0 && (
          <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-xl dark:shadow-none rounded-3xl p-6 sm:p-8 space-y-6">
            <div class="flex items-center justify-between flex-wrap gap-3 pb-4 border-b border-slate-200 dark:border-slate-800">
              <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2.5">
                <i data-lucide="puzzle" class="w-6 h-6 text-primary"></i>
                Available Add-ons &amp; Modules
              </h2>
              <span class="text-xs uppercase tracking-wider font-mono text-slate-500 dark:text-slate-400">
                {addons.length} {addons.length === 1 ? "Module" : "Modules"} Available
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {addons.map((addon) => (
                <div class="bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800/80 hover:border-primary/40 rounded-2xl p-5 flex flex-col justify-between transition-all group overflow-hidden">
                  <div>
                    {addon.thumbnailUrl && (
                      <div class="rounded-xl overflow-hidden mb-4 border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900 aspect-video max-h-48">
                        <img
                          src={addon.thumbnailUrl}
                          alt={addon.name}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                      </div>
                    )}

                    <div class="flex items-start justify-between gap-3 mb-2">
                      <h3 class="font-bold text-base text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                        {addon.name}
                      </h3>
                      {addon.isFree ? (
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-bold uppercase tracking-wider shrink-0">
                          Free
                        </span>
                      ) : addon.price ? (
                        <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20 text-xs font-bold font-mono shrink-0">
                          ${parseFloat(addon.price).toFixed(2)}
                        </span>
                      ) : null}
                    </div>

                    {addon.description && (
                      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 mb-4">
                        {addon.description}
                      </p>
                    )}

                    {/* Addon Gallery Screenshots */}
                    {addon.gallery && addon.gallery.length > 0 && (
                      <div class="mb-4 pt-3 border-t border-slate-200 dark:border-slate-800/60">
                        <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-2 uppercase tracking-wider flex items-center gap-1.5 font-mono">
                          <i data-lucide="camera" class="w-3.5 h-3.5 text-primary"></i>
                          <span>Screenshots ({addon.gallery.length})</span>
                        </div>
                        <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-thin">
                          {addon.gallery.map((img) => (
                            <a
                              href={img.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="w-16 h-12 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800 hover:border-primary/60 shrink-0 transition"
                              title={img.caption || addon.name}
                            >
                              <img src={img.url} alt="Screenshot" class="w-full h-full object-cover" />
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>

                  <div class="flex items-center gap-2 pt-3 border-t border-slate-200 dark:border-slate-800/60 mt-auto">
                    {addon.buyUrl && (
                      <a
                        href={addon.buyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex-1 py-2 px-3 bg-primary/20 hover:bg-primary text-primary hover:text-white border border-primary/30 rounded-xl text-xs font-semibold text-center transition flex items-center justify-center gap-1.5"
                      >
                        <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                        <span>Get Addon</span>
                      </a>
                    )}
                    {addon.demoUrl && (
                      <a
                        href={addon.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="py-2 px-3 bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white rounded-xl text-xs font-semibold transition flex items-center justify-center gap-1.5"
                      >
                        <i data-lucide="play-circle" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Demo</span>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Features List -->
      <div class="space-y-8">
        {product.features && product.features.length > 0 && (
          <div class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 shadow-xl dark:shadow-none rounded-3xl p-6 sm:p-8">
            <h2 class="text-lg font-black text-slate-900 dark:text-white uppercase tracking-wider mb-6 flex items-center gap-2">
              <i data-lucide="check-circle" class="w-5 h-5 text-primary"></i>
              Key Capabilities
            </h2>
            <ul class="space-y-4">
              {product.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
                  <div class="p-1 rounded-full bg-primary/10 text-primary shrink-0 mt-0.5">
                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                  </div>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Need Customization Banner -->
        <div id="inquire" class="bg-gradient-to-br from-slate-50 to-white dark:from-slate-900 dark:to-slate-950 border border-primary/20 dark:border-primary/30 rounded-3xl p-6 sm:p-8 shadow-xl dark:shadow-2xl relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-32 h-32 bg-primary/10 rounded-full blur-2xl pointer-events-none"></div>

          <h3 class="text-xl font-black text-slate-900 dark:text-white tracking-tight mb-2">Need Custom Features?</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
            SourceMonster’s elite engineering team can deploy, customize, and extend <strong>{product.title}</strong> specifically for your business workflow.
          </p>

          <form action="/#contact" method="GET" class="space-y-3">
            <input type="hidden" name="product" value={product.title} />
            <a
              href={`/#contact?product=${encodeURIComponent(product.title)}`}
              class="w-full py-3 px-4 bg-primary hover:bg-orange-600 text-white font-bold rounded-xl text-center text-xs shadow-lg shadow-primary/25 transition block"
            >
              Start Customization Hunt &rarr;
            </a>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

