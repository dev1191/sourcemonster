---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getProductBySlug } from "../../services";
import { Prose } from "../../components/starwind/prose";
import {
  ProductHero,
  ProductGallery,
  ProductNavTabs,
  ProductAddons,
  ProductChangelogs,
  ProductSidebar,
} from "../../components/products";

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const isAdmin = !!Astro.locals.adminUser;
const data = await getProductBySlug(slug, { allowDraft: isAdmin });

if (!data) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const { product, thumbnailUrl, galleryItems, addons, changelogs = [] } = data;
const pageTitle = product.seoTitle?.trim() || `${product.title} | SourceMonster`;
const pageDescription = product.seoDescription?.trim() || product.shortDescription?.trim() || "";

// Determine latest update timestamp
const latestChangelog = changelogs.length > 0 ? changelogs[0] : null;
const lastUpdatedDate = latestChangelog?.createdAt || product.updatedAt;

// Direct WhatsApp link for instant customization request
const whatsappMessage = encodeURIComponent(`Hello SourceMonster, I am interested in customizing "${product.title}".`);
const whatsappUrl = `https://wa.me/918607248802?text=${whatsappMessage}`;

// JSON-LD structured data for Google Search rich snippets
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": product.title,
  "description": pageDescription,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "url": Astro.url.href,
  ...(thumbnailUrl ? { "image": thumbnailUrl } : {}),
  ...(product.version ? { "softwareVersion": product.version } : {}),
  ...(product.codecanyonUrl ? {
    "offers": {
      "@type": "Offer",
      "url": product.codecanyonUrl,
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
    }
  } : {}),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={thumbnailUrl}
  type="product"
>
  <!-- Schema.org Product / Software Rich Snippet -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <Navbar />

  <main class="pt-28 pb-24 min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-200">
    <!-- Hero Header & Stats Section -->
    <ProductHero
      product={product}
      addonsCount={addons.length}
      changelogsCount={changelogs.length}
      lastUpdatedDate={lastUpdatedDate}
    />

    <!-- Main Content & Sticky Conversion Dock -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: Media Showcase & Rich Details (8 cols) -->
        <div class="lg:col-span-8 space-y-10">
          <!-- Interactive Media Showcase -->
          <ProductGallery
            product={product}
            thumbnailUrl={thumbnailUrl}
            galleryItems={galleryItems}
          />

          <!-- Floating Section Navigation Bar -->
          <ProductNavTabs
            hasGallery={galleryItems.length > 0 || Boolean(thumbnailUrl)}
            galleryCount={galleryItems.filter((g) => Boolean(g.url)).length + (thumbnailUrl ? 1 : 0)}
            hasFeatures={Boolean(product.features)}
            addonsCount={addons.length}
            changelogsCount={changelogs.length}
            whatsappUrl={whatsappUrl}
          />

          <!-- Section: Architectural Overview -->
          <section id="overview" class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl">
            <div class="flex items-center gap-3 pb-5 mb-6 border-b border-slate-200 dark:border-slate-800">
              <span class="p-2.5 rounded-2xl bg-primary/10 text-primary">
                <i data-lucide="layers" class="w-6 h-6"></i>
              </span>
              <div>
                <h2 class="text-2xl font-black font-heading text-slate-900 dark:text-white tracking-tight">
                  Architectural Overview
                </h2>
                <p class="text-xs text-slate-500 font-mono">System breakdown &amp; core capabilities</p>
              </div>
            </div>

            <Prose class="max-w-none text-slate-700 dark:text-slate-300 leading-relaxed text-sm sm:text-base">
              <div set:html={product.description} />
            </Prose>
          </section>

          <!-- Section: Key Capabilities -->
          {product.features && (
            <section id="features" class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-xl">
              <div class="flex items-center gap-3 pb-5 mb-6 border-b border-slate-200 dark:border-slate-800">
                <span class="p-2.5 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                  <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                </span>
                <div>
                  <h2 class="text-2xl font-black font-heading text-slate-900 dark:text-white tracking-tight">
                    Key Capabilities &amp; Features
                  </h2>
                  <p class="text-xs text-slate-500 font-mono">Highlights &amp; performance specs</p>
                </div>
              </div>

              {typeof product.features === "string" ? (
                <Prose class="text-sm sm:text-base text-slate-700 dark:text-slate-300 max-w-none" set:html={product.features} />
              ) : Array.isArray(product.features) ? (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {product.features.map((feature: any) => (
                    <div class="flex items-start gap-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800/80">
                      <div class="p-1 rounded-full bg-primary/10 text-primary shrink-0 mt-0.5">
                        <i data-lucide="check" class="w-4 h-4"></i>
                      </div>
                      <span class="text-sm text-slate-800 dark:text-slate-200 leading-relaxed font-medium" set:html={feature} />
                    </div>
                  ))}
                </div>
              ) : null}
            </section>
          )}

          <!-- Section: Companion Modules & Add-ons -->
          <ProductAddons addons={addons} />

          <!-- Section: Version History & Changelogs -->
          <ProductChangelogs productVersion={product.version} changelogs={changelogs} />
        </div>

        <!-- Right Column: Sticky Conversion Dock (4 cols) -->
        <div class="lg:col-span-4">
          <ProductSidebar
            product={product}
            addonsCount={addons.length}
            lastUpdatedDate={lastUpdatedDate}
            whatsappUrl={whatsappUrl}
          />
        </div>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
