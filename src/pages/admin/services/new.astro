---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createService } from "../../../services";
import { slugify } from "../../../lib/utils";
import { Toast } from "../../../components/ui";

let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const title = formData.get("title")?.toString().trim() || "";
    const slug = slugify(formData.get("slug")?.toString().trim() || "");
    const description = formData.get("description")?.toString().trim() || "";
    const icon = formData.get("icon")?.toString().trim() || "code";
    const color = formData.get("color")?.toString().trim() || "primary";
    const sortOrder = parseInt(formData.get("sortOrder")?.toString() || "0", 10);
    const status = (formData.get("status")?.toString() || "published") as "published" | "draft";

    await createService({
      title,
      slug,
      description,
      icon,
      color,
      sortOrder,
      status,
    });

    return Astro.redirect("/admin/services");
  } catch (err: any) {
    console.error("Create service failed:", err);
    errorMessage = err?.message || "Failed to create service.";
  }
}
---

<AdminLayout title="Add Service | SourceMonster Admin" activeNav="services">
  <div class="flex items-center justify-between pb-6 border-b border-slate-200 dark:border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-1">
        <a href="/admin/services" class="hover:text-slate-900 dark:hover:text-white transition">Services</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white">New</span>
      </div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Add Service Offering</h1>
    </div>
  </div>

  <Toast variant="error" message={errorMessage} />

  <form method="POST" class="my-6 space-y-6 max-w-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 shadow-sm dark:shadow-xl">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Title *</label>
        <input id="title-input" name="title" type="text" required placeholder="e.g. Web Engineering" class="w-full px-4 py-2.5 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Slug *</label>
        <input id="slug-input" name="slug" type="text" required placeholder="e.g. web-engineering" class="w-full px-4 py-2.5 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-sm font-mono" />
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Description *</label>
      <textarea name="description" rows="3" required placeholder="Brief description of the service deliverables..." class="w-full px-4 py-2.5 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-sm"></textarea>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Lucide Icon Name</label>
        <input name="icon" type="text" value="code" placeholder="code, smartphone, shield, etc." class="w-full px-4 py-2.5 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-sm font-mono" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Color Accent Class</label>
        <input name="color" type="text" value="primary" placeholder="primary, indigo-600, blue-600, etc." class="w-full px-4 py-2.5 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-sm font-mono" />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Sort Order</label>
        <input name="sortOrder" type="number" value="0" class="w-full px-4 py-2.5 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-sm font-mono" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Status</label>
        <select name="status" class="w-full px-4 py-2.5 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white text-sm">
          <option value="published">Published</option>
          <option value="draft">Draft</option>
        </select>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
      <a href="/admin/services" class="px-5 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-xl text-sm font-semibold transition border border-slate-200 dark:border-slate-700/60">Cancel</a>
      <button type="submit" class="px-6 py-2.5 bg-primary hover:bg-orange-600 text-white rounded-xl text-sm font-semibold shadow-lg shadow-primary/25 transition">Save Service</button>
    </div>
  </form>

  <script>
    import { slugify } from "../../../lib/utils";

    const titleInput = document.getElementById("title-input") as HTMLInputElement | null;
    const slugInput = document.getElementById("slug-input") as HTMLInputElement | null;

    if (titleInput && slugInput) {
      titleInput.addEventListener("input", () => {
        if (!slugInput.dataset.touched) {
          slugInput.value = slugify(titleInput.value);
        }
      });
      slugInput.addEventListener("input", () => {
        slugInput.dataset.touched = "true";
      });
    }
  </script>
</AdminLayout>

