---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import {
  getServiceById,
  updateService,
  deleteService,
} from "../../../../services";

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/services");

let errorMessage = "";
let successMessage = "";

const initialService = await getServiceById(id);
if (!initialService) return Astro.redirect("/admin/services");

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("_action")?.toString();

    if (action === "delete") {
      await deleteService(id);
      return Astro.redirect("/admin/services");
    }

    const title = formData.get("title")?.toString().trim() || "";
    const slug = formData.get("slug")?.toString().trim().toLowerCase() || "";
    const description = formData.get("description")?.toString().trim() || "";
    const icon = formData.get("icon")?.toString().trim() || "code";
    const color = formData.get("color")?.toString().trim() || "primary";
    const sortOrder = parseInt(formData.get("sortOrder")?.toString() || "0", 10);
    const status = (formData.get("status")?.toString() || "published") as "published" | "draft";

    await updateService(id, {
      title,
      slug,
      description,
      icon,
      color,
      sortOrder,
      status,
    });

    successMessage = "Service updated successfully!";
  } catch (err: any) {
    console.error("Update service failed:", err);
    errorMessage = err?.message || "Failed to update service.";
  }
}

const currentService = (await getServiceById(id)) || initialService;
---

<AdminLayout title={`Edit Service: ${currentService.title} | SourceMonster Admin`} activeNav="services">
  <div class="flex items-center justify-between pb-6 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
        <a href="/admin/services" class="hover:text-white transition">Services</a>
        <span>/</span>
        <span class="text-white">Edit</span>
      </div>
      <h1 class="text-2xl font-black text-white tracking-tight">Edit Service: {currentService.title}</h1>
    </div>
    <a href="/admin/services" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-semibold transition">Back to list</a>
  </div>

  {errorMessage && (
    <div class="my-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs flex items-center gap-2">
      <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
      <span>{errorMessage}</span>
    </div>
  )}

  {successMessage && (
    <div class="my-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center gap-2">
      <i data-lucide="check-circle" class="w-4 h-4 shrink-0"></i>
      <span>{successMessage}</span>
    </div>
  )}

  <form method="POST" class="my-6 space-y-6 max-w-2xl bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Title *</label>
        <input name="title" type="text" required value={currentService.title} class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Slug *</label>
        <input name="slug" type="text" required value={currentService.slug} class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm font-mono" />
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Description *</label>
      <textarea name="description" rows="3" required class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm">{currentService.description}</textarea>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Lucide Icon Name</label>
        <input name="icon" type="text" value={currentService.icon} class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm font-mono" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Color Accent Class</label>
        <input name="color" type="text" value={currentService.color} class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm font-mono" />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Sort Order</label>
        <input name="sortOrder" type="number" value={currentService.sortOrder} class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm font-mono" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Status</label>
        <select name="status" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm">
          <option value="published" selected={currentService.status === "published"}>Published</option>
          <option value="draft" selected={currentService.status === "draft"}>Draft</option>
        </select>
      </div>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-slate-800">
      <button
        type="submit"
        name="_action"
        value="delete"
        onclick="return confirm('Permanently delete this service?');"
        class="px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-xl text-xs font-semibold transition"
      >
        Delete Service
      </button>

      <div class="flex items-center gap-3">
        <a href="/admin/services" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm font-semibold transition">Cancel</a>
        <button type="submit" name="_action" value="update" class="px-6 py-2.5 bg-primary hover:bg-orange-600 text-white rounded-xl text-sm font-semibold shadow-lg shadow-primary/25 transition">Save Changes</button>
      </div>
    </div>
  </form>
</AdminLayout>

