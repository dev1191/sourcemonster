---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../lib/db";
import { services } from "../../../lib/db/schema";
import { desc } from "drizzle-orm";

let allServices: Array<typeof services.$inferSelect> = [];
try {
  allServices = await db.select().from(services).orderBy(desc(services.sortOrder), services.createdAt);
} catch (e) {
  console.error("Failed to load services:", e);
}
---

<AdminLayout title="Services | SourceMonster Admin" activeNav="services">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">Services & Specializations</h1>
      <p class="text-xs text-slate-400 mt-1">Manage public digital solutions, core capabilities, and service offerings.</p>
    </div>
    <a
      href="/admin/services/new"
      class="inline-flex items-center gap-2 px-4 py-2 bg-primary hover:bg-orange-600 text-white rounded-xl text-xs font-semibold shadow-md shadow-primary/20 transition"
    >
      <i data-lucide="plus" class="w-4 h-4"></i>
      Add Service
    </a>
  </div>

  <div class="my-6 bg-slate-900/70 border border-slate-800/80 rounded-2xl overflow-hidden shadow-xl shadow-black/40">
    {allServices.length === 0 ? (
      <div class="py-16 text-center text-slate-500 text-xs">
        <i data-lucide="layers" class="w-12 h-12 mx-auto mb-3 text-slate-600"></i>
        <div class="font-semibold text-slate-300 text-sm">No services in database</div>
        <div class="mt-1">Run `pnpm db:seed:content` to import existing static services.</div>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950/80 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
            <tr>
              <th class="px-4 py-3.5">Service</th>
              <th class="px-4 py-3.5">Icon</th>
              <th class="px-4 py-3.5">Color Accent</th>
              <th class="px-4 py-3.5">Sort Order</th>
              <th class="px-4 py-3.5">Status</th>
              <th class="px-4 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            {allServices.map((s) => (
              <tr class="hover:bg-slate-800/30 transition">
                <td class="px-4 py-3.5">
                  <div class="font-bold text-white text-sm">{s.title}</div>
                  <div class="text-[11px] text-slate-500 line-clamp-1 max-w-sm">{s.description}</div>
                </td>
                <td class="px-4 py-3.5">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-800 font-mono text-slate-300">
                    <i data-lucide={s.icon} class="w-3.5 h-3.5 text-primary"></i>
                    {s.icon}
                  </span>
                </td>
                <td class="px-4 py-3.5 font-mono text-slate-400">
                  {s.color}
                </td>
                <td class="px-4 py-3.5 font-mono text-slate-400">
                  {s.sortOrder}
                </td>
                <td class="px-4 py-3.5">
                  <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase ${
                    s.status === "published"
                      ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                      : "bg-slate-800 text-slate-400 border border-slate-700"
                  }`}>
                    {s.status}
                  </span>
                </td>
                <td class="px-4 py-3.5 text-right">
                  <a
                    href={`/admin/services/${s.id}/edit`}
                    class="p-1.5 text-slate-400 hover:text-primary rounded-lg hover:bg-slate-800 transition"
                    title="Edit Service"
                  >
                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

