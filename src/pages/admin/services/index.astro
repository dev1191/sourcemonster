---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAllServices } from "../../../services";
import {
  Table,
  TableHeader,
  TableBody,
  TableHead,
  TableRow,
  TableCell,
} from "../../../components/ui";

const allServices = await getAllServices();
---

<AdminLayout title="Services | SourceMonster Admin" activeNav="services">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Services & Specializations</h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Manage public digital solutions, core capabilities, and service offerings.</p>
    </div>
    <a
      href="/admin/services/new"
      class="inline-flex items-center gap-2 px-4 py-2 bg-primary hover:bg-orange-600 text-white rounded-xl text-xs font-semibold shadow-md shadow-primary/20 transition"
    >
      <i data-lucide="plus" class="w-4 h-4"></i>
      Add Service
    </a>
  </div>

  <Table
    isEmpty={allServices.length === 0}
    emptyIcon="layers"
    emptyTitle="No services in database"
    emptySubtitle="Run `pnpm db:seed:content` to import existing static services."
    searchable={true}
    searchPlaceholder="Search services by title or description..."
    containerClass="my-6"
  >
    <TableHeader class="bg-slate-50 dark:bg-slate-950/80 text-[11px] uppercase tracking-wider text-slate-600 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
      <TableRow class="border-b border-slate-200 dark:border-slate-800 hover:bg-transparent">
        <TableHead class="px-4 py-3.5 text-slate-600 dark:text-slate-400 font-semibold">Service</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-600 dark:text-slate-400 font-semibold">Icon</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-600 dark:text-slate-400 font-semibold">Color Accent</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-600 dark:text-slate-400 font-semibold">Sort Order</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-600 dark:text-slate-400 font-semibold">Status</TableHead>
        <TableHead class="px-4 py-3.5 text-right text-slate-600 dark:text-slate-400 font-semibold">Actions</TableHead>
      </TableRow>
    </TableHeader>
    <TableBody class="divide-y divide-slate-200 dark:divide-slate-800/60">
      {allServices.map((s) => (
        <TableRow class="hover:bg-slate-50/80 dark:hover:bg-slate-800/30 transition border-b border-slate-200 dark:border-slate-800/60">
          <TableCell class="px-4 py-3.5">
            <div class="font-bold text-slate-900 dark:text-white text-sm">{s.title}</div>
            <div class="text-[11px] text-slate-500 line-clamp-1 max-w-sm">{s.description}</div>
          </TableCell>
          <TableCell class="px-4 py-3.5">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 font-mono text-slate-700 dark:text-slate-300">
              <i data-lucide={s.icon} class="w-3.5 h-3.5 text-primary"></i>
              {s.icon}
            </span>
          </TableCell>
          <TableCell class="px-4 py-3.5 font-mono text-slate-500 dark:text-slate-400">
            {s.color}
          </TableCell>
          <TableCell class="px-4 py-3.5 font-mono text-slate-500 dark:text-slate-400">
            {s.sortOrder}
          </TableCell>
          <TableCell class="px-4 py-3.5">
            <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase ${
              s.status === "published"
                ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"
                : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700"
            }`}>
              {s.status}
            </span>
          </TableCell>
          <TableCell class="px-4 py-3.5 text-right">
            <a
              href={`/admin/services/${s.id}/edit`}
              class="p-1.5 text-slate-400 hover:text-primary rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition"
              title="Edit Service"
            >
              <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
            </a>
          </TableCell>
        </TableRow>
      ))}
    </TableBody>
  </Table>
</AdminLayout>

