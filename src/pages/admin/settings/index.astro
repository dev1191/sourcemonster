---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getSiteSettings, updateSiteSettings } from "../../../lib/settings";
import { Card, CardHeader, CardTitle, CardContent } from "../../../components/starwind/card";
import { Input } from "../../../components/starwind/input";
import { Textarea } from "../../../components/starwind/textarea";
import { Button } from "../../../components/starwind/button";
import { Alert, AlertDescription } from "../../../components/starwind/alert";

let successMessage = "";
let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const updates = {
      site_name: formData.get("site_name")?.toString().trim(),
      contact_email: formData.get("contact_email")?.toString().trim(),
      contact_phone: formData.get("contact_phone")?.toString().trim(),
      whatsapp_number: formData.get("whatsapp_number")?.toString().trim(),
      social_twitter: formData.get("social_twitter")?.toString().trim(),
      social_github: formData.get("social_github")?.toString().trim(),
      social_linkedin: formData.get("social_linkedin")?.toString().trim(),
      seo_default_title: formData.get("seo_default_title")?.toString().trim(),
      seo_default_description: formData.get("seo_default_description")?.toString().trim(),
      footer_copyright: formData.get("footer_copyright")?.toString().trim(),
    };

    await updateSiteSettings(updates);
    successMessage = "Site settings updated successfully!";
  } catch (err) {
    console.error("Failed to update site settings:", err);
    errorMessage = "Failed to save settings. Please try again.";
  }
}

const settings = await getSiteSettings();
---

<AdminLayout title="Site Settings | SourceMonster Admin" activeNav="settings">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">Global Site Settings</h1>
      <p class="text-xs text-slate-400 mt-1">Configure platform parameters, contact channels, social networks, and SEO defaults.</p>
    </div>
  </div>

  {successMessage && (
    <div class="my-6">
      <Alert variant="success">
        <i data-lucide="check-circle" class="w-4 h-4 shrink-0 mr-2"></i>
        <AlertDescription>{successMessage}</AlertDescription>
      </Alert>
    </div>
  )}

  {errorMessage && (
    <div class="my-6">
      <Alert variant="error">
        <i data-lucide="alert-circle" class="w-4 h-4 shrink-0 mr-2"></i>
        <AlertDescription>{errorMessage}</AlertDescription>
      </Alert>
    </div>
  )}

  <form method="POST" class="my-6 space-y-6 max-w-4xl">
    <!-- Brand & Identity Card -->
    <Card class="bg-slate-900/70 border-slate-800/80 rounded-2xl shadow-xl">
      <CardHeader>
        <CardTitle class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-2">
          <i data-lucide="shield" class="w-4 h-4"></i>
          Brand & General Identity
        </CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Platform Brand Name
            </label>
            <Input
              name="site_name"
              type="text"
              required
              value={settings.site_name}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Footer Copyright Text
            </label>
            <Input
              name="footer_copyright"
              type="text"
              required
              value={settings.footer_copyright}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>
      </CardContent>
    </Card>

    <!-- Communication & Contact Channels Card -->
    <Card class="bg-slate-900/70 border-slate-800/80 rounded-2xl shadow-xl">
      <CardHeader>
        <CardTitle class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-2">
          <i data-lucide="phone-call" class="w-4 h-4"></i>
          Contact Channels & Notifications
        </CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-2">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Primary Email
            </label>
            <Input
              name="contact_email"
              type="email"
              required
              value={settings.contact_email}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Public Phone Number
            </label>
            <Input
              name="contact_phone"
              type="text"
              value={settings.contact_phone}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              WhatsApp Direct Number
            </label>
            <Input
              name="whatsapp_number"
              type="text"
              value={settings.whatsapp_number}
              placeholder="e.g. 918607248802"
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 font-mono rounded-xl"
            />
          </div>
        </div>
      </CardContent>
    </Card>

    <!-- Social Profiles Card -->
    <Card class="bg-slate-900/70 border-slate-800/80 rounded-2xl shadow-xl">
      <CardHeader>
        <CardTitle class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-2">
          <i data-lucide="share-2" class="w-4 h-4"></i>
          Social Network Profiles
        </CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-2">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Twitter / X Profile
            </label>
            <Input
              name="social_twitter"
              type="url"
              value={settings.social_twitter}
              placeholder="https://x.com/..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              GitHub Organization
            </label>
            <Input
              name="social_github"
              type="url"
              value={settings.social_github}
              placeholder="https://github.com/..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              LinkedIn Company
            </label>
            <Input
              name="social_linkedin"
              type="url"
              value={settings.social_linkedin}
              placeholder="https://linkedin.com/company/..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>
      </CardContent>
    </Card>

    <!-- SEO Defaults Card -->
    <Card class="bg-slate-900/70 border-slate-800/80 rounded-2xl shadow-xl">
      <CardHeader>
        <CardTitle class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-2">
          <i data-lucide="search" class="w-4 h-4"></i>
          Global SEO Defaults
        </CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-2">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Default Meta Title
          </label>
          <Input
            name="seo_default_title"
            type="text"
            value={settings.seo_default_title}
            class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Default Meta Description
          </label>
          <Textarea
            name="seo_default_description"
            rows={3}
            value={settings.seo_default_description}
            class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 leading-relaxed rounded-xl"
          />
        </div>
      </CardContent>
    </Card>

    <div class="flex items-center justify-end gap-3 pt-4">
      <Button
        type="submit"
        variant="primary"
        size="md"
        class="bg-primary hover:bg-orange-600 text-white shadow-lg shadow-primary/25"
      >
        Save Site Settings
      </Button>
    </div>
  </form>
</AdminLayout>
