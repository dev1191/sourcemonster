---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Site Settings | SourceMonster Admin" activeNav="settings">
  <div class="flex items-center justify-between pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">Site Settings</h1>
      <p class="text-xs text-slate-400 mt-1">Configure global platform options and contact parameters.</p>
    </div>
  </div>

  <div class="my-6 max-w-2xl bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">
          Brand Name
        </label>
        <input
          type="text"
          value="Source Monster"
          disabled
          class="w-full px-4 py-2 bg-slate-950/60 border border-slate-800 rounded-xl text-slate-400 text-sm cursor-not-allowed"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">
          Default Notification Email
        </label>
        <input
          type="email"
          value="contact@sourcemonster.in"
          disabled
          class="w-full px-4 py-2 bg-slate-950/60 border border-slate-800 rounded-xl text-slate-400 text-sm cursor-not-allowed"
        />
      </div>

      <div class="p-4 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-300 text-xs">
        <i data-lucide="info" class="w-4 h-4 inline mr-1 text-blue-400"></i>
        Dynamic editable site settings table will be activated in Phase 6 as per the implementation plan.
      </div>
    </div>
  </div>
</AdminLayout>

