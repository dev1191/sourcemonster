---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getSiteSettings, updateSiteSettings } from "../../../lib/settings";

let successMessage = "";
let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const updates = {
      site_name: formData.get("site_name")?.toString().trim(),
      contact_email: formData.get("contact_email")?.toString().trim(),
      contact_phone: formData.get("contact_phone")?.toString().trim(),
      whatsapp_number: formData.get("whatsapp_number")?.toString().trim(),
      social_twitter: formData.get("social_twitter")?.toString().trim(),
      social_github: formData.get("social_github")?.toString().trim(),
      social_linkedin: formData.get("social_linkedin")?.toString().trim(),
      seo_default_title: formData.get("seo_default_title")?.toString().trim(),
      seo_default_description: formData.get("seo_default_description")?.toString().trim(),
      footer_copyright: formData.get("footer_copyright")?.toString().trim(),
    };

    await updateSiteSettings(updates);
    successMessage = "Site settings updated successfully!";
  } catch (err) {
    console.error("Failed to update site settings:", err);
    errorMessage = "Failed to save settings. Please try again.";
  }
}

const settings = await getSiteSettings();
---

<AdminLayout title="Site Settings | SourceMonster Admin" activeNav="settings">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">Global Site Settings</h1>
      <p class="text-xs text-slate-400 mt-1">Configure platform parameters, contact channels, social networks, and SEO defaults.</p>
    </div>
  </div>

  {successMessage && (
    <div class="my-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center gap-2">
      <i data-lucide="check-circle" class="w-4 h-4 shrink-0"></i>
      <span>{successMessage}</span>
    </div>
  )}

  {errorMessage && (
    <div class="my-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs flex items-center gap-2">
      <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
      <span>{errorMessage}</span>
    </div>
  )}

  <form method="POST" class="my-6 space-y-6 max-w-4xl">
    <!-- Brand & Identity -->
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6 space-y-4">
      <h2 class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-2">
        <i data-lucide="shield" class="w-4 h-4"></i>
        Brand & General Identity
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Platform Brand Name
          </label>
          <input
            name="site_name"
            type="text"
            required
            value={settings.site_name}
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Footer Copyright Text
          </label>
          <input
            name="footer_copyright"
            type="text"
            required
            value={settings.footer_copyright}
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>
      </div>
    </div>

    <!-- Communication & Contact Channels -->
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6 space-y-4">
      <h2 class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-2">
        <i data-lucide="phone-call" class="w-4 h-4"></i>
        Contact Channels & Notifications
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Primary Email
          </label>
          <input
            name="contact_email"
            type="email"
            required
            value={settings.contact_email}
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Public Phone Number
          </label>
          <input
            name="contact_phone"
            type="text"
            value={settings.contact_phone}
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            WhatsApp Direct Number
          </label>
          <input
            name="whatsapp_number"
            type="text"
            value={settings.whatsapp_number}
            placeholder="e.g. 918607248802"
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary font-mono"
          />
        </div>
      </div>
    </div>

    <!-- Social Profiles -->
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6 space-y-4">
      <h2 class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-2">
        <i data-lucide="share-2" class="w-4 h-4"></i>
        Social Network Profiles
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Twitter / X Profile
          </label>
          <input
            name="social_twitter"
            type="url"
            value={settings.social_twitter}
            placeholder="https://x.com/..."
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            GitHub Organization
          </label>
          <input
            name="social_github"
            type="url"
            value={settings.social_github}
            placeholder="https://github.com/..."
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            LinkedIn Company
          </label>
          <input
            name="social_linkedin"
            type="url"
            value={settings.social_linkedin}
            placeholder="https://linkedin.com/company/..."
            class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>
      </div>
    </div>

    <!-- SEO Defaults -->
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6 space-y-4">
      <h2 class="text-xs font-bold text-primary uppercase tracking-wider flex items-center gap-2">
        <i data-lucide="search" class="w-4 h-4"></i>
        Global SEO Defaults
      </h2>

      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
          Default Meta Title
        </label>
        <input
          name="seo_default_title"
          type="text"
          value={settings.seo_default_title}
          class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
          Default Meta Description
        </label>
        <textarea
          name="seo_default_description"
          rows="3"
          class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary leading-relaxed"
        >{settings.seo_default_description}</textarea>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3 pt-4">
      <button
        type="submit"
        class="px-6 py-2.5 bg-primary hover:bg-orange-600 text-white rounded-xl text-sm font-semibold shadow-lg shadow-primary/25 transition"
      >
        Save Site Settings
      </button>
    </div>
  </form>
</AdminLayout>
