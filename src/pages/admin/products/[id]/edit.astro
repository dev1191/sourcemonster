---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { db } from "../../../../lib/db";
import { products, media, productMedia, productAddons } from "../../../../lib/db/schema";
import { eq } from "drizzle-orm";
import { productSchema } from "../../../../lib/validation/product";
import { uploadFile, getPublicUrl } from "../../../../lib/storage";
import { Button, Dropzone, FeedbackAlert } from "../../../../components/ui";
import { Card, CardHeader, CardTitle, CardContent } from "../../../../components/starwind/card";
import { Input } from "../../../../components/starwind/input";
import { Textarea } from "../../../../components/starwind/textarea";
import { NativeSelect, NativeSelectOption } from "../../../../components/starwind/native-select";
import { Badge } from "../../../../components/starwind/badge";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/products");
}

let errorMessage = "";
let successMessage = "";

// Fetch product
const [existingProduct] = await db
  .select()
  .from(products)
  .where(eq(products.id, id))
  .limit(1);

if (!existingProduct) {
  return Astro.redirect("/admin/products");
}

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("_action")?.toString();

    if (action === "delete") {
      await db.delete(products).where(eq(products.id, id));
      return Astro.redirect("/admin/products");
    }

    if (action === "delete_gallery_image") {
      const pmId = formData.get("product_media_id")?.toString();
      if (pmId) {
        await db.delete(productMedia).where(eq(productMedia.id, pmId));
        return Astro.redirect(`/admin/products/${id}/edit`);
      }
    }

    // ── Addon actions ──────────────────────────────────────────────────────
    if (action === "add_addon") {
      const addonName = formData.get("addon_name")?.toString().trim() || "";
      const addonDesc = formData.get("addon_description")?.toString().trim() || "";
      const addonPriceRaw = formData.get("addon_price")?.toString().trim();
      const addonIsFree = formData.get("addon_is_free") === "on";
      const addonBuyUrl = formData.get("addon_buy_url")?.toString().trim() || null;
      const addonDemoUrl = formData.get("addon_demo_url")?.toString().trim() || null;

      if (addonName) {
        await db.insert(productAddons).values({
          productId: id,
          name: addonName,
          description: addonDesc,
          price: addonIsFree || !addonPriceRaw ? null : addonPriceRaw,
          isFree: addonIsFree,
          buyUrl: addonBuyUrl || null,
          demoUrl: addonDemoUrl || null,
          sortOrder: 0,
        });
        successMessage = `Addon "${addonName}" added.`;
      }
      return Astro.redirect(`/admin/products/${id}/edit`);
    }

    if (action === "delete_addon") {
      const addonId = formData.get("addon_id")?.toString();
      if (addonId) {
        await db.delete(productAddons).where(eq(productAddons.id, addonId));
      }
      return Astro.redirect(`/admin/products/${id}/edit`);
    }

    const title = formData.get("title")?.toString().trim() || "";
    const slug = formData.get("slug")?.toString().trim().toLowerCase() || "";
    const shortDescription = formData.get("shortDescription")?.toString().trim() || "";
    const description = formData.get("description")?.toString().trim() || "";
    const codecanyonUrl = formData.get("codecanyonUrl")?.toString().trim() || "";
    const demoUrl = formData.get("demoUrl")?.toString().trim() || "";
    const documentationUrl = formData.get("documentationUrl")?.toString().trim() || "";
    const version = formData.get("version")?.toString().trim() || "";
    const status = (formData.get("status")?.toString() || "draft") as "draft" | "published";
    const isFeatured = formData.get("isFeatured") === "on";
    const sortOrder = parseInt(formData.get("sortOrder")?.toString() || "0", 10);
    const seoTitle = formData.get("seoTitle")?.toString().trim() || "";
    const seoDescription = formData.get("seoDescription")?.toString().trim() || "";

    const rawTech = formData.get("technologies")?.toString() || "";
    const technologies = rawTech
      .split(/[,\n]/)
      .map((t) => t.trim())
      .filter(Boolean);

    const rawFeatures = formData.get("features")?.toString() || "";
    const features = rawFeatures
      .split("\n")
      .map((f) => f.trim())
      .filter(Boolean);

    // Validate using Zod
    const validationResult = productSchema.safeParse({
      title,
      slug,
      shortDescription,
      description,
      codecanyonUrl,
      demoUrl,
      documentationUrl,
      version,
      technologies,
      features,
      status,
      isFeatured,
      sortOrder,
      seoTitle,
      seoDescription,
    });

    if (!validationResult.success) {
      errorMessage = Object.values(validationResult.error.flatten().fieldErrors)
        .flat()
        .join("; ");
    } else {
      // Check slug uniqueness excluding self
      const [duplicateSlug] = await db
        .select()
        .from(products)
        .where(eq(products.slug, slug))
        .limit(1);

      if (duplicateSlug && duplicateSlug.id !== id) {
        errorMessage = `The slug "${slug}" is already used by another product.`;
      } else {
        let thumbnailMediaId = existingProduct.thumbnailMediaId;
        const thumbnailFile = formData.get("thumbnail") as File | null;

        if (thumbnailFile && thumbnailFile.size > 0) {
          const uploadRes = await uploadFile(
            thumbnailFile,
            thumbnailFile.name,
            thumbnailFile.type
          );

          const [newMedia] = await db
            .insert(media)
            .values({
              disk: uploadRes.disk,
              objectKey: uploadRes.objectKey,
              originalName: uploadRes.originalName,
              mimeType: uploadRes.mimeType,
              sizeBytes: uploadRes.sizeBytes,
              altText: title,
            })
            .returning();

          thumbnailMediaId = newMedia.id;
        }

        // Check for new gallery screenshot upload
        const screenshotFile = formData.get("screenshot") as File | null;
        if (screenshotFile && screenshotFile.size > 0) {
          const uploadRes = await uploadFile(
            screenshotFile,
            screenshotFile.name,
            screenshotFile.type
          );

          const [newMedia] = await db
            .insert(media)
            .values({
              disk: uploadRes.disk,
              objectKey: uploadRes.objectKey,
              originalName: uploadRes.originalName,
              mimeType: uploadRes.mimeType,
              sizeBytes: uploadRes.sizeBytes,
              altText: `${title} Screenshot`,
            })
            .returning();

          await db.insert(productMedia).values({
            productId: id,
            mediaId: newMedia.id,
            displayOrder: 0,
          });
        }

        await db
          .update(products)
          .set({
            title,
            slug,
            shortDescription,
            description,
            thumbnailMediaId,
            codecanyonUrl: codecanyonUrl || null,
            demoUrl: demoUrl || null,
            documentationUrl: documentationUrl || null,
            version: version || null,
            technologies,
            features,
            status,
            isFeatured,
            sortOrder,
            seoTitle: seoTitle || null,
            seoDescription: seoDescription || null,
            publishedAt:
              status === "published"
                ? existingProduct.publishedAt || new Date()
                : null,
            updatedAt: new Date(),
          })
          .where(eq(products.id, id));

        successMessage = "Product updated successfully!";
      }
    }
  } catch (err) {
    console.error("Update product failed:", err);
    errorMessage = "Failed to update product.";
  }
}

// Re-query product & media for rendering
const [product] = await db
  .select()
  .from(products)
  .where(eq(products.id, id))
  .limit(1);

let currentThumbnailUrl: string | null = null;
if (product.thumbnailMediaId) {
  const [m] = await db
    .select()
    .from(media)
    .where(eq(media.id, product.thumbnailMediaId))
    .limit(1);
  if (m) {
    currentThumbnailUrl = getPublicUrl(m.objectKey, m.disk);
  }
}

// Query gallery screenshots
const galleryItems = await db
  .select({
    productMediaId: productMedia.id,
    mediaId: media.id,
    objectKey: media.objectKey,
    disk: media.disk,
    caption: productMedia.caption,
  })
  .from(productMedia)
  .innerJoin(media, eq(productMedia.mediaId, media.id))
  .where(eq(productMedia.productId, id));

// Query add-ons / modules for this product
const addons = await db
  .select()
  .from(productAddons)
  .where(eq(productAddons.productId, id))
  .orderBy(productAddons.sortOrder, productAddons.createdAt);
---

<AdminLayout title={`Edit ${product.title} | SourceMonster Admin`} activeNav="products">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
        <a href="/admin/products" class="hover:text-white transition">Products</a>
        <span>/</span>
        <span class="text-white">Edit</span>
      </div>
      <h1 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
        <span>Edit Product:</span>
        <span class="text-primary truncate">{product.title}</span>
      </h1>
    </div>

    <div class="flex items-center gap-2">
      {product.status === "published" && (
        <Button
          href={`/products/${product.slug}`}
          target="_blank"
          variant="secondary"
          size="sm"
          icon="external-link"
        >
          View Public Page
        </Button>
      )}
      <Button href="/admin/products" variant="secondary" size="sm">Back to list</Button>
    </div>
  </div>

  <FeedbackAlert variant="error" message={errorMessage} />
  <FeedbackAlert variant="success" message={successMessage} />

  <form method="POST" enctype="multipart/form-data" class="my-6 space-y-6 max-w-4xl">
    <input type="hidden" name="_action" value="update" />

    <!-- Basic Info Card -->
    <Card class="bg-slate-900/70 border-slate-800/80 rounded-2xl shadow-xl">
      <CardHeader>
        <CardTitle class="text-sm font-bold text-primary uppercase tracking-wider">Basic Info</CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Product Title *
            </label>
            <Input
              name="title"
              type="text"
              required
              value={product.title}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              URL Slug *
            </label>
            <Input
              name="slug"
              type="text"
              required
              value={product.slug}
              class="bg-slate-950/80 border-slate-700/80 text-white font-mono placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Short Description *
          </label>
          <Textarea
            name="shortDescription"
            rows={2}
            required
            value={product.shortDescription}
            class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Full Description *
          </label>
          <Textarea
            name="description"
            rows={6}
            required
            value={product.description}
            class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
          />
        </div>

        <div class="pt-2">
          {currentThumbnailUrl && (
            <div class="mb-3 flex items-center gap-3 p-3 bg-slate-950/60 rounded-xl border border-slate-800 w-fit">
              <img src={currentThumbnailUrl} alt="Thumbnail preview" class="w-16 h-16 rounded-lg object-cover" />
              <span class="text-xs text-slate-400">Current thumbnail</span>
            </div>
          )}
          <Dropzone
            name="thumbnail"
            label="Replace Thumbnail Image"
            helperText="PNG, JPG, WebP, or SVG (Recommended: 1200x800px)"
            maxSizeLabel="Max 5MB"
            accept="image/png,image/jpeg,image/webp,image/svg+xml"
          />
        </div>
      </CardContent>
    </Card>

    <!-- URLs & Technical Specifications Card -->
    <Card class="bg-slate-900/70 border-slate-800/80 rounded-2xl shadow-xl">
      <CardHeader>
        <CardTitle class="text-sm font-bold text-primary uppercase tracking-wider">Links & Meta</CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-2">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              CodeCanyon URL
            </label>
            <Input
              name="codecanyonUrl"
              type="url"
              value={product.codecanyonUrl || ""}
              placeholder="https://codecanyon.net/..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Live Demo URL
            </label>
            <Input
              name="demoUrl"
              type="url"
              value={product.demoUrl || ""}
              placeholder="https://demo.sourcemonster.in/..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Documentation URL
            </label>
            <Input
              name="documentationUrl"
              type="url"
              value={product.documentationUrl || ""}
              placeholder="https://docs.sourcemonster.in/..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Technologies (comma separated)
            </label>
            <Input
              name="technologies"
              type="text"
              value={product.technologies.join(", ")}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Version
            </label>
            <Input
              name="version"
              type="text"
              value={product.version || ""}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Features (one per line)
          </label>
          <Textarea
            name="features"
            rows={4}
            value={product.features.join("\n")}
            class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
          />
        </div>
      </CardContent>
    </Card>

    <!-- Gallery Screenshots Card -->
    <Card class="bg-slate-900/70 border-slate-800/80 rounded-2xl shadow-xl">
      <CardHeader>
        <CardTitle class="text-sm font-bold text-primary uppercase tracking-wider">Screenshots & Gallery</CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-2">
        {galleryItems.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
            {galleryItems.map((item) => (
              <div class="relative group rounded-xl overflow-hidden border border-slate-800 bg-slate-950">
                <img src={getPublicUrl(item.objectKey, item.disk)} alt={item.caption || "Screenshot"} class="w-full h-28 object-cover" />
                <form method="POST" class="absolute top-1.5 right-1.5">
                  <input type="hidden" name="_action" value="delete_gallery_image" />
                  <input type="hidden" name="product_media_id" value={item.productMediaId} />
                  <button
                    type="submit"
                    class="p-1.5 bg-rose-500/80 hover:bg-rose-600 text-white rounded-lg opacity-0 group-hover:opacity-100 transition shadow"
                    title="Remove Screenshot"
                  >
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  </button>
                </form>
              </div>
            ))}
          </div>
        )}

        <Dropzone
          name="screenshot"
          label="Add Screenshot Image"
          helperText="Upload additional gallery screenshot (PNG, JPG, WebP)"
          maxSizeLabel="Max 5MB"
          accept="image/png,image/jpeg,image/webp"
          icon="image-plus"
        />
      </CardContent>
    </Card>

    <!-- Publishing & SEO Card -->
    <Card class="bg-slate-900/70 border-slate-800/80 rounded-2xl shadow-xl">
      <CardHeader>
        <CardTitle class="text-sm font-bold text-primary uppercase tracking-wider">Publishing & SEO</CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-2">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Status
            </label>
            <NativeSelect
              name="status"
              class="bg-slate-950/80 border-slate-700/80 text-white rounded-xl"
            >
              <NativeSelectOption value="draft" selected={product.status === "draft"}>Draft</NativeSelectOption>
              <NativeSelectOption value="published" selected={product.status === "published"}>Published</NativeSelectOption>
            </NativeSelect>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Sort Order
            </label>
            <Input
              name="sortOrder"
              type="number"
              value={product.sortOrder}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div class="flex items-center pt-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                name="isFeatured"
                type="checkbox"
                checked={product.isFeatured}
                class="w-4 h-4 rounded text-primary focus:ring-primary bg-slate-950 border-slate-700"
              />
              <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Highlight as Featured</span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              SEO Title
            </label>
            <Input
              name="seoTitle"
              type="text"
              value={product.seoTitle || ""}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              SEO Meta Description
            </label>
            <Input
              name="seoDescription"
              type="text"
              value={product.seoDescription || ""}
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>
      </CardContent>
    </Card>

    <!-- Actions -->
    <div class="flex items-center justify-between pt-4">
      <Button
        type="submit"
        name="_action"
        value="delete"
        variant="danger"
        size="md"
        icon="trash-2"
        onclick="return confirm('Are you sure you want to permanently delete this product?');"
      >
        Delete Product
      </Button>

      <div class="flex items-center gap-3">
        <Button href="/admin/products" variant="secondary" size="md">Cancel</Button>
        <Button
          type="submit"
          variant="primary"
          size="md"
          icon="save"
        >
          Save Changes
        </Button>
      </div>
    </div>
  </form>

  <!-- Add-ons & Modules Section -->
  <div class="my-8 max-w-4xl space-y-4">
    <Card class="bg-slate-900/70 border-slate-800/80 rounded-2xl shadow-xl">
      <CardHeader>
        <CardTitle class="text-sm font-bold text-primary uppercase tracking-wider flex items-center gap-2">
          <i data-lucide="puzzle" class="w-4 h-4"></i>
          Add-ons &amp; Modules
          {addons.length > 0 && (
            <span class="ml-auto text-[10px] font-normal bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 rounded-full">
              {addons.length} module{addons.length !== 1 ? "s" : ""}
            </span>
          )}
        </CardTitle>
      </CardHeader>
      <CardContent class="space-y-6 pt-2">
        {/* Existing addons list */}
        {addons.length > 0 ? (
          <div class="space-y-3">
            {addons.map((addon) => (
              <div class="flex items-start justify-between gap-3 p-4 bg-slate-950/60 border border-slate-800/70 rounded-xl group hover:border-slate-700/80 transition">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2.5 flex-wrap">
                    <span class="font-bold text-sm text-white">{addon.name}</span>
                    {addon.isFree ? (
                      <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold uppercase tracking-wider">
                        Free
                      </span>
                    ) : addon.price ? (
                      <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20 text-[10px] font-bold font-mono">
                        ${parseFloat(addon.price).toFixed(2)}
                      </span>
                    ) : null}
                  </div>
                  {addon.description && (
                    <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">{addon.description}</p>
                  )}
                  <div class="flex items-center gap-4 mt-2.5 flex-wrap">
                    {addon.buyUrl && (
                      <a
                        href={addon.buyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[11px] text-primary hover:underline flex items-center gap-1 font-medium"
                      >
                        <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                        <span>Buy URL</span>
                      </a>
                    )}
                    {addon.demoUrl && (
                      <a
                        href={addon.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[11px] text-slate-400 hover:text-white flex items-center gap-1 font-medium"
                      >
                        <i data-lucide="play-circle" class="w-3.5 h-3.5"></i>
                        <span>Live Demo</span>
                      </a>
                    )}
                  </div>
                </div>
                <form method="POST" class="shrink-0">
                  <input type="hidden" name="_action" value="delete_addon" />
                  <input type="hidden" name="addon_id" value={addon.id} />
                  <button
                    type="submit"
                    title="Remove addon"
                    class="p-2 text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition"
                    onclick="return confirm('Are you sure you want to remove this addon?');"
                  >
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                </form>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-6 text-xs text-slate-500 border border-dashed border-slate-800 rounded-xl">
            No addons or modules added yet. Add one below.
          </div>
        )}

        {/* Add new addon form */}
        <form method="POST" class="space-y-4 pt-4 border-t border-slate-800/80">
          <input type="hidden" name="_action" value="add_addon" />
          <div class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-2">
            <i data-lucide="plus-circle" class="w-4 h-4 text-primary"></i>
            <span>Add New Module / Addon</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                Module Name *
              </label>
              <Input
                name="addon_name"
                type="text"
                required
                placeholder="e.g. WhatsApp Notification Module"
                class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                Price (USD)
              </label>
              <Input
                name="addon_price"
                type="number"
                min="0"
                step="0.01"
                placeholder="29.00"
                class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Description
            </label>
            <Textarea
              name="addon_description"
              rows={2}
              placeholder="Explain what functionality this addon or module provides..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                Buy / CodeCanyon URL
              </label>
              <Input
                name="addon_buy_url"
                type="url"
                placeholder="https://codecanyon.net/item/..."
                class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                Demo URL
              </label>
              <Input
                name="addon_demo_url"
                type="url"
                placeholder="https://demo.sourcemonster.in/addon"
                class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
              />
            </div>
          </div>

          <div class="flex items-center justify-between pt-2">
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                name="addon_is_free"
                type="checkbox"
                class="w-4 h-4 rounded text-primary focus:ring-primary bg-slate-950 border-slate-700"
              />
              <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">This addon is free / included</span>
            </label>
            <Button type="submit" variant="primary" size="sm" icon="plus">
              Add Module
            </Button>
          </div>
        </form>
      </CardContent>
    </Card>
  </div>
</AdminLayout>
