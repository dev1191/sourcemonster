---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import {
  getAdminProductById,
  updateProduct,
  deleteProduct,
  deleteProductGalleryImage,
  getAllAdminAddons,
  createProductChangeLog,
  deleteProductChangeLog,
} from "../../../../services";
import { getPublicUrl } from "../../../../lib/storage";
import { Button, Dropzone, Toast, ConfirmDialog, HtmlEditor } from "../../../../components/ui";
import { Card, CardHeader, CardTitle, CardContent } from "../../../../components/starwind/card";
import { Input } from "../../../../components/starwind/input";
import { Textarea } from "../../../../components/starwind/textarea";
import { NativeSelect, NativeSelectOption } from "../../../../components/starwind/native-select";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/products");
}

let errorMessage = "";
let successMessage = "";

// Initial check
const initialProductData = await getAdminProductById(id);
if (!initialProductData) {
  return Astro.redirect("/admin/products");
}

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("_action")?.toString();

    if (action === "delete") {
      await deleteProduct(id);
      return Astro.redirect("/admin/products");
    }

    if (action === "delete_gallery_image") {
      const pmId = formData.get("product_media_id")?.toString();
      if (pmId) {
        await deleteProductGalleryImage(pmId);
        return Astro.redirect(`/admin/products/${id}/edit`);
      }
    }

    if (action === "add_changelog") {
      const changelogVersion = formData.get("changelog_version")?.toString().trim() || null;
      const changelogContent = formData.get("changelog_content")?.toString().trim() || "";
      if (changelogContent) {
        await createProductChangeLog({
          productId: id,
          version: changelogVersion,
          content: changelogContent,
        });
        return Astro.redirect(`/admin/products/${id}/edit`);
      }
    }

    if (action === "delete_changelog") {
      const clId = formData.get("changelog_id")?.toString();
      if (clId) {
        await deleteProductChangeLog(clId);
        return Astro.redirect(`/admin/products/${id}/edit`);
      }
    }

    const title = formData.get("title")?.toString().trim() || "";
    const slug = formData.get("slug")?.toString().trim().toLowerCase() || "";
    const shortDescription = formData.get("shortDescription")?.toString().trim() || "";
    const description = formData.get("description")?.toString().trim() || "";
    const codecanyonUrl = formData.get("codecanyonUrl")?.toString().trim() || "";
    const demoUrl = formData.get("demoUrl")?.toString().trim() || "";
    const documentationUrl = formData.get("documentationUrl")?.toString().trim() || "";
    const version = formData.get("version")?.toString().trim() || "";
    const status = (formData.get("status")?.toString() || "draft") as "draft" | "published";
    const isFeatured = formData.get("isFeatured") === "on";
    const sortOrder = parseInt(formData.get("sortOrder")?.toString() || "0", 10);
    const seoTitle = formData.get("seoTitle")?.toString().trim() || "";
    const seoDescription = formData.get("seoDescription")?.toString().trim() || "";

    const rawTech = formData.get("technologies")?.toString() || "";
    const technologies = rawTech
      .split(/[,\n]/)
      .map((t) => t.trim())
      .filter(Boolean);

    const rawFeatures = formData.get("features")?.toString() || "";
    let features: string[] = [];
    if (/<li[^>]*>/i.test(rawFeatures)) {
      const matches = rawFeatures.matchAll(/<li[^>]*>(.*?)<\/li>/gis);
      features = Array.from(matches, (m) =>
        m[1]
          .replace(/^<p[^>]*>/i, "")
          .replace(/<\/p>$/i, "")
          .trim()
      ).filter(Boolean);
    } else if (/<p[^>]*>/i.test(rawFeatures)) {
      const matches = rawFeatures.matchAll(/<p[^>]*>(.*?)<\/p>/gis);
      features = Array.from(matches, (m) =>
        m[1]
          .replace(/<br\s*\/?>/gi, "\n")
          .split("\n")
          .map((f) => f.trim())
      )
        .flat()
        .filter(Boolean);
    } else {
      features = rawFeatures
        .replace(/<br\s*\/?>/gi, "\n")
        .split("\n")
        .map((f) => f.trim())
        .filter(Boolean);
    }

    const thumbnailFile = formData.get("thumbnail") as File | null;
    const screenshotFile = formData.get("screenshot") as File | null;

    await updateProduct(
      id,
      {
        title,
        slug,
        shortDescription,
        description,
        codecanyonUrl,
        demoUrl,
        documentationUrl,
        version,
        technologies,
        features,
        status,
        isFeatured,
        sortOrder,
        seoTitle,
        seoDescription,
      },
      thumbnailFile,
      screenshotFile
    );

    const newChangelog = formData.get("new_changelog_content")?.toString().trim();
    if (newChangelog) {
      await createProductChangeLog({
        productId: id,
        version: version || initialProductData.product.version || null,
        content: newChangelog,
      });
    }

    successMessage = "Product updated successfully!";
  } catch (err: any) {
    console.error("Update product failed:", err);
    errorMessage = err?.message || "Failed to update product.";
  }
}

// Re-query current product & media for rendering
const productData = await getAdminProductById(id);
if (!productData) {
  return Astro.redirect("/admin/products");
}

const { product, thumbnailUrl: currentThumbnailUrl, galleryItems, changelogs = [] } = productData;
const addons = await getAllAdminAddons(id);
---

<AdminLayout title={`Edit ${product.title} | SourceMonster Admin`} activeNav="products">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-1">
        <a href="/admin/products" class="hover:text-slate-900 dark:hover:text-white transition">Products</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-white">Edit</span>
      </div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
        <span>Edit Product:</span>
        <span class="text-primary truncate">{product.title}</span>
      </h1>
    </div>

    <div class="flex items-center gap-2">
      {product.status === "published" && (
        <Button
          href={`/products/${product.slug}`}
          target="_blank"
          variant="secondary"
          size="sm"
          icon="external-link"
        >
          View Public Page
        </Button>
      )}
      <Button href="/admin/products" variant="secondary" size="sm">Back to list</Button>
    </div>
  </div>

  <Toast variant="error" message={errorMessage} />
  <Toast variant="success" message={successMessage} />

  <form method="POST" enctype="multipart/form-data" class="my-6 space-y-6 max-w-4xl">
    <input type="hidden" name="_action" value="update" />

    <!-- Basic Info Card -->
    <Card class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-sm dark:shadow-xl">
      <CardHeader class="border-b border-slate-200 dark:border-slate-800/60 pb-3">
        <CardTitle class="text-sm font-bold text-primary uppercase tracking-wider">Basic Info</CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Product Title *
            </label>
            <Input
              name="title"
              type="text"
              required
              value={product.title}
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              URL Slug *
            </label>
            <Input
              name="slug"
              type="text"
              required
              value={product.slug}
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white font-mono placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
            Short Description *
          </label>
          <Textarea
            name="shortDescription"
            rows={2}
            required
            value={product.shortDescription}
            class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
          />
        </div>

        <HtmlEditor
          name="description"
          label="Full Description"
          required
          value={product.description}
          placeholder="Detailed product overview, architectural capabilities, value proposition, and technical specs..."
          helperText="Format your architecture overview using rich text, headings, lists, code blocks, or raw HTML."
        />

        <div class="pt-2">
          {currentThumbnailUrl && (
            <div class="mb-3 flex items-center gap-3 p-3 bg-slate-50 dark:bg-slate-950/60 rounded-xl border border-slate-200 dark:border-slate-800 w-fit">
              <img src={currentThumbnailUrl} alt="Thumbnail preview" class="w-16 h-16 rounded-lg object-cover" />
              <span class="text-xs text-slate-500 dark:text-slate-400">Current thumbnail</span>
            </div>
          )}
          <Dropzone
            name="thumbnail"
            label="Replace Thumbnail Image"
            helperText="PNG, JPG, WebP, or SVG (Recommended: 1200x800px)"
            maxSizeLabel="Max 5MB"
            accept="image/png,image/jpeg,image/webp,image/svg+xml"
          />
        </div>
      </CardContent>
    </Card>

    <!-- URLs & Technical Specifications Card -->
    <Card class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-sm dark:shadow-xl">
      <CardHeader class="border-b border-slate-200 dark:border-slate-800/60 pb-3">
        <CardTitle class="text-sm font-bold text-primary uppercase tracking-wider">Links & Meta</CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              CodeCanyon URL
            </label>
            <Input
              name="codecanyonUrl"
              type="url"
              value={product.codecanyonUrl || ""}
              placeholder="https://codecanyon.net/..."
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Live Demo URL
            </label>
            <Input
              name="demoUrl"
              type="url"
              value={product.demoUrl || ""}
              placeholder="https://demo.sourcemonster.in/..."
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Documentation URL
            </label>
            <Input
              name="documentationUrl"
              type="url"
              value={product.documentationUrl || ""}
              placeholder="https://docs.sourcemonster.in/..."
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Technologies (comma separated)
            </label>
            <Input
              name="technologies"
              type="text"
              value={product.technologies.join(", ")}
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Version
            </label>
            <Input
              name="version"
              type="text"
              value={product.version || ""}
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <HtmlEditor
          name="features"
          label="Key Features & Capabilities (Bulleted List)"
          minHeight="180px"
          value={product.features && product.features.length > 0
            ? (product.features.some((f) => f.includes("<li"))
                ? `<ul>${product.features.join("")}</ul>`
                : `<ul>${product.features.map((f) => `<li>${f}</li>`).join("")}</ul>`)
            : ""}
          helperText="Format key capabilities using bulleted lists, numbered lists, or bold highlights."
        />

        <!-- Add Changelog for this update -->
        <div class="pt-4 border-t border-slate-200 dark:border-slate-800/80">
          <div class="flex items-center justify-between mb-2">
            <label class="block text-xs font-semibold text-primary uppercase tracking-wider flex items-center gap-1.5">
              <i data-lucide="git-commit" class="w-3.5 h-3.5"></i>
              Add Changelog / Release Notes for this Update (Optional)
            </label>
            <span class="text-[11px] text-slate-500 font-mono">Appends to version history</span>
          </div>
          <HtmlEditor
            name="new_changelog_content"
            minHeight="140px"
            placeholder="<p><strong>What's new in this release:</strong></p><ul><li>Added new capability...</li><li>Fixed layout issue...</li><li>Performance improvements</li></ul>"
            helperText="If updating version or publishing changes, write release notes here to automatically record a changelog entry upon saving."
          />
        </div>
      </CardContent>
    </Card>

    <!-- Gallery Screenshots Card -->
    <Card class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-sm dark:shadow-xl">
      <CardHeader class="border-b border-slate-200 dark:border-slate-800/60 pb-3">
        <CardTitle class="text-sm font-bold text-primary uppercase tracking-wider">Screenshots & Gallery</CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-4">
        {galleryItems.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
            {galleryItems.map((item) => (
              <div class="relative group rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-950">
                <img src={getPublicUrl(item.objectKey, item.disk)} alt={item.caption || "Screenshot"} class="w-full h-28 object-cover" />
                <form method="POST" class="absolute top-1.5 right-1.5">
                  <input type="hidden" name="_action" value="delete_gallery_image" />
                  <input type="hidden" name="product_media_id" value={item.productMediaId} />
                  <button
                    type="submit"
                    class="p-1.5 bg-rose-500/80 hover:bg-rose-600 text-white rounded-lg opacity-0 group-hover:opacity-100 transition shadow cursor-pointer"
                    title="Remove Screenshot"
                  >
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  </button>
                </form>
              </div>
            ))}
          </div>
        )}

        <Dropzone
          name="screenshot"
          label="Add Screenshot Image"
          helperText="Upload additional gallery screenshot (PNG, JPG, WebP)"
          maxSizeLabel="Max 5MB"
          accept="image/png,image/jpeg,image/webp"
          icon="image-plus"
        />
      </CardContent>
    </Card>

    <!-- Publishing & SEO Card -->
    <Card class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-sm dark:shadow-xl">
      <CardHeader class="border-b border-slate-200 dark:border-slate-800/60 pb-3">
        <CardTitle class="text-sm font-bold text-primary uppercase tracking-wider">Publishing & SEO</CardTitle>
      </CardHeader>
      <CardContent class="space-y-4 pt-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Status
            </label>
            <NativeSelect
              name="status"
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white rounded-xl"
            >
              <NativeSelectOption value="draft" selected={product.status === "draft"}>Draft</NativeSelectOption>
              <NativeSelectOption value="published" selected={product.status === "published"}>Published</NativeSelectOption>
            </NativeSelect>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Sort Order
            </label>
            <Input
              name="sortOrder"
              type="number"
              value={product.sortOrder}
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div class="flex items-center pt-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                name="isFeatured"
                type="checkbox"
                checked={product.isFeatured}
                class="w-4 h-4 rounded text-primary focus:ring-primary bg-white dark:bg-slate-950 border-slate-300 dark:border-slate-700"
              />
              <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Highlight as Featured</span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              SEO Title
            </label>
            <Input
              name="seoTitle"
              type="text"
              value={product.seoTitle || ""}
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              SEO Meta Description
            </label>
            <Input
              name="seoDescription"
              type="text"
              value={product.seoDescription || ""}
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>
      </CardContent>
    </Card>

    <!-- Actions -->
    <div class="flex items-center justify-between pt-4">
      <ConfirmDialog
        title="Delete Product"
        description="Are you sure you want to permanently delete this product? All gallery images, reviews, and related add-ons will be removed."
        confirmText="Delete Product"
        confirmVariant="destructive"
        confirmIcon="trash-2"
        icon="trash-2"
        formMethod="POST"
      >
        <input type="hidden" name="_action" value="delete" slot="form-fields" />
        <Button
          slot="trigger"
          type="button"
          variant="danger"
          size="md"
          icon="trash-2"
        >
          Delete Product
        </Button>
      </ConfirmDialog>

      <div class="flex items-center gap-3">
        <Button href="/admin/products" variant="secondary" size="md">Cancel</Button>
        <Button
          type="submit"
          variant="primary"
          size="md"
          icon="save"
        >
          Save Changes
        </Button>
      </div>
    </div>
  </form>

  <!-- Product Changelog & Release History Card -->
  <Card class="my-8 max-w-4xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 shadow-sm dark:shadow-xl">
    <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <i data-lucide="history" class="w-4 h-4 text-primary"></i>
        <h2 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider">
          Changelog &amp; Version History
        </h2>
        <span class="text-[10px] font-mono bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 rounded-full">
          {changelogs.length} {changelogs.length === 1 ? "release" : "releases"}
        </span>
      </div>
      <button
        type="button"
        id="toggle-changelog-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-primary hover:bg-primary/90 text-white text-xs font-semibold transition cursor-pointer"
      >
        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
        <span>Add Changelog Entry</span>
      </button>
    </div>

    {/* Form to directly add a standalone changelog entry */}
    <div id="quick-changelog-box" class="hidden mb-6 p-4 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-xs font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider flex items-center gap-2">
          <i data-lucide="file-plus-2" class="w-4 h-4 text-primary"></i>
          Create New Changelog Entry
        </h3>
        <span class="text-[11px] text-slate-500 font-mono">Standalone entry</span>
      </div>
      <form method="POST" class="space-y-3">
        <input type="hidden" name="_action" value="add_changelog" />
        <div class="w-full sm:w-1/2">
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-400 uppercase tracking-wider mb-1">
            Version Label
          </label>
          <Input
            name="changelog_version"
            type="text"
            value={product.version || ""}
            placeholder="e.g. v1.2.0"
            class="bg-white dark:bg-slate-900 border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white rounded-lg text-xs"
          />
        </div>
        <HtmlEditor
          name="changelog_content"
          label="Changelog Release Notes"
          minHeight="140px"
          placeholder="<ul><li>Added new authentication provider</li><li>Optimized database queries</li></ul>"
          required
        />
        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            id="cancel-changelog-btn"
            class="px-3 py-1.5 rounded-lg bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-semibold transition cursor-pointer"
          >
            Cancel
          </button>
          <Button type="submit" variant="primary" size="sm" icon="check">
            Publish Changelog
          </Button>
        </div>
      </form>
    </div>

    {changelogs.length === 0 ? (
      <div class="py-8 text-center text-slate-500 text-xs">
        <i data-lucide="scroll-text" class="w-8 h-8 mx-auto mb-2 opacity-40"></i>
        <p>No changelog records published for this product yet.</p>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
          When you release updates, add release notes to keep users informed about new features and bug fixes.
        </p>
      </div>
    ) : (
      <div class="space-y-4">
        {changelogs.map((log) => (
          <div class="p-4 rounded-xl bg-slate-50/70 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 hover:border-slate-300 dark:hover:border-slate-700/80 transition">
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-200 dark:border-slate-800/50">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded-md bg-primary/20 text-primary border border-primary/30 text-xs font-mono font-bold">
                  {log.version || product.version || "Release"}
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-400">
                  {new Date(log.createdAt).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
              </div>
              <form method="POST" onsubmit="return confirm('Delete this changelog entry?');">
                <input type="hidden" name="_action" value="delete_changelog" />
                <input type="hidden" name="changelog_id" value={log.id} />
                <button
                  type="submit"
                  class="text-xs text-slate-400 hover:text-rose-500 transition p-1 cursor-pointer"
                  title="Delete entry"
                >
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                </button>
              </form>
            </div>
            <div class="prose dark:prose-invert prose-xs max-w-none text-slate-700 dark:text-slate-300" set:html={log.content}></div>
          </div>
        ))}
      </div>
    )}
  </Card>

  <script>
    const toggleBtn = document.getElementById("toggle-changelog-btn");
    const cancelBtn = document.getElementById("cancel-changelog-btn");
    const box = document.getElementById("quick-changelog-box");

    if (toggleBtn && box) {
      toggleBtn.addEventListener("click", () => {
        box.classList.toggle("hidden");
      });
    }

    if (cancelBtn && box) {
      cancelBtn.addEventListener("click", () => {
        box.classList.add("hidden");
      });
    }
  </script>

  <!-- Add-ons & Companion Modules Summary Card -->
  <Card class="my-8 max-w-4xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl p-6 shadow-sm dark:shadow-xl">
    <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <i data-lucide="puzzle" class="w-4 h-4 text-primary"></i>
        <h2 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider">
          Product Add-ons &amp; Companion Modules
        </h2>
        <span class="text-[10px] font-mono bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 rounded-full">
          {addons.length} {addons.length === 1 ? "module" : "modules"}
        </span>
      </div>
      <Button
        href={`/admin/products/addons/new?productId=${id}`}
        variant="primary"
        size="sm"
        icon="plus"
      >
        Add New Module
      </Button>
    </div>

    {addons.length === 0 ? (
      <div class="py-8 text-center text-slate-500 text-xs">
        <p>No add-on modules attached to this product yet.</p>
        <div class="mt-3">
          <Button href={`/admin/products/addons/new?productId=${id}`} variant="secondary" size="sm" icon="plus">
            Create First Module
          </Button>
        </div>
      </div>
    ) : (
      <div class="divide-y divide-slate-200 dark:divide-slate-800/60">
        {addons.map((addon) => (
          <div class="py-3 flex items-center justify-between gap-4 first:pt-0 last:pb-0">
            <div class="flex items-center gap-3">
              {addon.thumbnailUrl ? (
                <img
                  src={addon.thumbnailUrl}
                  alt={addon.title}
                  class="w-10 h-10 rounded-lg object-cover bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 shrink-0"
                />
              ) : (
                <div class="w-10 h-10 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 flex items-center justify-center text-slate-400 dark:text-slate-500 shrink-0">
                  <i data-lucide="puzzle" class="w-4 h-4"></i>
                </div>
              )}
              <div>
                <a
                  href={`/admin/products/addons/${addon.id}/edit`}
                  class="font-bold text-slate-900 dark:text-white text-sm hover:text-primary transition truncate block max-w-sm"
                >
                  {addon.title}
                </a>
                <div class="text-[11px] text-slate-500 dark:text-slate-400 font-mono">
                  {addon.isFree ? "Free" : addon.price ? `$${Number(addon.price).toFixed(2)}` : "—"}
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <Button
                href={`/admin/products/addons/${addon.id}/edit`}
                variant="secondary"
                size="sm"
                icon="pencil"
              >
                Edit Add-on
              </Button>
            </div>
          </div>
        ))}
      </div>
    )}
  </Card>
</AdminLayout>
