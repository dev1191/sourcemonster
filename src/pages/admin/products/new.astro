---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../lib/db";
import { products, media, productAddons, productAddonMedia } from "../../../lib/db/schema";
import { eq } from "drizzle-orm";
import { productSchema } from "../../../lib/validation/product";
import { uploadFile } from "../../../lib/storage";
import { Button, Card, Dropzone, FeedbackAlert, ProductAddonsSection } from "../../../components/ui";
import { Input } from "../../../components/starwind/input";
import { Textarea } from "../../../components/starwind/textarea";
import { NativeSelect, NativeSelectOption } from "../../../components/starwind/native-select";

let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const title = formData.get("title")?.toString().trim() || "";
    const slug = formData.get("slug")?.toString().trim().toLowerCase() || "";
    const shortDescription = formData.get("shortDescription")?.toString().trim() || "";
    const description = formData.get("description")?.toString().trim() || "";
    const codecanyonUrl = formData.get("codecanyonUrl")?.toString().trim() || "";
    const demoUrl = formData.get("demoUrl")?.toString().trim() || "";
    const documentationUrl = formData.get("documentationUrl")?.toString().trim() || "";
    const version = formData.get("version")?.toString().trim() || "";
    const status = (formData.get("status")?.toString() || "draft") as "draft" | "published";
    const isFeatured = formData.get("isFeatured") === "on";
    const sortOrder = parseInt(formData.get("sortOrder")?.toString() || "0", 10);
    const seoTitle = formData.get("seoTitle")?.toString().trim() || "";
    const seoDescription = formData.get("seoDescription")?.toString().trim() || "";

    const rawTech = formData.get("technologies")?.toString() || "";
    const technologies = rawTech
      .split(/[,\n]/)
      .map((t) => t.trim())
      .filter(Boolean);

    const rawFeatures = formData.get("features")?.toString() || "";
    const features = rawFeatures
      .split("\n")
      .map((f) => f.trim())
      .filter(Boolean);

    // Validate using Zod
    const validationResult = productSchema.safeParse({
      title,
      slug,
      shortDescription,
      description,
      codecanyonUrl,
      demoUrl,
      documentationUrl,
      version,
      technologies,
      features,
      status,
      isFeatured,
      sortOrder,
      seoTitle,
      seoDescription,
    });

    if (!validationResult.success) {
      errorMessage = Object.values(validationResult.error.flatten().fieldErrors)
        .flat()
        .join("; ");
    } else {
      // Check slug uniqueness
      const [existingSlug] = await db
        .select()
        .from(products)
        .where(eq(products.slug, slug))
        .limit(1);

      if (existingSlug) {
        errorMessage = `The slug "${slug}" is already used by another product.`;
      } else {
        let thumbnailMediaId: string | null = null;
        const thumbnailFile = formData.get("thumbnail") as File | null;

        if (thumbnailFile && thumbnailFile.size > 0) {
          const uploadRes = await uploadFile(
            thumbnailFile,
            thumbnailFile.name,
            thumbnailFile.type
          );

          const [newMedia] = await db
            .insert(media)
            .values({
              disk: uploadRes.disk,
              objectKey: uploadRes.objectKey,
              originalName: uploadRes.originalName,
              mimeType: uploadRes.mimeType,
              sizeBytes: uploadRes.sizeBytes,
              altText: title,
            })
            .returning();

          thumbnailMediaId = newMedia.id;
        }

        const [newProduct] = await db.insert(products).values({
          title,
          slug,
          shortDescription,
          description,
          thumbnailMediaId,
          codecanyonUrl: codecanyonUrl || null,
          demoUrl: demoUrl || null,
          documentationUrl: documentationUrl || null,
          version: version || null,
          technologies,
          features,
          status,
          isFeatured,
          sortOrder,
          seoTitle: seoTitle || null,
          seoDescription: seoDescription || null,
          publishedAt: status === "published" ? new Date() : null,
        }).returning();

        // Check for optional initial addon
        const addonName = formData.get("addon_name")?.toString().trim();
        if (addonName && newProduct) {
          const addonDesc = formData.get("addon_description")?.toString().trim() || "";
          const addonPriceRaw = formData.get("addon_price")?.toString().trim();
          const addonIsFree = formData.get("addon_is_free") === "on";
          const addonBuyUrl = formData.get("addon_buy_url")?.toString().trim() || null;
          const addonDemoUrl = formData.get("addon_demo_url")?.toString().trim() || null;

          let addonThumbnailMediaId: string | null = null;
          const addonThumbnailFile = formData.get("addon_thumbnail") as File | null;
          if (addonThumbnailFile && addonThumbnailFile.size > 0) {
            const uploadRes = await uploadFile(
              addonThumbnailFile,
              addonThumbnailFile.name,
              addonThumbnailFile.type
            );
            const [newMedia] = await db
              .insert(media)
              .values({
                disk: uploadRes.disk,
                objectKey: uploadRes.objectKey,
                originalName: uploadRes.originalName,
                mimeType: uploadRes.mimeType,
                sizeBytes: uploadRes.sizeBytes,
                altText: `${addonName} Thumbnail`,
              })
              .returning();
            addonThumbnailMediaId = newMedia.id;
          }

          const [createdAddon] = await db.insert(productAddons).values({
            productId: newProduct.id,
            name: addonName,
            description: addonDesc,
            thumbnailMediaId: addonThumbnailMediaId,
            price: addonIsFree || !addonPriceRaw ? null : addonPriceRaw,
            isFree: addonIsFree,
            buyUrl: addonBuyUrl || null,
            demoUrl: addonDemoUrl || null,
            sortOrder: 0,
          }).returning();

          const addonScreenshotFile = formData.get("addon_screenshot") as File | null;
          if (addonScreenshotFile && addonScreenshotFile.size > 0 && createdAddon) {
            const uploadRes = await uploadFile(
              addonScreenshotFile,
              addonScreenshotFile.name,
              addonScreenshotFile.type
            );
            const [newMedia] = await db
              .insert(media)
              .values({
                disk: uploadRes.disk,
                objectKey: uploadRes.objectKey,
                originalName: uploadRes.originalName,
                mimeType: uploadRes.mimeType,
                sizeBytes: uploadRes.sizeBytes,
                altText: `${addonName} Screenshot`,
              })
              .returning();
            await db.insert(productAddonMedia).values({
              addonId: createdAddon.id,
              mediaId: newMedia.id,
              sortOrder: 0,
            });
          }
        }

        return Astro.redirect(`/admin/products/${newProduct.id}/edit`);
      }
    }
  } catch (err) {
    console.error("Create product failed:", err);
    errorMessage = "Failed to create product. Check server logs.";
  }
}
---

<AdminLayout title="New Product | SourceMonster Admin" activeNav="products">
  <div class="flex items-center justify-between pb-6 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
        <a href="/admin/products" class="hover:text-white transition">Products</a>
        <span>/</span>
        <span class="text-white">Create</span>
      </div>
      <h1 class="text-2xl font-black text-white tracking-tight">Create New Product</h1>
    </div>
    <Button href="/admin/products" variant="secondary" size="sm">Cancel</Button>
  </div>

  <FeedbackAlert variant="error" message={errorMessage} />

  <form method="POST" enctype="multipart/form-data" class="my-6 space-y-6 max-w-4xl">
    <!-- Basic Info Card -->
    <Card title="Basic Info" icon="package">
      <div class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Product Title *
            </label>
            <Input
              id="title-input"
              name="title"
              type="text"
              required
              placeholder="e.g. MonsterSaaS Boilerplate"
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              URL Slug *
            </label>
            <Input
              id="slug-input"
              name="slug"
              type="text"
              required
              placeholder="e.g. monstersaas-boilerplate"
              class="bg-slate-950/80 border-slate-700/80 text-white font-mono placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Short Description (Card Summary) *
          </label>
          <Textarea
            name="shortDescription"
            rows={2}
            required
            placeholder="Brief 1-2 sentence pitch for catalog cards..."
            class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Full Description *
          </label>
          <Textarea
            name="description"
            rows={5}
            required
            placeholder="Detailed product overview, value proposition, and architecture..."
            class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
          />
        </div>

        <Dropzone
          name="thumbnail"
          label="Thumbnail Image"
          helperText="PNG, JPG, WebP, or SVG (Recommended: 1200x800px)"
          maxSizeLabel="Max 5MB"
          accept="image/png,image/jpeg,image/webp,image/svg+xml"
        />
      </div>
    </Card>

    <!-- URLs & Technical Specifications Card -->
    <Card title="Links & Meta" icon="link-2">
      <div class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              CodeCanyon URL
            </label>
            <Input
              name="codecanyonUrl"
              type="url"
              placeholder="https://codecanyon.net/item/..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Live Demo URL
            </label>
            <Input
              name="demoUrl"
              type="url"
              placeholder="https://demo.sourcemonster.in/..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Documentation URL
            </label>
            <Input
              name="documentationUrl"
              type="url"
              placeholder="https://docs.sourcemonster.in/..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Technologies (comma separated)
            </label>
            <Input
              name="technologies"
              type="text"
              placeholder="TypeScript, Astro, PostgreSQL, Tailwind"
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Version
            </label>
            <Input
              name="version"
              type="text"
              placeholder="v1.0.0"
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Features (one per line)
          </label>
          <Textarea
            name="features"
            rows={4}
            placeholder="Turnkey multi-tenant isolation&#10;Stripe subscriptions and webhook handler&#10;Dark-mode modern dashboard UI"
            class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
          />
        </div>
      </div>
    </Card>

    <!-- Publishing & SEO Card -->
    <Card title="Publishing & SEO" icon="globe">
      <div class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Status
            </label>
            <NativeSelect
              name="status"
              class="bg-slate-950/80 border-slate-700/80 text-white rounded-xl"
            >
              <NativeSelectOption value="draft">Draft</NativeSelectOption>
              <NativeSelectOption value="published">Published</NativeSelectOption>
            </NativeSelect>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Sort Order
            </label>
            <Input
              name="sortOrder"
              type="number"
              value="0"
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div class="flex items-center pt-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                name="isFeatured"
                type="checkbox"
                class="w-4 h-4 rounded text-primary focus:ring-primary bg-slate-950 border-slate-700"
              />
              <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Highlight as Featured</span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              SEO Title
            </label>
            <Input
              name="seoTitle"
              type="text"
              placeholder="Custom SEO Title..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              SEO Meta Description
            </label>
            <Input
              name="seoDescription"
              type="text"
              placeholder="Custom meta description for search snippets..."
              class="bg-slate-950/80 border-slate-700/80 text-white placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>
      </div>
    </Card>

    <!-- Add-ons & Modules Section -->
    <ProductAddonsSection mode="new" />

    <div class="flex items-center justify-end gap-3 pt-2">
      <Button href="/admin/products" variant="secondary" size="md">Cancel</Button>
      <Button
        type="submit"
        variant="primary"
        size="md"
        icon="plus"
      >
        Save & Create Product
      </Button>
    </div>
  </form>

  <script is:inline>
    // Auto-generate slug from title
    const titleInput = document.getElementById("title-input");
    const slugInput = document.getElementById("slug-input");
    if (titleInput && slugInput) {
      titleInput.addEventListener("input", () => {
        if (!slugInput.dataset.touched) {
          slugInput.value = titleInput.value
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/^-+|-+$/g, "");
        }
      });
      slugInput.addEventListener("input", () => {
        slugInput.dataset.touched = "true";
      });
    }
  </script>
</AdminLayout>
