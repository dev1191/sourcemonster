---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createProduct, createProductChangeLog } from "../../../services";
import { slugify } from "../../../lib/utils";
import { Button, Card, Dropzone, Toast, HtmlEditor } from "../../../components/ui";
import { Input } from "../../../components/starwind/input";
import { Textarea } from "../../../components/starwind/textarea";
import { NativeSelect, NativeSelectOption } from "../../../components/starwind/native-select";

let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const title = formData.get("title")?.toString().trim() || "";
    const slug = slugify(formData.get("slug")?.toString().trim() || "");
    const shortDescription = formData.get("shortDescription")?.toString().trim() || "";
    const description = formData.get("description")?.toString().trim() || "";
    const codecanyonUrl = formData.get("codecanyonUrl")?.toString().trim() || "";
    const demoUrl = formData.get("demoUrl")?.toString().trim() || "";
    const documentationUrl = formData.get("documentationUrl")?.toString().trim() || "";
    const version = formData.get("version")?.toString().trim() || "";
    const status = (formData.get("status")?.toString() || "draft") as "draft" | "published";
    const isFeatured = formData.get("isFeatured") === "on";
    const sortOrder = parseInt(formData.get("sortOrder")?.toString() || "0", 10);
    const seoTitle = formData.get("seoTitle")?.toString().trim() || "";
    const seoDescription = formData.get("seoDescription")?.toString().trim() || "";

    const rawTech = formData.get("technologies")?.toString() || "";
    const technologies = rawTech
      .split(/[,\n]/)
      .map((t) => t.trim())
      .filter(Boolean);

    const rawFeatures = formData.get("features")?.toString() || "";
    let features: string[] = [];
    if (/<li[^>]*>/i.test(rawFeatures)) {
      const matches = rawFeatures.matchAll(/<li[^>]*>(.*?)<\/li>/gis);
      features = Array.from(matches, (m) =>
        m[1]
          .replace(/^<p[^>]*>/i, "")
          .replace(/<\/p>$/i, "")
          .trim()
      ).filter(Boolean);
    } else if (/<p[^>]*>/i.test(rawFeatures)) {
      const matches = rawFeatures.matchAll(/<p[^>]*>(.*?)<\/p>/gis);
      features = Array.from(matches, (m) =>
        m[1]
          .replace(/<br\s*\/?>/gi, "\n")
          .split("\n")
          .map((f) => f.trim())
      )
        .flat()
        .filter(Boolean);
    } else {
      features = rawFeatures
        .replace(/<br\s*\/?>/gi, "\n")
        .split("\n")
        .map((f) => f.trim())
        .filter(Boolean);
    }

    const thumbnailFile = formData.get("thumbnail") as File | null;

    const newProduct = await createProduct(
      {
        title,
        slug,
        shortDescription,
        description,
        codecanyonUrl,
        demoUrl,
        documentationUrl,
        version,
        technologies,
        features,
        status,
        isFeatured,
        sortOrder,
        seoTitle,
        seoDescription,
      },
      thumbnailFile
    );

    const initialChangelog = formData.get("initialChangelog")?.toString().trim();
    if (initialChangelog) {
      await createProductChangeLog({
        productId: newProduct.id,
        version: newProduct.version || "v1.0.0",
        content: initialChangelog,
      });
    }

    return Astro.redirect(`/admin/products/${newProduct.id}/edit`);
  } catch (err: any) {
    console.error("Create product failed:", err);
    errorMessage = err?.message || "Failed to create product. Check server logs.";
  }
}
---

<AdminLayout title="New Product | SourceMonster Admin" activeNav="products">
  <div class="flex items-center justify-between pb-6 border-b border-slate-200 dark:border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-1">
        <a href="/admin/products" class="hover:text-slate-900 dark:hover:text-white transition">Products</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-white">Create</span>
      </div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Create New Product</h1>
    </div>
    <Button href="/admin/products" variant="secondary" size="sm">Cancel</Button>
  </div>

  <Toast variant="error" message={errorMessage} />

  <form method="POST" enctype="multipart/form-data" class="my-6 space-y-6 max-w-4xl">
    <!-- Basic Info Card -->
    <Card title="Basic Info" icon="package">
      <div class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Product Title *
            </label>
            <Input
              id="title-input"
              name="title"
              type="text"
              required
              placeholder="e.g. MonsterSaaS Boilerplate"
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              URL Slug *
            </label>
            <Input
              id="slug-input"
              name="slug"
              type="text"
              required
              placeholder="e.g. monstersaas-boilerplate"
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white font-mono placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
            Short Description (Card Summary) *
          </label>
          <Textarea
            name="shortDescription"
            rows={2}
            required
            placeholder="Brief 1-2 sentence pitch for catalog cards..."
            class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
          />
        </div>

        <HtmlEditor
          name="description"
          label="Full Description"
          required
          placeholder="Detailed product overview, architectural capabilities, value proposition, and technical specs..."
          helperText="Format your architecture overview using rich text, headings, lists, code blocks, or raw HTML."
        />

        <Dropzone
          name="thumbnail"
          label="Thumbnail Image"
          helperText="PNG, JPG, WebP, or SVG (Recommended: 1200x800px)"
          maxSizeLabel="Max 5MB"
          accept="image/png,image/jpeg,image/webp,image/svg+xml"
        />
      </div>
    </Card>

    <!-- URLs & Technical Specifications Card -->
    <Card title="Links & Meta" icon="link-2">
      <div class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              CodeCanyon URL
            </label>
            <Input
              name="codecanyonUrl"
              type="url"
              placeholder="https://codecanyon.net/item/..."
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Live Demo URL
            </label>
            <Input
              name="demoUrl"
              type="url"
              placeholder="https://demo.sourcemonster.in/..."
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Documentation URL
            </label>
            <Input
              name="documentationUrl"
              type="url"
              placeholder="https://docs.sourcemonster.in/..."
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Technologies (comma separated)
            </label>
            <Input
              name="technologies"
              type="text"
              placeholder="TypeScript, Astro, PostgreSQL, Tailwind"
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Version
            </label>
            <Input
              name="version"
              type="text"
              placeholder="v1.0.0"
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>

        <HtmlEditor
          name="features"
          label="Key Features & Capabilities (Bulleted List)"
          minHeight="180px"
          placeholder="<ul><li>Turnkey multi-tenant isolation</li><li>Stripe subscriptions and webhook handler</li><li>Dark-mode modern dashboard UI</li></ul>"
          helperText="Format key capabilities using bulleted lists, numbered lists, or bold highlights."
        />

        <!-- Initial Changelog / Release Notes -->
        <div class="pt-4 border-t border-slate-200 dark:border-slate-800/80">
          <div class="flex items-center justify-between mb-2">
            <label class="block text-xs font-semibold text-primary uppercase tracking-wider flex items-center gap-1.5">
              <i data-lucide="git-commit" class="w-3.5 h-3.5"></i>
              Initial Release Notes / Changelog (Optional)
            </label>
            <span class="text-[11px] text-slate-500 font-mono">Published as v1.0.0 entry</span>
          </div>
          <HtmlEditor
            name="initialChangelog"
            minHeight="140px"
            placeholder="<p><strong>Initial Public Launch:</strong></p><ul><li>Initial complete system release</li><li>Modern web interface with full dark mode</li><li>Full API documentation</li></ul>"
            helperText="Write notes about what's included in this initial release to seed the product version history."
          />
        </div>
      </div>
    </Card>

    <!-- Publishing & SEO Card -->
    <Card title="Publishing & SEO" icon="globe">
      <div class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Status
            </label>
            <NativeSelect
              name="status"
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white rounded-xl"
            >
              <NativeSelectOption value="draft">Draft</NativeSelectOption>
              <NativeSelectOption value="published">Published</NativeSelectOption>
            </NativeSelect>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Sort Order
            </label>
            <Input
              name="sortOrder"
              type="number"
              value="0"
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div class="flex items-center pt-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                name="isFeatured"
                type="checkbox"
                class="w-4 h-4 rounded text-primary focus:ring-primary bg-white dark:bg-slate-950 border-slate-300 dark:border-slate-700"
              />
              <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Highlight as Featured</span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              SEO Title
            </label>
            <Input
              name="seoTitle"
              type="text"
              placeholder="Custom SEO Title..."
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              SEO Meta Description
            </label>
            <Input
              name="seoDescription"
              type="text"
              placeholder="Custom meta description for search snippets..."
              class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl"
            />
          </div>
        </div>
      </div>
    </Card>

    <div class="flex items-center justify-end gap-3 pt-2">
      <Button href="/admin/products" variant="secondary" size="md">Cancel</Button>
      <Button
        type="submit"
        variant="primary"
        size="md"
        icon="plus"
      >
        Save & Create Product
      </Button>
    </div>
  </form>

  <script>
    import { slugify } from "../../../lib/utils";

    const titleInput = document.getElementById("title-input") as HTMLInputElement | null;
    const slugInput = document.getElementById("slug-input") as HTMLInputElement | null;

    if (titleInput && slugInput) {
      titleInput.addEventListener("input", () => {
        if (!slugInput.dataset.touched) {
          slugInput.value = slugify(titleInput.value);
        }
      });
      slugInput.addEventListener("input", () => {
        slugInput.dataset.touched = "true";
      });
    }
  </script>
</AdminLayout>
