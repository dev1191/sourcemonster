---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../lib/db";
import { products, media } from "../../../lib/db/schema";
import { desc, eq } from "drizzle-orm";
import { getPublicUrl } from "../../../lib/storage";

let allProducts: Array<typeof products.$inferSelect & { thumbnailUrl?: string | null }> = [];

try {
  const result = await db
    .select({
      product: products,
      mediaRecord: media,
    })
    .from(products)
    .leftJoin(media, eq(products.thumbnailMediaId, media.id))
    .orderBy(desc(products.sortOrder), desc(products.createdAt));

  allProducts = result.map(({ product, mediaRecord }) => ({
    ...product,
    thumbnailUrl: mediaRecord ? getPublicUrl(mediaRecord.objectKey, mediaRecord.disk) : null,
  }));
} catch (e) {
  console.error("Failed to load products list:", e);
}
---

<AdminLayout title="Products | SourceMonster Admin" activeNav="products">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">CodeCanyon Products</h1>
      <p class="text-xs text-slate-400 mt-1">Manage product showcases, CodeCanyon links, demos, and pricing metadata.</p>
    </div>
    <div class="flex items-center gap-3">
      <a
        href="/admin/products/new"
        class="inline-flex items-center gap-2 px-4 py-2 bg-primary hover:bg-orange-600 text-white rounded-xl text-xs font-semibold shadow-md shadow-primary/20 transition"
      >
        <i data-lucide="plus" class="w-4 h-4"></i>
        Create Product
      </a>
    </div>
  </div>

  <div class="my-6 bg-slate-900/70 border border-slate-800/80 rounded-2xl overflow-hidden shadow-xl shadow-black/40">
    {allProducts.length === 0 ? (
      <div class="py-16 text-center text-slate-500 text-xs">
        <i data-lucide="package" class="w-12 h-12 mx-auto mb-3 text-slate-600"></i>
        <div class="font-semibold text-slate-300 text-sm">No products found</div>
        <div class="mt-1">Seed default products or click "Create Product" above.</div>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950/80 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
            <tr>
              <th class="px-4 py-3.5">Product</th>
              <th class="px-4 py-3.5">Version</th>
              <th class="px-4 py-3.5">Status</th>
              <th class="px-4 py-3.5">Featured</th>
              <th class="px-4 py-3.5">Sort Order</th>
              <th class="px-4 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            {allProducts.map((p) => (
              <tr class="hover:bg-slate-800/30 transition">
                <td class="px-4 py-3.5">
                  <div class="flex items-center gap-3">
                    {p.thumbnailUrl ? (
                      <img src={p.thumbnailUrl} alt={p.title} class="w-10 h-10 rounded-lg object-cover bg-slate-800 border border-slate-700/60 shrink-0" />
                    ) : (
                      <div class="w-10 h-10 rounded-lg bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-slate-500 shrink-0">
                        <i data-lucide="image" class="w-4 h-4"></i>
                      </div>
                    )}
                    <div class="overflow-hidden">
                      <div class="font-bold text-white text-sm truncate max-w-xs">{p.title}</div>
                      <div class="text-[11px] text-slate-400 font-mono truncate">/{p.slug}</div>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3.5 font-mono text-slate-400">
                  {p.version || "—"}
                </td>
                <td class="px-4 py-3.5">
                  <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase ${
                    p.status === "published"
                      ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                      : "bg-slate-800 text-slate-400 border border-slate-700"
                  }`}>
                    {p.status}
                  </span>
                </td>
                <td class="px-4 py-3.5">
                  {p.isFeatured ? (
                    <span class="inline-flex items-center gap-1 text-[11px] text-amber-400 font-medium">
                      <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-400 text-amber-400"></i>
                      Yes
                    </span>
                  ) : (
                    <span class="text-slate-500 text-[11px]">No</span>
                  )}
                </td>
                <td class="px-4 py-3.5 font-mono text-slate-400">
                  {p.sortOrder}
                </td>
                <td class="px-4 py-3.5 text-right">
                  <div class="inline-flex items-center gap-1.5">
                    {p.status === "published" && (
                      <a
                        href={`/products/${p.slug}`}
                        target="_blank"
                        class="p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition"
                        title="View Public Page"
                      >
                        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                      </a>
                    )}
                    <a
                      href={`/admin/products/${p.id}/edit`}
                      class="p-1.5 text-slate-400 hover:text-primary rounded-lg hover:bg-slate-800 transition"
                      title="Edit Product"
                    >
                      <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

