---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../lib/db";
import { products, media } from "../../../lib/db/schema";
import { desc, eq } from "drizzle-orm";
import { getPublicUrl } from "../../../lib/storage";
import {
  Button,
  Table,
  TableHeader,
  TableBody,
  TableHead,
  TableRow,
  TableCell,
} from "../../../components/ui";
import { Badge } from "../../../components/starwind/badge";

let allProducts: Array<typeof products.$inferSelect & { thumbnailUrl?: string | null }> = [];

try {
  const result = await db
    .select({
      product: products,
      mediaRecord: media,
    })
    .from(products)
    .leftJoin(media, eq(products.thumbnailMediaId, media.id))
    .orderBy(desc(products.sortOrder), desc(products.createdAt));

  allProducts = result.map(({ product, mediaRecord }) => ({
    ...product,
    thumbnailUrl: mediaRecord ? getPublicUrl(mediaRecord.objectKey, mediaRecord.disk) : null,
  }));
} catch (e) {
  console.error("Failed to load products list:", e);
}
---

<AdminLayout title="Products | SourceMonster Admin" activeNav="products">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">CodeCanyon Products</h1>
      <p class="text-xs text-slate-400 mt-1">Manage product showcases, CodeCanyon links, demos, and pricing metadata.</p>
    </div>
    <div class="flex items-center gap-3">
      <Button href="/admin/products/new" variant="primary" size="sm" icon="plus">
        Create Product
      </Button>
    </div>
  </div>

  <Table
    isEmpty={allProducts.length === 0}
    emptyIcon="package"
    emptyTitle="No products found"
    emptySubtitle="Seed default products or click 'Create Product' above."
    containerClass="my-6"
  >
    <TableHeader class="bg-slate-950/80 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
      <TableRow class="border-b border-slate-800 hover:bg-transparent">
        <TableHead class="px-4 py-3.5 text-slate-400">Product</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-400">Version</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-400">Status</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-400">Featured</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-400">Sort Order</TableHead>
        <TableHead class="px-4 py-3.5 text-right text-slate-400">Actions</TableHead>
      </TableRow>
    </TableHeader>
    <TableBody class="divide-y divide-slate-800/60">
      {allProducts.map((p) => (
        <TableRow class="hover:bg-slate-800/30 transition border-b border-slate-800/60">
          <TableCell class="px-4 py-3.5">
            <div class="flex items-center gap-3">
              {p.thumbnailUrl ? (
                <img src={p.thumbnailUrl} alt={p.title} class="w-10 h-10 rounded-lg object-cover bg-slate-800 border border-slate-700/60 shrink-0" />
              ) : (
                <div class="w-10 h-10 rounded-lg bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-slate-500 shrink-0">
                  <i data-lucide="image" class="w-4 h-4"></i>
                </div>
              )}
              <div class="min-w-0">
                <div class="font-bold text-white text-sm truncate max-w-sm lg:max-w-md">{p.title}</div>
                <div class="text-[11px] text-slate-400 font-mono truncate">/{p.slug}</div>
              </div>
            </div>
          </TableCell>
          <TableCell class="px-4 py-3.5 font-mono text-slate-400">
            {p.version || "—"}
          </TableCell>
          <TableCell class="px-4 py-3.5">
            <Badge variant={p.status === "published" ? "success" : "secondary"} size="sm">
              {p.status}
            </Badge>
          </TableCell>
          <TableCell class="px-4 py-3.5">
            {p.isFeatured ? (
              <Badge variant="warning" size="sm">Featured</Badge>
            ) : (
              <span class="text-slate-600">—</span>
            )}
          </TableCell>
          <TableCell class="px-4 py-3.5 font-mono text-slate-300">
            {p.sortOrder}
          </TableCell>
          <TableCell class="px-4 py-3.5 text-right">
            <div class="flex items-center justify-end gap-2">
              {p.status === "published" && (
                <a
                  href={`/products/${p.slug}`}
                  target="_blank"
                  class="p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition"
                  title="View Public Page"
                >
                  <i data-lucide="external-link" class="w-4 h-4"></i>
                </a>
              )}
              <Button
                href={`/admin/products/${p.id}/edit`}
                variant="secondary"
                size="xs"
                icon="edit-3"
              >
                Edit
              </Button>
            </div>
          </TableCell>
        </TableRow>
      ))}
    </TableBody>
  </Table>
</AdminLayout>
