---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import {
  getAllAdminAddons,
  deleteAddon,
  getAllAdminProducts,
} from "../../../../services";
import {
  Button,
  Table,
  TableHeader,
  TableBody,
  TableHead,
  TableRow,
  TableCell,
} from "../../../../components/ui";
import { Badge } from "../../../../components/starwind/badge";

// Handle delete action
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("_action")?.toString();
    if (action === "delete") {
      const addonId = formData.get("addonId")?.toString();
      if (addonId) {
        await deleteAddon(addonId);
        return Astro.redirect("/admin/products/addons");
      }
    }
  } catch (e) {
    console.error("Failed to delete addon:", e);
  }
}

const selectedProductId = Astro.url.searchParams.get("product") || "";
const allProductsList = await getAllAdminProducts();
const allAddons = await getAllAdminAddons(selectedProductId);
---

<AdminLayout title="Product Add-ons | SourceMonster Admin" activeNav="addons">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-black text-white tracking-tight">Product Add-ons &amp; Modules</h1>
        <Badge variant="outline" class="border-primary/40 text-primary text-[10px] font-mono">
          {allAddons.length} {allAddons.length === 1 ? "module" : "modules"}
        </Badge>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Manage all companion plugins, modules, and extensions attached to your products.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <Button href="/admin/products" variant="secondary" size="sm" icon="package">
        All Products
      </Button>
      <Button href="/admin/products/addons/new" variant="primary" size="sm" icon="plus">
        New Add-on
      </Button>
    </div>
  </div>

  <!-- Filter by parent product if multiple products exist -->
  <Table
    isEmpty={allAddons.length === 0}
    emptyIcon="puzzle"
    emptyTitle="No add-on modules found"
    emptySubtitle="Create separate companion plugins, modules, or templates attached to any parent product."
    searchable={true}
    searchPlaceholder="Search add-on modules..."
    filters={[
      { label: "All Products", value: "", href: "/admin/products/addons", active: !selectedProductId },
      ...allProductsList.map((p) => ({
        label: p.title,
        value: p.id,
        href: `/admin/products/addons?product=${p.id}`,
        active: selectedProductId === p.id,
      })),
    ]}
    containerClass="my-6"
  >
    <div slot="empty-action" class="flex items-center justify-center gap-3">
      <Button href="/admin/products/addons/new" variant="primary" size="sm" icon="plus">
        Create First Add-on
      </Button>
    </div>

    <TableHeader class="bg-slate-950/80 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
          <TableRow class="border-b border-slate-800 hover:bg-transparent">
            <TableHead class="px-4 py-3.5 text-slate-400">Module</TableHead>
            <TableHead class="px-4 py-3.5 text-slate-400">Parent Product</TableHead>
            <TableHead class="px-4 py-3.5 text-slate-400">Pricing</TableHead>
            <TableHead class="px-4 py-3.5 text-slate-400">Status</TableHead>
            <TableHead class="px-4 py-3.5 text-slate-400">Links</TableHead>
            <TableHead class="px-4 py-3.5 text-right text-slate-400">Actions</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody class="divide-y divide-slate-800/60">
          {allAddons.map((addon) => (
            <TableRow class="hover:bg-slate-800/30 transition border-b border-slate-800/60">
              <!-- Module Thumbnail & Info -->
              <TableCell class="px-4 py-3.5">
                <div class="flex items-center gap-3">
                  {addon.thumbnailUrl ? (
                    <img
                      src={addon.thumbnailUrl}
                      alt={addon.title}
                      class="w-10 h-10 rounded-lg object-cover bg-slate-800 border border-slate-700/60 shrink-0"
                    />
                  ) : (
                    <div class="w-10 h-10 rounded-lg bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-slate-500 shrink-0">
                      <i data-lucide="puzzle" class="w-4 h-4"></i>
                    </div>
                  )}
                  <div class="overflow-hidden">
                    <a
                      href={`/admin/products/addons/${addon.id}/edit`}
                      class="font-bold text-white text-sm hover:text-primary transition truncate block max-w-xs"
                    >
                      {addon.title}
                    </a>
                  </div>
                </div>
              </TableCell>

              <!-- Parent Product -->
              <TableCell class="px-4 py-3.5">
                {addon.productTitle ? (
                  <a
                    href={`/admin/products/${addon.productId}/edit`}
                    class="text-primary hover:underline font-medium flex items-center gap-1.5 group max-w-xs truncate"
                    title="Edit Parent Product"
                  >
                    <i data-lucide="package" class="w-3.5 h-3.5 shrink-0 text-slate-500 group-hover:text-primary"></i>
                    <span class="truncate">{addon.productTitle}</span>
                  </a>
                ) : (
                  <span class="text-slate-500 italic">Unassigned</span>
                )}
              </TableCell>

              <!-- Pricing -->
              <TableCell class="px-4 py-3.5">
                {addon.isFree ? (
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    Free
                  </span>
                ) : addon.price ? (
                  <span class="font-mono font-semibold text-slate-200">
                    ${Number(addon.price).toFixed(2)}
                  </span>
                ) : (
                  <span class="text-slate-500">—</span>
                )}
              </TableCell>

              <!-- Status -->
              <TableCell class="px-4 py-3.5">
                {addon.isActive ? (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Active
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800 text-slate-400 border border-slate-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                    Inactive
                  </span>
                )}
              </TableCell>

              <!-- External Links -->
              <TableCell class="px-4 py-3.5">
                <div class="flex items-center gap-1.5">
                  {addon.demoUrl && (
                    <a
                      href={addon.demoUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="p-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition"
                      title="Live Demo"
                    >
                      <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    </a>
                  )}
                  {addon.buyUrl && (
                    <a
                      href={addon.buyUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="p-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition"
                      title="Purchase URL"
                    >
                      <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                    </a>
                  )}
                  {addon.documentationUrl && (
                    <a
                      href={addon.documentationUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="p-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition"
                      title="Documentation"
                    >
                      <i data-lucide="book-open" class="w-3.5 h-3.5"></i>
                    </a>
                  )}
                  {!addon.demoUrl && !addon.buyUrl && !addon.documentationUrl && (
                    <span class="text-slate-600">—</span>
                  )}
                </div>
              </TableCell>

              <!-- Actions -->
              <TableCell class="px-4 py-3.5 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a
                    href={`/admin/products/addons/${addon.id}/edit`}
                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700/60 transition"
                    title="Edit Add-on"
                  >
                    <i data-lucide="pencil" class="w-3 h-3"></i>
                    <span>Edit</span>
                  </a>
                  <form
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this add-on? This action cannot be undone.');"
                    class="inline"
                  >
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="addonId" value={addon.id} />
                    <button
                      type="submit"
                      class="p-1 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition"
                      title="Delete Add-on"
                    >
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </form>
                </div>
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
  </Table>
</AdminLayout>

