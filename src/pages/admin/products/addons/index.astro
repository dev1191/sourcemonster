---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { db } from "../../../../lib/db";
import { products, productAddons, media } from "../../../../lib/db/schema";
import { desc, eq } from "drizzle-orm";
import { getPublicUrl } from "../../../../lib/storage";
import { Button } from "../../../../components/ui";
import { Badge } from "../../../../components/starwind/badge";
import { Card } from "../../../../components/starwind/card";

// Handle delete action
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("_action")?.toString();
    if (action === "delete") {
      const addonId = formData.get("addonId")?.toString();
      if (addonId) {
        await db.delete(productAddons).where(eq(productAddons.id, addonId));
        return Astro.redirect("/admin/products/addons");
      }
    }
  } catch (e) {
    console.error("Failed to delete addon:", e);
  }
}

const selectedProductId = Astro.url.searchParams.get("product") || "";

let allProductsList: Array<{ id: string; title: string }> = [];
let allAddons: Array<{
  addon: typeof productAddons.$inferSelect;
  productTitle: string | null;
  productSlug: string | null;
  thumbnailUrl: string | null;
}> = [];

try {
  allProductsList = await db
    .select({
      id: products.id,
      title: products.title,
    })
    .from(products)
    .orderBy(products.title);

  const query = db
    .select({
      addon: productAddons,
      product: {
        id: products.id,
        title: products.title,
        slug: products.slug,
      },
      mediaRecord: media,
    })
    .from(productAddons)
    .leftJoin(products, eq(productAddons.productId, products.id))
    .leftJoin(media, eq(productAddons.thumbnailMediaId, media.id))
    .orderBy(desc(productAddons.createdAt));

  const result = await query;

  allAddons = result
    .filter((r) => (!selectedProductId ? true : r.addon.productId === selectedProductId))
    .map(({ addon, product, mediaRecord }) => ({
      addon,
      productTitle: product?.title || null,
      productSlug: product?.slug || null,
      thumbnailUrl: mediaRecord ? getPublicUrl(mediaRecord.objectKey, mediaRecord.disk) : null,
    }));
} catch (e) {
  console.error("Failed to load product addons:", e);
}
---

<AdminLayout title="Product Add-ons | SourceMonster Admin" activeNav="addons">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-black text-white tracking-tight">Product Add-ons &amp; Modules</h1>
        <Badge variant="outline" class="border-primary/40 text-primary text-[10px] font-mono">
          {allAddons.length} {allAddons.length === 1 ? "module" : "modules"}
        </Badge>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Manage all companion plugins, modules, and extensions attached to your products.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <Button href="/admin/products" variant="secondary" size="sm" icon="package">
        All Products
      </Button>
      <Button href="/admin/products/addons/new" variant="primary" size="sm" icon="plus">
        New Add-on
      </Button>
    </div>
  </div>

  <!-- Filter by parent product if multiple products exist -->
  {allProductsList.length > 0 && (
    <div class="mt-6 flex items-center justify-between gap-4 p-3 bg-slate-900/60 border border-slate-800 rounded-xl text-xs">
      <div class="flex items-center gap-2 text-slate-400">
        <i data-lucide="filter" class="w-3.5 h-3.5"></i>
        <span>Filter by Parent Product:</span>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/admin/products/addons"
          class={`px-2.5 py-1 rounded-lg transition ${
            !selectedProductId
              ? "bg-primary text-white font-semibold"
              : "text-slate-400 hover:text-white hover:bg-slate-800"
          }`}
        >
          All
        </a>
        {allProductsList.map((p) => (
          <a
            href={`/admin/products/addons?product=${p.id}`}
            class={`px-2.5 py-1 rounded-lg transition truncate max-w-[180px] ${
              selectedProductId === p.id
                ? "bg-primary text-white font-semibold"
                : "text-slate-400 hover:text-white hover:bg-slate-800"
            }`}
            title={p.title}
          >
            {p.title}
          </a>
        ))}
      </div>
    </div>
  )}

  <Card class="my-6 bg-slate-900/70 border-slate-800/80 rounded-2xl overflow-hidden shadow-xl shadow-black/40">
    {allAddons.length === 0 ? (
      <div class="py-16 text-center text-slate-500 text-xs">
        <i data-lucide="puzzle" class="w-12 h-12 mx-auto mb-3 text-slate-600"></i>
        <div class="font-semibold text-slate-300 text-sm">No add-on modules found</div>
        <p class="mt-1 max-w-sm mx-auto text-slate-400">
          Create separate companion plugins, modules, or templates attached to any parent product.
        </p>
        <div class="mt-4 flex items-center justify-center gap-3">
          <Button href="/admin/products/addons/new" variant="primary" size="sm" icon="plus">
            Create First Add-on
          </Button>
        </div>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950/80 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
            <tr>
              <th class="px-4 py-3.5">Module</th>
              <th class="px-4 py-3.5">Parent Product</th>
              <th class="px-4 py-3.5">Pricing</th>
              <th class="px-4 py-3.5">Status</th>
              <th class="px-4 py-3.5">Links</th>
              <th class="px-4 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            {allAddons.map(({ addon, productTitle, productSlug, thumbnailUrl }) => (
              <tr class="hover:bg-slate-800/30 transition">
                <!-- Module Thumbnail & Info -->
                <td class="px-4 py-3.5">
                  <div class="flex items-center gap-3">
                    {thumbnailUrl ? (
                      <img
                        src={thumbnailUrl}
                        alt={addon.title}
                        class="w-10 h-10 rounded-lg object-cover bg-slate-800 border border-slate-700/60 shrink-0"
                      />
                    ) : (
                      <div class="w-10 h-10 rounded-lg bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-slate-500 shrink-0">
                        <i data-lucide="puzzle" class="w-4 h-4"></i>
                      </div>
                    )}
                    <div class="overflow-hidden">
                      <a
                        href={`/admin/products/addons/${addon.id}/edit`}
                        class="font-bold text-white text-sm hover:text-primary transition truncate block max-w-xs"
                      >
                        {addon.title}
                      </a>
                      <div class="text-[11px] text-slate-400 font-mono truncate">
                        {addon.slug ? `/${addon.slug}` : "—"}
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Parent Product -->
                <td class="px-4 py-3.5">
                  {productTitle ? (
                    <a
                      href={`/admin/products/${addon.productId}/edit`}
                      class="text-primary hover:underline font-medium flex items-center gap-1.5 group max-w-xs truncate"
                      title="Edit Parent Product"
                    >
                      <i data-lucide="package" class="w-3.5 h-3.5 shrink-0 text-slate-500 group-hover:text-primary"></i>
                      <span class="truncate">{productTitle}</span>
                    </a>
                  ) : (
                    <span class="text-slate-500 italic">Unassigned</span>
                  )}
                </td>

                <!-- Pricing -->
                <td class="px-4 py-3.5">
                  {addon.isFree ? (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      Free
                    </span>
                  ) : addon.price ? (
                    <span class="font-mono font-semibold text-slate-200">
                      ${Number(addon.price).toFixed(2)}
                    </span>
                  ) : (
                    <span class="text-slate-500">—</span>
                  )}
                </td>

                <!-- Status -->
                <td class="px-4 py-3.5">
                  {addon.isActive ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      Active
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800 text-slate-400 border border-slate-700">
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                      Inactive
                    </span>
                  )}
                </td>

                <!-- External Links -->
                <td class="px-4 py-3.5">
                  <div class="flex items-center gap-1.5">
                    {addon.demoUrl && (
                      <a
                        href={addon.demoUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="p-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition"
                        title="Live Demo"
                      >
                        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                      </a>
                    )}
                    {addon.buyUrl && (
                      <a
                        href={addon.buyUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="p-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition"
                        title="Purchase URL"
                      >
                        <i data-lucide="shopping-cart" class="w-3.5 h-3.5"></i>
                      </a>
                    )}
                    {addon.documentationUrl && (
                      <a
                        href={addon.documentationUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="p-1 rounded bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition"
                        title="Documentation"
                      >
                        <i data-lucide="book-open" class="w-3.5 h-3.5"></i>
                      </a>
                    )}
                    {!addon.demoUrl && !addon.buyUrl && !addon.documentationUrl && (
                      <span class="text-slate-600">—</span>
                    )}
                  </div>
                </td>

                <!-- Actions -->
                <td class="px-4 py-3.5 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a
                      href={`/admin/products/addons/${addon.id}/edit`}
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700/60 transition"
                      title="Edit Add-on"
                    >
                      <i data-lucide="pencil" class="w-3 h-3"></i>
                      <span>Edit</span>
                    </a>
                    <form
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to delete this add-on? This action cannot be undone.');"
                      class="inline"
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <input type="hidden" name="addonId" value={addon.id} />
                      <button
                        type="submit"
                        class="p-1 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition"
                        title="Delete Add-on"
                      >
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </Card>
</AdminLayout>

