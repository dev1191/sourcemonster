---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAllAdminFaqs, deleteFaq, getFaqCategories } from "../../../services";
import {
  Button,
  Table,
  TableHeader,
  TableBody,
  TableHead,
  TableRow,
  TableCell,
  ConfirmDialog,
} from "../../../components/ui";
import { Badge } from "../../../components/starwind/badge";

// Handle POST actions (e.g. delete)
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("_action")?.toString();
    if (action === "delete") {
      const faqId = formData.get("faqId")?.toString();
      if (faqId) {
        await deleteFaq(faqId);
        const search = Astro.url.search;
        return Astro.redirect(`/admin/faqs${search}`);
      }
    }
  } catch (e) {
    console.error("Failed to process FAQ action:", e);
  }
}

const selectedCategory = Astro.url.searchParams.get("category") || "";
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get("page") || "1", 10));
const pageSize = 10;
const searchQuery = Astro.url.searchParams.get("q") || "";

const faqsData = await getAllAdminFaqs({
  category: selectedCategory,
  page: currentPage,
  pageSize,
  search: searchQuery,
});

const allFaqs = faqsData.items;
const categories = await getFaqCategories();
---

<AdminLayout title="FAQs | SourceMonster Admin" activeNav="faqs">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Frequently Asked Questions</h1>
        <Badge variant="outline" class="border-primary/40 text-primary text-[10px] font-mono">
          {faqsData.total} {faqsData.total === 1 ? "FAQ" : "FAQs"}
        </Badge>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Manage customer questions, platform capabilities, and licensing clarifications.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <Button href="/admin/faqs/new" variant="primary" size="sm" icon="plus">
        Add FAQ
      </Button>
    </div>
  </div>

  <Table
    isEmpty={allFaqs.length === 0}
    emptyIcon="help-circle"
    emptyTitle="No FAQs found"
    emptySubtitle="Create helpful question and answer pairs displayed on the public landing page."
    searchable={true}
    searchPlaceholder="Search questions or answers..."
    searchAction="/admin/faqs"
    searchParamName="q"
    searchValue={searchQuery}
    filters={[
      { label: "All Categories", value: "", href: `/admin/faqs${searchQuery ? `?q=${encodeURIComponent(searchQuery)}` : ""}`, active: !selectedCategory },
      ...categories.map((c) => ({
        label: c,
        value: c,
        href: `/admin/faqs?category=${encodeURIComponent(c)}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ""}`,
        active: selectedCategory === c,
      })),
    ]}
    currentPage={faqsData.page}
    totalPages={faqsData.totalPages}
    totalItems={faqsData.total}
    pageSize={faqsData.pageSize}
    containerClass="my-6"
  >
    <div slot="empty-action" class="flex items-center justify-center gap-3">
      <Button href="/admin/faqs/new" variant="primary" size="sm" icon="plus">
        Create First FAQ
      </Button>
    </div>

    <TableHeader class="bg-slate-50 dark:bg-slate-950/80 text-[11px] uppercase tracking-wider text-slate-600 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
      <TableRow class="border-b border-slate-200 dark:border-slate-800 hover:bg-transparent">
        <TableHead class="px-4 py-3.5 text-slate-600 dark:text-slate-400 font-semibold">Question</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-600 dark:text-slate-400 font-semibold">Category</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-600 dark:text-slate-400 font-semibold">Status</TableHead>
        <TableHead class="px-4 py-3.5 text-slate-600 dark:text-slate-400 font-semibold">Sort Order</TableHead>
        <TableHead class="px-4 py-3.5 text-right text-slate-600 dark:text-slate-400 font-semibold">Actions</TableHead>
      </TableRow>
    </TableHeader>
    <TableBody class="divide-y divide-slate-200 dark:divide-slate-800/60">
      {allFaqs.map((faq) => (
        <TableRow class="hover:bg-slate-50/80 dark:hover:bg-slate-800/30 transition border-b border-slate-200 dark:border-slate-800/60">
          <!-- Question & snippet -->
          <TableCell class="px-4 py-3.5">
            <a
              href={`/admin/faqs/${faq.id}/edit`}
              class="font-bold text-slate-900 dark:text-white text-sm hover:text-primary transition block max-w-lg truncate"
            >
              {faq.question}
            </a>
            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1 max-w-lg mt-0.5">
              {faq.answer}
            </p>
          </TableCell>

          <!-- Category -->
          <TableCell class="px-4 py-3.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-primary/10 text-primary border border-primary/20">
              {faq.category}
            </span>
          </TableCell>

          <!-- Status -->
          <TableCell class="px-4 py-3.5">
            {faq.isPublished ? (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
                Published
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                Draft
              </span>
            )}
          </TableCell>

          <!-- Sort Order -->
          <TableCell class="px-4 py-3.5 font-mono text-xs text-slate-600 dark:text-slate-400">
            {faq.sortOrder}
          </TableCell>

          <!-- Actions -->
          <TableCell class="px-4 py-3.5 text-right">
            <div class="flex items-center justify-end gap-2">
              <a
                href={`/admin/faqs/${faq.id}/edit`}
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700/60 transition"
                title="Edit FAQ"
              >
                <i data-lucide="pencil" class="w-3 h-3"></i>
                <span>Edit</span>
              </a>
              <ConfirmDialog
                title="Delete FAQ"
                description={`Are you sure you want to delete "${faq.question}"? This action cannot be undone.`}
                confirmText="Delete FAQ"
                confirmVariant="destructive"
                confirmIcon="trash-2"
                icon="trash-2"
                formMethod="POST"
              >
                <input type="hidden" name="_action" value="delete" slot="form-fields" />
                <input type="hidden" name="faqId" value={faq.id} slot="form-fields" />
                <button
                  slot="trigger"
                  type="button"
                  class="p-1 text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition cursor-pointer"
                  title="Delete FAQ"
                >
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                </button>
              </ConfirmDialog>
            </div>
          </TableCell>
        </TableRow>
      ))}
    </TableBody>
  </Table>
</AdminLayout>

