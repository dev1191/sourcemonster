---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
  getLeadById,
  updateLead,
  deleteLead,
  getAdminProductById,
} from "../../../services";
import { Card, CardHeader, CardTitle, CardContent } from "../../../components/starwind/card";
import { Textarea } from "../../../components/starwind/textarea";
import { Badge } from "../../../components/starwind/badge";
import { Button, Toast, ConfirmDialog } from "../../../components/ui";
import { NativeSelect, NativeSelectOption } from "../../../components/starwind/native-select";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/leads");
}

let feedbackMessage = "";
let isError = false;

// Handle status or notes update / deletion
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("_action")?.toString();

    if (action === "delete") {
      await deleteLead(id);
      return Astro.redirect("/admin/leads");
    }

    if (action === "update") {
      const statusRaw = (formData.get("status")?.toString() || "new") as any;
      const adminNotes = formData.get("adminNotes")?.toString() || null;

      await updateLead(id, {
        status: statusRaw,
        adminNotes,
      });

      feedbackMessage = "Lead updated successfully!";
    }
  } catch (err: any) {
    console.error("Failed to update lead:", err);
    isError = true;
    feedbackMessage = err?.message || "Failed to update lead.";
  }
}

// Query lead record
const lead = await getLeadById(id);

if (!lead) {
  return Astro.redirect("/admin/leads");
}

// Query related product if any
let relatedProduct = null;
if (lead.productId) {
  const prodData = await getAdminProductById(lead.productId);
  relatedProduct = prodData?.product || null;
}

const statusBadgeVariant =
  lead.status === "new"
    ? "primary"
    : lead.status === "contacted"
    ? "info"
    : lead.status === "qualified"
    ? "success"
    : lead.status === "converted"
    ? "warning"
    : "secondary";
---

<AdminLayout title={`Lead: ${lead.name} | SourceMonster Admin`} activeNav="leads">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-1">
        <a href="/admin/leads" class="hover:text-slate-900 dark:hover:text-white transition">Leads</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white">Inspect Lead</span>
      </div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
        <span>{lead.name}</span>
        <Badge variant={statusBadgeVariant} size="sm">
          {lead.status}
        </Badge>
      </h1>
    </div>

    <div class="flex items-center gap-2">
      <Button
        href={`mailto:${lead.email}?subject=${encodeURIComponent(`Re: ${lead.subject || "Your Inquiry to SourceMonster"}`)}`}
        variant="primary"
        size="sm"
        icon="mail"
      >
        Reply via Email
      </Button>
      <Button href="/admin/leads" variant="secondary" size="sm">Back to list</Button>
    </div>
  </div>

  <Toast variant={isError ? "error" : "success"} message={feedbackMessage} />

  <div class="my-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Column: Message & Details -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Full Inquiry Message Card -->
      <Card class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-sm dark:shadow-xl">
        <CardHeader>
          <CardTitle class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider flex items-center gap-2">
            <i data-lucide="message-square" class="w-4 h-4 text-primary"></i>
            Inquiry Message
          </CardTitle>
        </CardHeader>
        <CardContent class="pt-2">
          <div class="p-5 bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-800 dark:text-slate-200 text-sm leading-relaxed whitespace-pre-line font-sans">
            {lead.message}
          </div>
        </CardContent>
      </Card>

      <!-- Prospect Context & Metadata Card -->
      <Card class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-sm dark:shadow-xl">
        <CardHeader>
          <CardTitle class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider flex items-center gap-2">
            <i data-lucide="user-check" class="w-4 h-4 text-blue-500 dark:text-blue-400"></i>
            Contact & Source Metadata
          </CardTitle>
        </CardHeader>

        <CardContent class="pt-2">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div>
              <dt class="text-slate-500 uppercase tracking-wider font-semibold">Email Address</dt>
              <dd class="mt-1 font-mono text-slate-900 dark:text-white text-sm">
                <a href={`mailto:${lead.email}`} class="hover:text-primary transition underline">
                  {lead.email}
                </a>
              </dd>
            </div>

            <div>
              <dt class="text-slate-500 uppercase tracking-wider font-semibold">Company / Organization</dt>
              <dd class="mt-1 text-slate-900 dark:text-white font-medium">{lead.company || "Not provided"}</dd>
            </div>

            <div>
              <dt class="text-slate-500 uppercase tracking-wider font-semibold">Service / Interest</dt>
              <dd class="mt-1 text-slate-900 dark:text-white font-medium">{lead.serviceId || lead.subject || "General"}</dd>
            </div>

            <div>
              <dt class="text-slate-500 uppercase tracking-wider font-semibold">Budget Range</dt>
              <dd class="mt-1 text-slate-900 dark:text-white font-medium">{lead.budget || "Not provided"}</dd>
            </div>

            <div>
              <dt class="text-slate-500 uppercase tracking-wider font-semibold">Source Page Attribution</dt>
              <dd class="mt-1 font-mono text-slate-500 dark:text-slate-400 truncate">{lead.sourcePage || "/"}</dd>
            </div>

            <div>
              <dt class="text-slate-500 uppercase tracking-wider font-semibold">Timestamp Received</dt>
              <dd class="mt-1 font-mono text-slate-500 dark:text-slate-400">
                {new Date(lead.createdAt).toLocaleString()}
              </dd>
            </div>
          </dl>

          {relatedProduct && (
            <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between p-3.5 bg-slate-50 dark:bg-slate-950/60 rounded-xl border border-slate-200 dark:border-slate-800/80">
              <div>
                <div class="text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider font-bold">Associated Product</div>
                <div class="text-sm font-bold text-slate-900 dark:text-white">{relatedProduct.title}</div>
              </div>
              <a
                href={`/products/${relatedProduct.slug}`}
                target="_blank"
                class="px-3 py-1.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition border border-slate-200 dark:border-slate-700/60"
              >
                <span>View Product</span>
                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
              </a>
            </div>
          )}
        </CardContent>
      </Card>
    </div>

    <!-- Sidebar Column: Management & Notes -->
    <div class="space-y-6">
      <Card class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-sm dark:shadow-xl">
        <CardHeader>
          <CardTitle class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider flex items-center gap-2">
            <i data-lucide="sliders" class="w-4 h-4 text-emerald-500 dark:text-emerald-400"></i>
            Pipeline Status
          </CardTitle>
        </CardHeader>
        <CardContent class="pt-2">
          <form method="POST" class="space-y-4">
            <input type="hidden" name="_action" value="update" />

            <div>
              <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                Current Stage
              </label>
              <NativeSelect
                name="status"
                class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white rounded-xl"
              >
                <NativeSelectOption value="new" selected={lead.status === "new"}>New / Unread</NativeSelectOption>
                <NativeSelectOption value="contacted" selected={lead.status === "contacted"}>Contacted</NativeSelectOption>
                <NativeSelectOption value="qualified" selected={lead.status === "qualified"}>Qualified Prospect</NativeSelectOption>
                <NativeSelectOption value="converted" selected={lead.status === "converted"}>Converted Client</NativeSelectOption>
                <NativeSelectOption value="rejected" selected={lead.status === "rejected"}>Rejected / Closed</NativeSelectOption>
              </NativeSelect>
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-slate-700 dark:text-slate-400 uppercase tracking-wider mb-1.5">
                Internal Private Notes (Admin Only)
              </label>
              <Textarea
                name="adminNotes"
                rows={6}
                value={lead.adminNotes || ""}
                placeholder="Add internal notes about client meeting, pricing discussions, or custom development requirements..."
                class="bg-white dark:bg-slate-950/80 border-slate-300 dark:border-slate-700/80 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 leading-relaxed rounded-xl text-xs"
              />
            </div>

            <Button
              type="submit"
              variant="primary"
              size="md"
              class="w-full bg-primary hover:bg-orange-600 text-white shadow-md shadow-primary/25 font-bold"
            >
              Save Pipeline Updates
            </Button>
          </form>
        </CardContent>
      </Card>

      <!-- Delete Lead Action Card -->
      <Card class="bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-sm dark:shadow-xl">
        <CardContent class="pt-6">
          <h3 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Danger Zone</h3>
          <p class="text-[11px] text-slate-500 mb-4">
            Permanently remove this inquiry from your database. This action cannot be reversed.
          </p>
          <ConfirmDialog
            title="Delete Lead Inquiry"
            description="Are you sure you want to permanently delete this lead inquiry? This action cannot be reversed."
            confirmText="Delete Lead Record"
            confirmVariant="destructive"
            confirmIcon="trash-2"
            icon="trash-2"
            formMethod="POST"
            class="w-full"
          >
            <input type="hidden" name="_action" value="delete" slot="form-fields" />
            <Button
              slot="trigger"
              type="button"
              variant="danger"
              size="sm"
              class="w-full"
              icon="trash-2"
            >
              Delete Lead Record
            </Button>
          </ConfirmDialog>
        </CardContent>
      </Card>
    </div>
  </div>
</AdminLayout>
