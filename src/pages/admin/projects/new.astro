---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createProject, createProjectChangeLog } from "../../../services";
import { slugify } from "../../../lib/utils";
import { Button, Toast } from "../../../components/ui";
import {
  ProjectGeneralInfo,
  ProjectFeaturesTech,
  ProjectMediaUpload,
  ProjectSidebarStatus,
  ProjectLinksVersion,
  ProjectSeoSection,
  ProjectInitialChangelog,
} from "../../../components/admin/projects";

let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const title = formData.get("title")?.toString().trim() || "";
    const slug = slugify(formData.get("slug")?.toString().trim() || "");
    const shortDescription =
      formData.get("shortDescription")?.toString().trim() || "";
    const description = formData.get("description")?.toString().trim() || "";
    const codecanyonUrl =
      formData.get("codecanyonUrl")?.toString().trim() || "";
    const demoUrl = formData.get("demoUrl")?.toString().trim() || "";
    const documentationUrl =
      formData.get("documentationUrl")?.toString().trim() || "";
    const version = formData.get("version")?.toString().trim() || "";
    const status = (formData.get("status")?.toString() || "draft") as
      "draft" | "published";
    const isFeatured = formData.get("isFeatured") === "on";
    const sortOrder = parseInt(
      formData.get("sortOrder")?.toString() || "0",
      10,
    );
    const seoTitle = formData.get("seoTitle")?.toString().trim() || "";
    const seoDescription =
      formData.get("seoDescription")?.toString().trim() || "";

    const rawTech = formData.get("technologies")?.toString() || "";
    const technologies = rawTech
      .split(/[,\n]/)
      .map((t) => t.trim())
      .filter(Boolean);

    const features = formData.get("features")?.toString().trim() || "";

    const thumbnailFile = formData.get("thumbnail") as File | null;

    const newProject = await createProject(
      {
        title,
        slug,
        shortDescription,
        description,
        codecanyonUrl,
        demoUrl,
        documentationUrl,
        version,
        technologies,
        features,
        status,
        isFeatured,
        sortOrder,
        seoTitle,
        seoDescription,
      },
      thumbnailFile,
    );

    const initialChangelog = formData
      .get("initialChangelog")
      ?.toString()
      .trim();
    const initialChangelogDateRaw = formData
      .get("initialChangelogDate")
      ?.toString()
      .trim();
    const initialChangelogVersion = formData
      .get("initialChangelogVersion")
      ?.toString()
      .trim();

    if (initialChangelog) {
      const changelogDate = initialChangelogDateRaw
        ? new Date(initialChangelogDateRaw)
        : new Date();
      await createProjectChangeLog({
        projectId: newProject.id,
        version: initialChangelogVersion || newProject.version || "v1.0.0",
        content: initialChangelog,
        createdAt: !isNaN(changelogDate.getTime()) ? changelogDate : new Date(),
      });
    }

    return Astro.redirect(`/admin/projects/${newProject.id}/edit?created=1`);
  } catch (err: any) {
    console.error("Create project failed:", err);
    errorMessage =
      err?.message || "Failed to create project. Check server logs.";
  }
}
---

<AdminLayout title="Create Project | SourceMonster Admin" activeNav="projects">
  <!-- Top Command & Breadcrumb Bar -->
  <div
    class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800"
  >
    <div>
      <div
        class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-1.5 font-medium"
      >
        <a
          href="/admin/projects"
          class="hover:text-primary transition flex items-center gap-1"
        >
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
          <span>Projects</span>
        </a>
        <span class="text-slate-400 dark:text-slate-600">/</span>
        <span class="text-primary font-semibold">Create</span>
      </div>
      <h1
        class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight"
      >
        Create New Project
      </h1>
    </div>

    <!-- Quick Action Dock -->
    <div class="flex items-center gap-2.5 shrink-0">
      <Button href="/admin/projects" variant="secondary" size="sm">
        Cancel
      </Button>
      <Button
        id="create-project-top-btn"
        type="submit"
        form="project-create-form"
        variant="primary"
        size="sm"
        icon="plus"
      >
        Create Project
      </Button>
    </div>
  </div>

  <Toast variant="error" message={errorMessage} />

  <!-- Main 2-Column Responsive Workspace Form -->
  <form
    id="project-create-form"
    method="POST"
    enctype="multipart/form-data"
    class="my-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
  >
    <!-- Left Column: Core Project Content (8 Columns) -->
    <div class="lg:col-span-8 space-y-8 min-w-0">
      <ProjectGeneralInfo />
      <ProjectFeaturesTech />
      <ProjectMediaUpload isEdit={false} />
      <ProjectInitialChangelog />
    </div>

    <!-- Right Column: Sticky Sidebar (4 Columns) -->
    <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-6 self-start min-w-0">
      <ProjectSidebarStatus isEdit={false} />
      <ProjectLinksVersion />
      <ProjectSeoSection />
    </div>
  </form>

  <script>
    const form = document.getElementById(
      "project-create-form",
    ) as HTMLFormElement | null;
    const topCreateBtn = document.getElementById(
      "create-project-top-btn",
    ) as HTMLButtonElement | null;

    if (topCreateBtn && form) {
      topCreateBtn.addEventListener("click", () => {
        if (typeof form.requestSubmit === "function") {
          form.requestSubmit();
        } else {
          form.submit();
        }
      });
    }

    if (form) {
      form.addEventListener("submit", (e) => {
        if (e.defaultPrevented) return;

        const submitBtns = document.querySelectorAll<HTMLButtonElement>(
          '#create-project-top-btn, button[form="project-create-form"][type="submit"], #project-create-form button[type="submit"]',
        );
        submitBtns.forEach((btn) => {
          btn.disabled = true;
          btn.classList.add("opacity-80", "cursor-wait");
        });
      });
    }
  </script>
</AdminLayout>
