---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAllTestimonials } from "../../../services";
import {
  Table,
  TableHeader,
  TableBody,
  TableHead,
  TableRow,
  TableCell,
} from "../../../components/ui";

const allTestimonials = await getAllTestimonials();
---

<AdminLayout title="Testimonials | SourceMonster Admin" activeNav="testimonials">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">Client Testimonials</h1>
      <p class="text-xs text-slate-400 mt-1">Manage verified customer endorsements, quotes, and social proof.</p>
    </div>
    <a
      href="/admin/testimonials/new"
      class="inline-flex items-center gap-2 px-4 py-2 bg-primary hover:bg-orange-600 text-white rounded-xl text-xs font-semibold shadow-md shadow-primary/20 transition"
    >
      <i data-lucide="plus" class="w-4 h-4"></i>
      Add Testimonial
    </a>
  </div>

  <Table
    isEmpty={allTestimonials.length === 0}
    emptyIcon="message-circle"
    emptyTitle="No testimonials in database"
    emptySubtitle="Run `pnpm db:seed:content` to import existing static testimonials."
    searchable={true}
    searchPlaceholder="Search testimonials by name, role, quote..."
    containerClass="my-6"
  >
    <TableHeader class="bg-slate-950/80 text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
          <TableRow class="border-b border-slate-800 hover:bg-transparent">
            <TableHead class="px-4 py-3.5 text-slate-400">Client & Role</TableHead>
            <TableHead class="px-4 py-3.5 text-slate-400">Quote</TableHead>
            <TableHead class="px-4 py-3.5 text-slate-400">Status</TableHead>
            <TableHead class="px-4 py-3.5 text-slate-400">Sort Order</TableHead>
            <TableHead class="px-4 py-3.5 text-right text-slate-400">Actions</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody class="divide-y divide-slate-800/60">
          {allTestimonials.map((t) => (
            <TableRow class="hover:bg-slate-800/30 transition border-b border-slate-800/60">
              <TableCell class="px-4 py-3.5">
                <div class="font-bold text-white text-sm">{t.name}</div>
                <div class="text-[11px] text-slate-400">{t.role}</div>
              </TableCell>
              <TableCell class="px-4 py-3.5">
                <div class="text-slate-300 italic line-clamp-2 max-w-md">"{t.quote}"</div>
              </TableCell>
              <TableCell class="px-4 py-3.5">
                <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase ${
                  t.status === "published"
                    ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                    : "bg-slate-800 text-slate-400 border border-slate-700"
                }`}>
                  {t.status}
                </span>
              </TableCell>
              <TableCell class="px-4 py-3.5 font-mono text-slate-400">
                {t.sortOrder}
              </TableCell>
              <TableCell class="px-4 py-3.5 text-right">
                <a
                  href={`/admin/testimonials/${t.id}/edit`}
                  class="p-1.5 text-slate-400 hover:text-primary rounded-lg hover:bg-slate-800 transition"
                  title="Edit Testimonial"
                >
                  <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                </a>
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
  </Table>
</AdminLayout>

