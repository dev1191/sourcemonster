---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { db } from "../../../lib/db";
import { testimonials } from "../../../lib/db/schema";

let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const name = formData.get("name")?.toString().trim() || "";
    const role = formData.get("role")?.toString().trim() || "";
    const quote = formData.get("quote")?.toString().trim() || "";
    const color = formData.get("color")?.toString().trim() || "primary";
    const sortOrder = parseInt(formData.get("sortOrder")?.toString() || "0", 10);
    const status = (formData.get("status")?.toString() || "published") as "published" | "draft";

    if (!name || !role || !quote) {
      errorMessage = "Client name, role, and quote are required.";
    } else {
      await db.insert(testimonials).values({
        name,
        role,
        quote,
        color,
        sortOrder,
        status,
      });
      return Astro.redirect("/admin/testimonials");
    }
  } catch (err) {
    console.error("Create testimonial failed:", err);
    errorMessage = "Failed to create testimonial.";
  }
}
---

<AdminLayout title="Add Testimonial | SourceMonster Admin" activeNav="testimonials">
  <div class="flex items-center justify-between pb-6 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
        <a href="/admin/testimonials" class="hover:text-white transition">Testimonials</a>
        <span>/</span>
        <span class="text-white">New</span>
      </div>
      <h1 class="text-2xl font-black text-white tracking-tight">Add Client Testimonial</h1>
    </div>
  </div>

  {errorMessage && (
    <div class="my-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs flex items-center gap-2">
      <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
      <span>{errorMessage}</span>
    </div>
  )}

  <form method="POST" class="my-6 space-y-6 max-w-2xl bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Client Name *</label>
        <input name="name" type="text" required placeholder="e.g. Rahul Sharma" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Title & Company *</label>
        <input name="role" type="text" required placeholder="e.g. CEO, TechFlow" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm" />
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Client Quote *</label>
      <textarea name="quote" rows="4" required placeholder="The team delivered exceptional velocity and architectural quality..." class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm"></textarea>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Sort Order</label>
        <input name="sortOrder" type="number" value="0" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm font-mono" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Status</label>
        <select name="status" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm">
          <option value="published">Published</option>
          <option value="draft">Draft</option>
        </select>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
      <a href="/admin/testimonials" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm font-semibold transition">Cancel</a>
      <button type="submit" class="px-6 py-2.5 bg-primary hover:bg-orange-600 text-white rounded-xl text-sm font-semibold shadow-lg shadow-primary/25 transition">Save Testimonial</button>
    </div>
  </form>
</AdminLayout>

