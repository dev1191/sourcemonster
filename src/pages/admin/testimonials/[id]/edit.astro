---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import {
  getTestimonialById,
  updateTestimonial,
  deleteTestimonial,
} from "../../../../services";
import { Toast, ConfirmDialog } from "../../../../components/ui";

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/testimonials");

let errorMessage = "";
let successMessage = "";

const initialTestimonial = await getTestimonialById(id);
if (!initialTestimonial) return Astro.redirect("/admin/testimonials");

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("_action")?.toString();

    if (action === "delete") {
      await deleteTestimonial(id);
      return Astro.redirect("/admin/testimonials");
    }

    const name = formData.get("name")?.toString().trim() || "";
    const role = formData.get("role")?.toString().trim() || "";
    const quote = formData.get("quote")?.toString().trim() || "";
    const color = formData.get("color")?.toString().trim() || "primary";
    const sortOrder = parseInt(formData.get("sortOrder")?.toString() || "0", 10);
    const status = (formData.get("status")?.toString() || "published") as "published" | "draft";

    await updateTestimonial(id, {
      name,
      role,
      quote,
      color,
      sortOrder,
      status,
    });

    successMessage = "Testimonial updated successfully!";
  } catch (err: any) {
    console.error("Update testimonial failed:", err);
    errorMessage = err?.message || "Failed to update testimonial.";
  }
}

const currentTestimonial = (await getTestimonialById(id)) || initialTestimonial;
---

<AdminLayout title={`Edit Testimonial: ${currentTestimonial.name} | SourceMonster Admin`} activeNav="testimonials">
  <div class="flex items-center justify-between pb-6 border-b border-slate-800">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
        <a href="/admin/testimonials" class="hover:text-white transition">Testimonials</a>
        <span>/</span>
        <span class="text-white">Edit</span>
      </div>
      <h1 class="text-2xl font-black text-white tracking-tight">Edit Testimonial: {currentTestimonial.name}</h1>
    </div>
    <a href="/admin/testimonials" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-semibold transition">Back to list</a>
  </div>

  <Toast variant="error" message={errorMessage} />
  <Toast variant="success" message={successMessage} />

  <form method="POST" class="my-6 space-y-6 max-w-2xl bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Client Name *</label>
        <input name="name" type="text" required value={currentTestimonial.name} class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Title & Company *</label>
        <input name="role" type="text" required value={currentTestimonial.role} class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm" />
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Client Quote *</label>
      <textarea name="quote" rows="4" required class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm">{currentTestimonial.quote}</textarea>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Sort Order</label>
        <input name="sortOrder" type="number" value={currentTestimonial.sortOrder} class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm font-mono" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Status</label>
        <select name="status" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm">
          <option value="published" selected={currentTestimonial.status === "published"}>Published</option>
          <option value="draft" selected={currentTestimonial.status === "draft"}>Draft</option>
        </select>
      </div>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-slate-800">
      <ConfirmDialog
        title="Delete Testimonial"
        description="Are you sure you want to permanently delete this testimonial? This action cannot be undone."
        confirmText="Delete Testimonial"
        confirmVariant="destructive"
        confirmIcon="trash-2"
        icon="trash-2"
        formMethod="POST"
      >
        <input type="hidden" name="_action" value="delete" slot="form-fields" />
        <button
          slot="trigger"
          type="button"
          class="px-4 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-xl text-xs font-semibold transition cursor-pointer"
        >
          Delete Testimonial
        </button>
      </ConfirmDialog>

      <div class="flex items-center gap-3">
        <a href="/admin/testimonials" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm font-semibold transition">Cancel</a>
        <button type="submit" name="_action" value="update" class="px-6 py-2.5 bg-primary hover:bg-orange-600 text-white rounded-xl text-sm font-semibold shadow-lg shadow-primary/25 transition">Save Changes</button>
      </div>
    </div>
  </form>
</AdminLayout>

