---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../lib/db";
import { products, leads } from "../../lib/db/schema";
import { desc, eq, count } from "drizzle-orm";

// Query metrics
let totalProductsCount = 0;
let publishedProductsCount = 0;
let totalLeadsCount = 0;
let newLeadsCount = 0;

let recentProducts: Array<typeof products.$inferSelect> = [];
let recentLeads: Array<typeof leads.$inferSelect> = [];

try {
  const [productsCountRes] = await db.select({ value: count() }).from(products);
  totalProductsCount = productsCountRes?.value ?? 0;

  const [publishedRes] = await db
    .select({ value: count() })
    .from(products)
    .where(eq(products.status, "published"));
  publishedProductsCount = publishedRes?.value ?? 0;

  const [leadsCountRes] = await db.select({ value: count() }).from(leads);
  totalLeadsCount = leadsCountRes?.value ?? 0;

  const [newLeadsRes] = await db
    .select({ value: count() })
    .from(leads)
    .where(eq(leads.status, "new"));
  newLeadsCount = newLeadsRes?.value ?? 0;

  recentProducts = await db
    .select()
    .from(products)
    .orderBy(desc(products.updatedAt))
    .limit(5);

  recentLeads = await db
    .select()
    .from(leads)
    .orderBy(desc(leads.createdAt))
    .limit(5);
} catch (error) {
  console.error("Dashboard metrics load error:", error);
}

const user = Astro.locals.adminUser;
---

<AdminLayout title="Dashboard | SourceMonster Admin" activeNav="dashboard">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl font-black text-white tracking-tight">Overview Dashboard</h1>
      <p class="text-xs text-slate-400 mt-1">
        Welcome back, <span class="text-white font-medium">{user?.name}</span>. Here is what is happening across your platform.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <a
        href="/admin/products/new"
        class="inline-flex items-center gap-2 px-4 py-2 bg-primary hover:bg-orange-600 text-white rounded-xl text-xs font-semibold shadow-md shadow-primary/20 transition"
      >
        <i data-lucide="plus" class="w-4 h-4"></i>
        New Product
      </a>
      <a
        href="/admin/leads"
        class="inline-flex items-center gap-2 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-semibold border border-slate-700 transition"
      >
        <i data-lucide="inbox" class="w-4 h-4"></i>
        View Leads
      </a>
    </div>
  </div>

  <!-- Metric Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 my-6">
    <!-- Products Metric -->
    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 relative overflow-hidden">
      <div class="flex items-center justify-between text-slate-400 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wider">Total Products</span>
        <div class="p-2 bg-primary/10 text-primary rounded-lg">
          <i data-lucide="package" class="w-4 h-4"></i>
        </div>
      </div>
      <div class="text-3xl font-black text-white tracking-tight">{totalProductsCount}</div>
      <div class="mt-2 text-xs text-emerald-400 flex items-center gap-1">
        <span>{publishedProductsCount} published</span>
        <span class="text-slate-600">•</span>
        <span class="text-slate-400">{totalProductsCount - publishedProductsCount} drafts</span>
      </div>
    </div>

    <!-- Leads Metric -->
    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 relative overflow-hidden">
      <div class="flex items-center justify-between text-slate-400 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wider">Total Inquiries</span>
        <div class="p-2 bg-blue-500/10 text-blue-400 rounded-lg">
          <i data-lucide="inbox" class="w-4 h-4"></i>
        </div>
      </div>
      <div class="text-3xl font-black text-white tracking-tight">{totalLeadsCount}</div>
      <div class="mt-2 text-xs flex items-center gap-1">
        <span class={newLeadsCount > 0 ? "text-primary font-bold animate-pulse" : "text-slate-400"}>
          {newLeadsCount} unread new
        </span>
      </div>
    </div>

    <!-- Infrastructure Status -->
    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 relative overflow-hidden">
      <div class="flex items-center justify-between text-slate-400 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wider">Database Status</span>
        <div class="p-2 bg-emerald-500/10 text-emerald-400 rounded-lg">
          <i data-lucide="database" class="w-4 h-4"></i>
        </div>
      </div>
      <div class="text-base font-bold text-emerald-400 flex items-center gap-2 mt-1">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        PostgreSQL Connected
      </div>
      <div class="mt-3 text-[11px] text-slate-400">
        Drizzle ORM • Pooled Client
      </div>
    </div>

    <!-- App Engine -->
    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 relative overflow-hidden">
      <div class="flex items-center justify-between text-slate-400 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wider">Runtime Engine</span>
        <div class="p-2 bg-purple-500/10 text-purple-400 rounded-lg">
          <i data-lucide="server" class="w-4 h-4"></i>
        </div>
      </div>
      <div class="text-base font-bold text-white mt-1">
        Astro Standalone SSR
      </div>
      <div class="mt-3 text-[11px] text-slate-400">
        Node.js Runtime • Fast Hybrid Server
      </div>
    </div>
  </div>

  <!-- Content Tables Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
    <!-- Recent Products Card -->
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-bold text-white flex items-center gap-2">
          <i data-lucide="package" class="w-4 h-4 text-primary"></i>
          Catalog Highlights
        </h2>
        <a href="/admin/products" class="text-xs text-primary hover:underline font-semibold">View all &rarr;</a>
      </div>

      {recentProducts.length === 0 ? (
        <div class="py-10 text-center text-slate-500 text-xs">
          No products in database yet. Click "New Product" or run seeder.
        </div>
      ) : (
        <div class="divide-y divide-slate-800/80">
          {recentProducts.map((p) => (
            <div class="py-3 flex items-center justify-between gap-3">
              <div class="overflow-hidden">
                <a href={`/admin/products/${p.id}/edit`} class="text-xs font-semibold text-white hover:text-primary transition truncate block">
                  {p.title}
                </a>
                <span class="text-[11px] text-slate-400 truncate block">/{p.slug}</span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class={`text-[10px] px-2 py-0.5 rounded-full font-bold uppercase ${
                  p.status === "published"
                    ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                    : "bg-slate-700/50 text-slate-400 border border-slate-600/30"
                }`}>
                  {p.status}
                </span>
                <a
                  href={`/admin/products/${p.id}/edit`}
                  class="p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition"
                  title="Edit"
                >
                  <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                </a>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Recent Leads Card -->
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-bold text-white flex items-center gap-2">
          <i data-lucide="inbox" class="w-4 h-4 text-blue-400"></i>
          Recent Inquiries
        </h2>
        <a href="/admin/leads" class="text-xs text-blue-400 hover:underline font-semibold">View all &rarr;</a>
      </div>

      {recentLeads.length === 0 ? (
        <div class="py-10 text-center text-slate-500 text-xs">
          No inquiries received yet.
        </div>
      ) : (
        <div class="divide-y divide-slate-800/80">
          {recentLeads.map((l) => (
            <div class="py-3 flex items-center justify-between gap-3">
              <div class="overflow-hidden">
                <div class="text-xs font-semibold text-white truncate">{l.name}</div>
                <div class="text-[11px] text-slate-400 truncate">{l.email}</div>
              </div>
              <span class={`text-[10px] px-2 py-0.5 rounded-full font-bold uppercase shrink-0 ${
                l.status === "new"
                  ? "bg-primary/10 text-primary border border-primary/20"
                  : "bg-slate-700/50 text-slate-300"
              }`}>
                {l.status}
              </span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</AdminLayout>

