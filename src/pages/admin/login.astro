---
import { eq } from "drizzle-orm";
import { db } from "../../lib/db";
import { adminUsers } from "../../lib/db/schema";
import { verifyPassword } from "../../lib/auth/password";
import { createAdminSession } from "../../lib/auth/session";
import { setSessionCookie } from "../../lib/auth/cookies";
import FeedbackAlert from "../../components/ui/FeedbackAlert.astro";
import { Input } from "../../components/starwind/input";
import { Button } from "../../components/starwind/button";

let errorMessage = "";
const redirectUrl = Astro.url.searchParams.get("redirect") || "/admin";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get("email")?.toString().trim().toLowerCase();
    const password = formData.get("password")?.toString();

    if (!email || !password) {
      errorMessage = "Please enter both email and password.";
    } else {
      const [user] = await db
        .select()
        .from(adminUsers)
        .where(eq(adminUsers.email, email))
        .limit(1);

      if (!user || !user.isActive) {
        errorMessage = "Invalid email or password.";
      } else {
        const isPasswordValid = await verifyPassword(password, user.passwordHash);
        if (!isPasswordValid) {
          errorMessage = "Invalid email or password.";
        } else {
          // Update last login
          await db
            .update(adminUsers)
            .set({ lastLoginAt: new Date() })
            .where(eq(adminUsers.id, user.id));

          // Create session
          const { token, expiresAt } = await createAdminSession(user.id);
          setSessionCookie(Astro.cookies, token, expiresAt);

          return Astro.redirect(redirectUrl);
        }
      }
    }
  } catch (err) {
    console.error("Login submission error:", err);
    errorMessage = "An unexpected error occurred. Please try again.";
  }
}
---

<!doctype html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Admin Login | SourceMonster</title>
  </head>
  <body class="h-full flex items-center justify-center p-4 bg-[#020617] relative overflow-hidden">
    <!-- Ambient glowing backgrounds -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10">
      <div class="bg-slate-900/80 backdrop-blur-xl border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl shadow-black/80">
        <!-- Logo / Title -->
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-tr from-primary to-orange-500 text-white font-black text-xl mb-4 shadow-lg shadow-primary/20">
            SM
          </div>
          <h1 class="text-2xl font-black tracking-tight text-white">Admin Command Center</h1>
          <p class="text-xs text-slate-400 mt-1 uppercase tracking-wider">SourceMonster Core Administration</p>
        </div>

        <FeedbackAlert variant="error" message={errorMessage} class="mb-6" />

        <!-- Form -->
        <form method="POST" class="space-y-4">
          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
              Email Address
            </label>
            <Input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="admin@sourcemonster.in"
              class="bg-slate-950/80 border-slate-700/80 rounded-xl text-white placeholder:text-slate-500"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
                Password
              </label>
            </div>
            <Input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••••••"
              class="bg-slate-950/80 border-slate-700/80 rounded-xl text-white placeholder:text-slate-500"
            />
          </div>

          <Button
            type="submit"
            variant="primary"
            size="lg"
            class="w-full mt-2 bg-primary hover:bg-orange-600 text-white font-semibold rounded-xl shadow-lg shadow-primary/25"
          >
            Authenticate & Enter
          </Button>
        </form>

        <div class="mt-8 pt-6 border-t border-slate-800 text-center">
          <a href="/" class="text-xs text-slate-400 hover:text-white transition">
            &larr; Return to public site
          </a>
        </div>
      </div>
    </div>
  </body>
</html>

