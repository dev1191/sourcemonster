---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import TechStackTicker from "../components/TechStackTicker.astro";
import Services from "../components/Services.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import Stats from "../components/Stats.astro";
import Workflow from "../components/Workflow.astro";
import Testimonials from "../components/Testimonials.astro";
import Team from "../components/Team.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
---

<BaseLayout
  title="SourceMonster | High-Performance Software Collective & Commercial Products"
  description="Custom web & mobile app development, end-to-end. We engineer scalable digital products, bespoke SaaS platforms, and enterprise solutions that scale without friction."
>
  <Navbar />

  <main class="overflow-x-hidden">
    <!-- Hero Section -->
    <Hero />

    <!-- About / Pillars Section -->
    <About />

    <!-- Tech Stack / Technologies -->
    <TechStackTicker />

    <!-- End-to-End Services -->
    <Services />

    <!-- Built by SourceMonster / Recent Projects -->
    <FeaturedProjects />

    <!-- High-Impact Stats Ribbon -->
    <Stats />

    <!-- How It Works / Workflow -->
    <Workflow />

    <!-- Verified Client Reviews -->
    <Testimonials />

    <!-- The Team Behind The Magic -->
    <Team />

    <!-- Frequently Asked Questions -->
    <FAQ />

    <!-- Contact / Project Initialization Dock -->
    <Contact />
  </main>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>
