{
  "$schema": "https://starwind.dev/config-schema.v2.json",
  "version": 2,
  "framework": "astro",
  "registry": {
    "source": "bundled",
    "version": "2.2.0"
  },
  "components": [
    {
      "name": "button",
      "version": "3.0.3",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "input",
      "version": "2.1.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "textarea",
      "version": "1.4.1",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "card",
      "version": "2.3.2",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "badge",
      "version": "1.5.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "native-select",
      "version": "1.1.2",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "switch",
      "version": "2.1.0",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "alert",
      "version": "1.4.2",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "table",
      "version": "1.2.2",
      "framework": "astro",
      "registry": "default"
    },
    {
      "name": "dropzone",
      "version": "2.1.0",
      "framework": "astro",
      "registry": "default"
    }
  ],
  "tailwind": {
    "css": "src/styles/starwind.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "componentDir": "src/components/starwind",
  "utilsDir": "src/lib/utils"
}
